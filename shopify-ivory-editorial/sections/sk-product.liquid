{%- if k != 'other' and k != 'lezo' -%}
{%- liquid
  assign s_alt = nil
  assign s_fit = ''
  assign s_tag = 'In use'
  case k
    when 'booster'
      assign s_img = images['sc-white-wand-oct30.png']
      assign s_h = 'Two minutes, closer.'
      assign s_p = 'Use it after the mask, while your face is still bare. Glide slowly from the inner corner of the eye outwards, then along the smile lines and the jaw. Two unhurried minutes on the spots you notice in the mirror.'
    when 'bd'
      assign s_img = images['sk-cut-ceranol-duo.png']
      assign s_h = 'Press in. Let it settle.'
      assign s_p = 'After the pad, warm a few drops of ampoule between your fingertips and press them over the cheeks, forehead and neck. It’s the last step at night: quick enough to do every evening, which is the point.'
    when 'neck'
      assign s_img = p.media[2].preview_image
      assign s_alt = 'The curved 160° head of the Face & Neck Massager'
      assign s_fit = ' class="is-product"'
      assign s_tag = 'Design'
      assign s_h = 'Shaped for the neck.'
      assign s_p = 'The head curves 160°, so it sits along the neck and jawline instead of skimming across them. Glide upward with the light on and the vibration at the level you chose. The neck is where most routines stop; this is where yours keeps going.'
  endcase
-%}
<section class="hb-story" aria-labelledby="hb-story-h">
  <div class="hb-wrap hb-story__grid">
    <figure {{ s_fit }}>{% render 'sk-img', img: s_img, sizes: '(min-width: 900px) 45vw, 100vw', alt: s_alt %}</figure>
    <div>
      <span class="hb-new" style="margin-top:0">{{ s_tag }}</span>
      <h2 id="hb-story-h">{{ s_h }}</h2>
      <p>{{ s_p }}</p>
      <p><a class="hb-link" href="#hb-kits">Build your ritual and save 20%</a></p>
    </div>
  </div>
</section>
{%- endif -%}

