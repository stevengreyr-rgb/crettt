{%- if section.blocks.size > 0 -%}
{{ 'home-dynamic.css' | asset_url | stylesheet_tag }}
<script src="{{ 'home-dynamic.js' | asset_url }}" defer></script>
<section class="hd-intent st-wrap" id="start" data-hd-tabs aria-labelledby="hdi-{{ section.id }}">
  <header class="st-sectionhead"><div><p class="st-kicker">{{ section.settings.eyebrow | escape }}</p><h2 id="hdi-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div></header>
  <div class="hd-tabs" role="tablist" aria-label="{{ section.settings.heading | escape }}">
    {%- for b in section.blocks -%}<button type="button" class="hd-tab" role="tab" id="hdt-{{ section.id }}-{{ forloop.index0 }}" aria-controls="hdp-{{ section.id }}-{{ forloop.index0 }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"{% unless forloop.first %} tabindex="-1"{% endunless %} data-tab {{ b.shopify_attributes }}>{{ b.settings.label | escape }}</button>{%- endfor -%}
  </div>
  {%- for b in section.blocks -%}
    {%- liquid
      assign col = b.settings.collection
      assign art = b.settings.image | default: col.image | default: col.products.first.featured_image
      assign curated = b.settings.products
    -%}
    <div class="hd-panel" role="tabpanel" id="hdp-{{ section.id }}-{{ forloop.index0 }}" aria-labelledby="hdt-{{ section.id }}-{{ forloop.index0 }}"{% unless forloop.first %} hidden{% endunless %}>
      <div class="hd-panel__lead">
        {%- if art != blank -%}{{ art | image_url: width: 1000 | image_tag: widths: '480,750,1000', sizes: '(max-width:749px) 100vw, 38vw', loading: 'lazy', alt: '' }}{%- endif -%}
        <div class="hd-panel__text"><h3>{{ b.settings.title | escape }}</h3><p>{{ b.settings.text | escape }}</p>{%- if col != blank -%}<a class="st-button" href="{{ col.url }}">{{ b.settings.cta | default: 'Shop all' | escape }} <span aria-hidden="true">→</span></a>{%- endif -%}</div>
      </div>
      <div class="st-grid st-grid--rail">
        {%- if curated.size > 0 -%}{%- for p in curated -%}{%- render 'studio-card', product: p -%}{%- endfor -%}
        {%- elsif col != blank -%}{%- for p in col.products limit: 4 -%}{%- render 'studio-card', product: p -%}{%- endfor -%}{%- endif -%}
      </div>
    </div>
  {%- endfor -%}
</section>
{%- endif -%}
{% schema %}
{"name":"Home · Shop by need","tag":"div","settings":[
{"type":"text","id":"eyebrow","label":"Eyebrow","default":"START HERE"},
{"type":"text","id":"heading","label":"Heading","default":"What are you looking for?"}],
"blocks":[{"type":"need","name":"Need","limit":5,"settings":[
{"type":"text","id":"label","label":"Tab label"},
{"type":"collection","id":"collection","label":"Collection"},
{"type":"image_picker","id":"image","label":"Photo (optional)","info":"Empty = collection image, then first product photo."},
{"type":"text","id":"title","label":"Headline"},{"type":"textarea","id":"text","label":"Text"},
{"type":"text","id":"cta","label":"Button label","default":"Shop all"},
{"type":"product_list","id":"products","label":"Products to show (optional)","limit":4,"info":"Empty = first 4 of the collection."}]}],
"presets":[{"name":"Home · Shop by need","blocks":[{"type":"need"},{"type":"need"}]}]}
{% endschema %}
