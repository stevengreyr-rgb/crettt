{%- if section.blocks.size > 0 -%}
<section class="pdp-s" data-tone="{{ section.settings.tone }}" aria-labelledby="pu-{{ section.id }}">
  <div class="pdp-head pdp-rv"><p class="pdp-kicker">{{ section.settings.kicker | escape }}</p><h2 id="pu-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div>
  <div class="pdp-ugc">
    {%- for b in section.blocks -%}
    <figure class="pdp-ugc__item pdp-rv" style="margin:0" {{ b.shopify_attributes }}>
      <div class="pdp-media">
        {%- if b.settings.video != blank -%}
          <video data-pdp-video muted loop playsinline preload="none"{% if b.settings.image != blank %} poster="{{ b.settings.image | image_url: width: 500 }}"{% endif %}>{%- for src in b.settings.video.sources -%}{%- if src.format == 'mp4' -%}<source data-src="{{ src.url }}" type="video/mp4">{%- endif -%}{%- endfor -%}</video>
        {%- elsif b.settings.image != blank -%}
          {{ b.settings.image | image_url: width: 600 | image_tag: widths: '300,450,600', sizes: '(max-width:749px) 62vw, 22vw', loading: 'lazy', alt: b.settings.caption | default: 'Customer photo' }}
        {%- endif -%}
      </div>
      <figcaption class="pdp-ugc__cap"><b>{{ b.settings.name | escape }}</b>{%- if b.settings.caption != blank %} · {{ b.settings.caption | escape }}{%- endif -%}</figcaption>
    </figure>
    {%- endfor -%}
  </div>
  {%- if section.settings.note != blank -%}<p class="pdp-note">{{ section.settings.note | escape }}</p>{%- endif -%}
</section>
{%- endif -%}
{% schema %}
{"name":"PDP · Community (UGC)","tag":"div","settings":[{"type":"select","id":"tone","label":"Category style","default":"tech","options":[{"value":"beauty","label":"Beauty"},{"value":"gaming","label":"Gaming (dark)"},{"value":"tech","label":"Tech"},{"value":"cameras","label":"Cameras"},{"value":"fragrance","label":"Fragrance"},{"value":"jewelry","label":"Jewelry"},{"value":"fashion","label":"Fashion"}]},
{"type":"text","id":"kicker","label":"Label","default":"Community"},{"type":"text","id":"heading","label":"Heading","default":"Loved by our community"},
{"type":"text","id":"note","label":"Footnote (optional)","info":"Only add content from real customers who gave permission."}],
"blocks":[{"type":"clip","name":"Customer photo / video","limit":8,"settings":[{"type":"video","id":"video","label":"Vertical video (optional)"},{"type":"image_picker","id":"image","label":"Photo / poster"},{"type":"text","id":"name","label":"Customer name or @handle"},{"type":"text","id":"caption","label":"Caption (optional)"}]}],
"presets":[{"name":"PDP · Community (UGC)"}]}
{% endschema %}
