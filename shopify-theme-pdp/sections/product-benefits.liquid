{%- if section.blocks.size > 0 -%}
<section class="pdp-s" data-tone="{{ section.settings.tone }}" aria-labelledby="pb-{{ section.id }}">
  <div class="pdp-head pdp-rv"><p class="pdp-kicker">{{ section.settings.kicker | escape }}</p><h2 id="pb-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div>
  <div class="pdp-ben{% if section.blocks.size == 2 or section.blocks.size == 4 %} pdp-ben--2{% endif %}">
    {%- for b in section.blocks -%}
    <article class="pdp-ben__item pdp-rv" {{ b.shopify_attributes }}>
      {%- if b.settings.image != blank -%}<div class="pdp-media">{{ b.settings.image | image_url: width: 900 | image_tag: widths: '360,540,720,900', sizes: '(max-width:749px) 82vw, 33vw', loading: 'lazy', alt: b.settings.image.alt | default: b.settings.title }}</div>{%- endif -%}
      <div class="pdp-ben__body">
        {%- if b.settings.icon != blank -%}<div class="pdp-ben__icon" aria-hidden="true">{{ b.settings.icon | escape }}</div>{%- endif -%}
        <h3>{{ b.settings.title | escape }}</h3><p>{{ b.settings.text | escape }}</p>
      </div>
    </article>
    {%- endfor -%}
  </div>
</section>
{%- endif -%}
{% schema %}
{"name":"PDP · Benefits","tag":"div","settings":[
{"type":"select","id":"tone","label":"Category style","default":"tech","options":[{"value":"beauty","label":"Beauty"},{"value":"gaming","label":"Gaming (dark)"},{"value":"tech","label":"Tech"},{"value":"cameras","label":"Cameras"},{"value":"fragrance","label":"Fragrance"},{"value":"jewelry","label":"Jewelry"},{"value":"fashion","label":"Fashion"}]},
{"type":"text","id":"kicker","label":"Label","default":"Benefits"},{"type":"text","id":"heading","label":"Heading"}
],"blocks":[{"type":"benefit","name":"Benefit","limit":6,"settings":[
{"type":"image_picker","id":"image","label":"Photo (optional)"},
{"type":"text","id":"icon","label":"Short badge (optional)","info":"1–3 characters, e.g. 01 or a symbol."},
{"type":"text","id":"title","label":"Title"},{"type":"textarea","id":"text","label":"Text"}]}],
"presets":[{"name":"PDP · Benefits","blocks":[{"type":"benefit"},{"type":"benefit"},{"type":"benefit"}]}]}
{% endschema %}
