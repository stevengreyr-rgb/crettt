{%- if section.blocks.size > 0 -%}
<section class="pdp-s" data-tone="{{ section.settings.tone }}" aria-labelledby="pf-{{ section.id }}">
  <div class="pdp-head pdp-rv"><p class="pdp-kicker">{{ section.settings.kicker | escape }}</p><h2 id="pf-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div>
  <div class="pdp-faq pdp-rv">
    {%- for b in section.blocks -%}
    <details {{ b.shopify_attributes }}><summary>{{ b.settings.q | escape }}</summary><div class="pdp-faq__a">{{ b.settings.a }}</div></details>
    {%- endfor -%}
  </div>
  <script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{%- for b in section.blocks -%}{"@type":"Question","name":{{ b.settings.q | json }},"acceptedAnswer":{"@type":"Answer","text":{{ b.settings.a | strip_html | json }}}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]}</script>
</section>
{%- endif -%}
{% schema %}
{"name":"PDP · FAQ","tag":"div","settings":[{"type":"select","id":"tone","label":"Category style","default":"tech","options":[{"value":"beauty","label":"Beauty"},{"value":"gaming","label":"Gaming (dark)"},{"value":"tech","label":"Tech"},{"value":"cameras","label":"Cameras"},{"value":"fragrance","label":"Fragrance"},{"value":"jewelry","label":"Jewelry"},{"value":"fashion","label":"Fashion"}]},
{"type":"text","id":"kicker","label":"Label","default":"FAQ"},{"type":"text","id":"heading","label":"Heading","default":"Questions, answered"}],
"blocks":[{"type":"qa","name":"Question","limit":10,"settings":[{"type":"text","id":"q","label":"Question"},{"type":"richtext","id":"a","label":"Answer"}]}],
"presets":[{"name":"PDP · FAQ","blocks":[{"type":"qa"},{"type":"qa"},{"type":"qa"}]}]}
{% endschema %}
