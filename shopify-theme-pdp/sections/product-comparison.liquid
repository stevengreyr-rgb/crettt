{%- if section.blocks.size > 0 -%}
<section class="pdp-s" data-tone="{{ section.settings.tone }}" aria-labelledby="pc-{{ section.id }}">
  <div class="pdp-head pdp-rv"><p class="pdp-kicker">{{ section.settings.kicker | escape }}</p><h2 id="pc-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div>
  <div class="pdp-cmp pdp-rv" role="table">
    <div class="pdp-cmp__row" role="row"><span role="columnheader"></span><span role="columnheader">{{ section.settings.ours | default: product.title | escape }}</span><span role="columnheader">{{ section.settings.theirs | escape }}</span></div>
    {%- for b in section.blocks -%}
    <div class="pdp-cmp__row" role="row" {{ b.shopify_attributes }}><span role="rowheader">{{ b.settings.label | escape }}</span><span role="cell">{{ b.settings.ours | escape }}</span><span role="cell">{{ b.settings.theirs | escape }}</span></div>
    {%- endfor -%}
  </div>
  {%- if section.settings.note != blank -%}<p class="pdp-note">{{ section.settings.note | escape }}</p>{%- endif -%}
</section>
{%- endif -%}
{% schema %}
{"name":"PDP · Comparison","tag":"div","settings":[{"type":"select","id":"tone","label":"Category style","default":"tech","options":[{"value":"beauty","label":"Beauty"},{"value":"gaming","label":"Gaming (dark)"},{"value":"tech","label":"Tech"},{"value":"cameras","label":"Cameras"},{"value":"fragrance","label":"Fragrance"},{"value":"jewelry","label":"Jewelry"},{"value":"fashion","label":"Fashion"}]},
{"type":"text","id":"kicker","label":"Label","default":"Compare"},{"type":"text","id":"heading","label":"Heading"},
{"type":"text","id":"ours","label":"Column 1 name","info":"Empty = product title."},{"type":"text","id":"theirs","label":"Column 2 name","default":"Traditional option"},
{"type":"text","id":"note","label":"Footnote (optional)","info":"Use objective, verifiable attributes only."}],
"blocks":[{"type":"row","name":"Row","limit":8,"settings":[{"type":"text","id":"label","label":"Attribute"},{"type":"text","id":"ours","label":"This product"},{"type":"text","id":"theirs","label":"Alternative"}]}],
"presets":[{"name":"PDP · Comparison","blocks":[{"type":"row"},{"type":"row"},{"type":"row"}]}]}
{% endschema %}
