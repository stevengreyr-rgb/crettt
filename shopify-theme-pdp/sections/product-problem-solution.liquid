{%- liquid
  assign s = section.settings
  assign any = false
  if s.problem_text != blank or s.solution_text != blank or s.result_text != blank
    assign any = true
  endif
-%}
{%- if any -%}
<section class="pdp-s" data-tone="{{ s.tone }}" aria-labelledby="ps-{{ section.id }}">
  <div class="pdp-head pdp-rv"><p class="pdp-kicker">{{ s.kicker | escape }}</p><h2 id="ps-{{ section.id }}">{{ s.heading | escape }}</h2></div>
  <div class="pdp-ps">
    {%- for k in 'problem,solution,result' | split: ',' -%}
      {%- assign tk = k | append: '_title' -%}{%- assign xk = k | append: '_text' -%}
      {%- if s[xk] != blank -%}
      <div class="pdp-ps__step pdp-rv"><p class="pdp-kicker">{{ k | capitalize }}</p><h3>{{ s[tk] | escape }}</h3><p>{{ s[xk] | escape }}</p></div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
{%- endif -%}
{% schema %}
{"name":"PDP · Problem → Solution","tag":"div","settings":[
{"type":"select","id":"tone","label":"Category style","default":"tech","options":[{"value":"beauty","label":"Beauty"},{"value":"gaming","label":"Gaming (dark)"},{"value":"tech","label":"Tech"},{"value":"cameras","label":"Cameras"},{"value":"fragrance","label":"Fragrance"},{"value":"jewelry","label":"Jewelry"},{"value":"fashion","label":"Fashion"}]},
{"type":"text","id":"kicker","label":"Label","default":"Why it matters"},
{"type":"text","id":"heading","label":"Heading"},
{"type":"header","content":"Problem"},{"type":"text","id":"problem_title","label":"Title"},{"type":"textarea","id":"problem_text","label":"Text"},
{"type":"header","content":"Solution"},{"type":"text","id":"solution_title","label":"Title"},{"type":"textarea","id":"solution_text","label":"Text"},
{"type":"header","content":"Result"},{"type":"text","id":"result_title","label":"Title"},{"type":"textarea","id":"result_text","label":"Text"}
],"presets":[{"name":"PDP · Problem → Solution"}]}
{% endschema %}
