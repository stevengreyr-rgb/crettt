{% doc %}
  Sevencrush shop: one product-only card per product (LEZO mask, Booster Pro, Collagen duo, Cera-Nol duo),
  the "pads + free ampoule" creative and the 3D skin explainer.
  The duos rely on the automatic discounts "Buy the Gel Toner Pads, get the matching ampoule free".
  Uses only the theme's own markup: .sp-products / .sp-product-card / .sp-tag / .lh-btn and .sp-promo.
  Rendered in place of #sp-shop on the home page and above the footer on the LEZO landing page.

  @example
  {% render 'seven-ritual-shop' %}
{% enddoc %}
{%- liquid
  assign bd = all_products['korean-collagen-ampoule-serum-moisturizing-brightening-face-mask-gel-toner-cotton-pads-firming-gentle-and-non-irritating-skin-ca']
  assign booster = all_products['new-booster-pro-led-facial-light-therapy-7-colors-eye-beauty-wand-red-light-eye-massager-for-skincare-blue-rejuvenation-tool']
  assign lezo = all_products['lezo-7-color-led-face-mask']
  for v in bd.variants
    case v.id
      when 50956618858715
        assign v_pads_pink = v
      when 50956618629339
        assign v_pads_blue = v
      when 50956618891483
        assign v_amp_pink = v
      when 50956618825947
        assign v_amp_blue = v
    endcase
  endfor
  for v in booster.variants
    if v.id == 50957033046235
      assign v_bp = v
    endif
  endfor
  assign v_bp = v_bp | default: booster.selected_or_first_available_variant
  assign v_lezo = lezo.selected_or_first_available_variant
  assign pink_total = v_pads_pink.price | plus: v_amp_pink.price
  assign blue_total = v_pads_blue.price | plus: v_amp_blue.price
-%}
<div class="sr" id="sr-shop">
  <section class="sp-products lh-wrap" id="sp-shop">
    <article class="sp-product-card"><a href="{{ lezo.url }}"><img src="{{ images['lezo-pdp-front-2026.webp'] | image_url: width: 900 }}" width="900" height="900" loading="lazy" alt="White LEZO LED face mask"><span class="sp-tag">THE LIGHT COLLECTION</span><h2>LEZO LED MASK</h2></a><p>White · 7 light modes</p><strong>{{ v_lezo.price | money }}</strong>{% if v_lezo.compare_at_price > v_lezo.price %} <s>{{ v_lezo.compare_at_price | money }}</s>{% endif %}<a class="lh-btn" href="{{ lezo.url }}">EXPLORE THE MASK</a></article>
    {%- if v_bp -%}
    <article class="sp-product-card"><a href="{{ booster.url }}?variant={{ v_bp.id }}"><img src="{{ images['pd-booster-pro.png'] | image_url: width: 900 }}" width="900" height="900" loading="lazy" alt="Booster Pro LED wand in black"><span class="sp-tag">LED · EMS · VIBRATION</span><h2>BOOSTER PRO WAND</h2></a><p>7-color LED, EMS and sonic vibration</p><strong>{{ v_bp.price | money }}</strong>{% if v_bp.compare_at_price > v_bp.price %} <s>{{ v_bp.compare_at_price | money }}</s>{% endif %}<button type="button" class="lh-btn" data-sr-add='[{"id":{{ v_bp.id }},"quantity":1}]' {% unless v_bp.available %}disabled{% endunless %}>{% if v_bp.available %}ADD TO BAG{% else %}SOLD OUT{% endif %}</button></article>
    {%- endif -%}
    {%- if v_pads_pink and v_amp_pink -%}
    <article class="sp-product-card"><a href="{{ bd.url }}?variant={{ v_pads_pink.id }}"><img src="{{ images['pd-collagen-duo.png'] | image_url: width: 900 }}" width="900" height="900" loading="lazy" alt="Biodance Collagen Gel Toner Pads and Collagen Ampoule"><span class="sp-tag">AMPOULE FREE</span><h2>COLLAGEN DUO</h2></a><p>Collagen gel pads + free Collagen Ampoule</p><strong>{{ v_pads_pink.price | money }}</strong> <s>{{ pink_total | money }}</s><button type="button" class="lh-btn" data-sr-add='[{"id":{{ v_pads_pink.id }},"quantity":1},{"id":{{ v_amp_pink.id }},"quantity":1}]' {% unless v_pads_pink.available %}disabled{% endunless %}>{% if v_pads_pink.available %}ADD THE DUO{% else %}SOLD OUT{% endif %}</button></article>
    {%- endif -%}
    {%- if v_pads_blue and v_amp_blue -%}
    <article class="sp-product-card"><a href="{{ bd.url }}?variant={{ v_pads_blue.id }}"><img src="{{ images['pd-ceranol-duo.png'] | image_url: width: 900 }}" width="900" height="900" loading="lazy" alt="Biodance Cera-Nol Gel Toner Pads and Hydro Cera-Nol Ampoule"><span class="sp-tag">AMPOULE FREE</span><h2>CERA-NOL DUO</h2></a><p>Cera-Nol gel pads + free Hydro Cera-Nol Ampoule</p><strong>{{ v_pads_blue.price | money }}</strong> <s>{{ blue_total | money }}</s><button type="button" class="lh-btn" data-sr-add='[{"id":{{ v_pads_blue.id }},"quantity":1},{"id":{{ v_amp_blue.id }},"quantity":1}]' {% unless v_pads_blue.available %}disabled{% endunless %}>{% if v_pads_blue.available %}ADD THE DUO{% else %}SOLD OUT{% endif %}</button></article>
    {%- endif -%}
  </section>

  <section class="sp-promo" id="sr-duo"><img src="{{ images['pd-collagen-duo.png'] | image_url: width: 1200 }}" width="900" height="900" loading="lazy" alt="Biodance Collagen Gel Toner Pads with the Collagen Ampoule"><div><span class="lh-eyebrow">COMPLIMENTARY AMPOULE</span><h2>BUY THE PADS.<br>THE AMPOULE IS FREE.</h2><p>Add the {{ v_pads_pink.price | money }} gel pads and the matching {{ v_amp_pink.price | money }} ampoule is on us. In Collagen or Cera-Nol.</p><button type="button" class="lh-btn" data-sr-add='[{"id":{{ v_pads_pink.id }},"quantity":1},{"id":{{ v_amp_pink.id }},"quantity":1}]'>CLAIM THE DUO</button></div></section>
  <section class="sp-promo" id="sr-vibration"><img src="{{ images['sp-vibration.jpg'] | image_url: width: 1200 }}" width="657" height="657" loading="lazy" alt="Booster Pro head on 3D skin layers sending sonic vibration waves"><div><span class="lh-eyebrow">ULTRA SONIC VIBRATION</span><h2>DEEP INTO<br>EVERY LAYER.</h2><p>High-frequency vibration and light travel through the epidermis, dermis and hypodermis to boost circulation and support the look of firmness.</p></div></section>
  <section class="sp-promo" id="sr-absorption"><img src="{{ images['sp-absorption.jpg'] | image_url: width: 1200 }}" width="657" height="657" loading="lazy" alt="Serum droplets absorbing through 3D skin layers"><div><span class="lh-eyebrow">3D SKIN ABSORPTION</span><h2>YOUR SERUM,<br>ALL THE WAY IN.</h2><p>Massage the ampoule in with every pass, so collagen and ceramides reach deeper for a smoother, more radiant look.</p></div></section>
  <a href="{{ routes.cart_url }}" data-pink-cart data-sr-open hidden tabindex="-1" aria-hidden="true"></a>
</div>
