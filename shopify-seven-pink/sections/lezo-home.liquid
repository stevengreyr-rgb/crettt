{% assign p = all_products['lezo-7-color-led-face-mask'] %}
{% assign v = p.selected_or_first_available_variant %}
<a class="lh-skip" href="#main">{{ 'lezo_home.skip' | t }}</a>
<button class="lh-announcement sp-announce" data-welcome>{{ 'seven_pink.unlock' | t }} &nbsp; →</button>
<header class="lh-header"><div class="lh-wrap lh-nav"><a href="{{ routes.root_url }}" class="lh-brand" aria-label="LEZO by Sevencrush">sevencrush<small>THE BEAUTY EDIT</small></a><nav class="lh-links" aria-label="{{ 'lezo_home.nav' | t }}"><a href="#mask3d">{{ 'lezo_home.nav_light' | t }}</a><a href="#ritual">{{ 'lezo_home.nav_fit' | t }}</a><a href="#questions">{{ 'lezo_home.nav_questions' | t }}</a></nav><a class="lh-bag" data-pink-cart href="{{ routes.cart_url }}">{{ 'lezo_home.bag' | t }} ({{ cart.item_count }})</a></div></header>
<main id="main">
<section class="lh-hero sp-hero" aria-labelledby="lh-title"><div class="sp-hero-image"><img src="{{ 'seven-ugc-hero.webp' | asset_url }}" alt="Beauty campaign model holding the white LEZO mask" width="1024" height="1536" fetchpriority="high"></div><div class="lh-hero-copy"><span class="lh-eyebrow">{{ 'seven_pink.hero_label' | t }}</span><h1 id="lh-title">{{ 'seven_pink.hero_title_html' | t }}</h1><p>{{ 'seven_pink.hero_sub' | t }}</p><a class="lh-btn" href="{{ p.url }}">{{ 'seven_pink.explore' | t }}</a><a class="lh-text-link" href="#mask3d">{{ 'seven_pink.colors' | t }} ↘</a></div></section>
<nav class="sp-tabs" aria-label="Explore LEZO"><a href="#sp-shop">{{ 'seven_pink.shop_tab' | t }}</a><a href="#mask3d">{{ 'seven_pink.light_tab' | t }}</a><a href="#ritual">{{ 'seven_pink.ritual_tab' | t }}</a></nav>
{% render 'seven-ritual-shop' %}
<div class="lh-wrap lh-facts"><div><strong>07</strong>{{ 'lezo_home.fact_modes' | t }}</div><div><strong>5–12</strong>{{ 'lezo_home.fact_delivery' | t }}</div><div><strong>30</strong>{{ 'lezo_home.fact_returns' | t }}</div></div>
<section class="lh-wrap lh-section" id="mask3d"><div class="lh-section-head"><div><span class="lh-eyebrow">{{ 'lezo_home.viewer_kicker' | t }}</span><h2>{{ 'lezo_home.viewer_title_html' | t }}</h2></div><p>{{ 'lezo_home.viewer_intro' | t }}</p></div>
<div class="lh-viewer" data-viewer><div class="lh-view" data-inside="false"><video class="lh-video" muted playsinline loop preload="none" poster="{{ 'lezo-turn-poster.webp' | asset_url }}" data-src="{{ 'lezo-turn.mp4' | asset_url }}" aria-label="{{ 'lezo_home.video_alt' | t }}"></video><img class="lh-inside" src="https://cdn.shopify.com/s/files/1/0833/3485/6923/files/lezo-inside-hd.webp?v=1792905330&width=1000" alt="{{ 'lezo_home.inside_alt' | t }}" width="766" height="620" loading="lazy"><span class="lh-view-badge">{{ 'lezo_home.view_badge' | t }}</span><span class="lh-view-hint">↔ {{ 'lezo_home.drag' | t }}</span></div><div class="lh-control"><span class="lh-eyebrow">{{ 'lezo_home.select' | t }}</span><div class="lh-swatches" role="group" aria-label="{{ 'lezo_home.select_label' | t }}"><button type="button" class="lh-swatch" style="--color:#e0463f" data-name="Red" data-nm="630 nm" data-desc="Deep repair, increase skin elasticity" data-filter="hue-rotate(0deg)" aria-pressed="true"><i aria-hidden="true"></i>{{ 'lezo_home.color_0' | t }}</button><button type="button" class="lh-swatch" style="--color:#3acb68" data-name="Green" data-nm="520 nm" data-desc="Lighten spots, calms the skin" data-filter="hue-rotate(126deg)" aria-pressed="false"><i aria-hidden="true"></i>{{ 'lezo_home.color_1' | t }}</button><button type="button" class="lh-swatch" style="--color:#3975f2" data-name="Blue" data-nm="470 nm" data-desc="Inhibit bacteria, remove acne" data-filter="hue-rotate(211deg)" aria-pressed="false"><i aria-hidden="true"></i>{{ 'lezo_home.color_2' | t }}</button><button type="button" class="lh-swatch" style="--color:#a25ada" data-name="Purple" data-nm="630 + 470 nm" data-desc="Repair scar" data-filter="hue-rotate(271deg)" aria-pressed="false"><i aria-hidden="true"></i>{{ 'lezo_home.color_3' | t }}</button><button type="button" class="lh-swatch" style="--color:#f0c13e" data-name="Yellow" data-nm="630 + 520 nm" data-desc="Improve wrinkles, increase immunity" data-filter="hue-rotate(44deg)" aria-pressed="false"><i aria-hidden="true"></i>{{ 'lezo_home.color_4' | t }}</button><button type="button" class="lh-swatch" style="--color:#26c5ce" data-name="Cyan" data-nm="470 + 520 nm" data-desc="Promote metabolism, control oil" data-filter="hue-rotate(181deg)" aria-pressed="false"><i aria-hidden="true"></i>{{ 'lezo_home.color_5' | t }}</button><button type="button" class="lh-swatch" style="--color:#f3efe6" data-name="White" data-nm="470 + 520 + 630 nm" data-desc="Improves fine lines, lighten spots" data-filter="saturate(.1) brightness(1.15)" aria-pressed="false"><i aria-hidden="true"></i>{{ 'lezo_home.color_6' | t }}</button></div><div aria-live="polite"><h3 class="lh-mode-title" data-mode-name>Red</h3><p class="lh-mode-nm" data-mode-nm>630 nm</p><p class="lh-mode-desc" data-mode-desc>Deep repair, increase skin elasticity</p></div><p class="lh-mode-note">{{ 'lezo_home.mode_note' | t }}</p><div class="lh-view-actions"><button type="button" data-play aria-pressed="false" data-start="{{ 'lezo_home.start' | t }}" data-stop="{{ 'lezo_home.pause' | t }}">{{ 'lezo_home.start' | t }}</button><button type="button" data-inside-toggle aria-pressed="false" data-inside-label="{{ 'lezo_home.inside' | t }}" data-outside-label="{{ 'lezo_home.outside' | t }}">{{ 'lezo_home.inside' | t }}</button><button type="button" data-reset>{{ 'lezo_home.reset' | t }}</button></div><input class="lh-seek" type="range" min="0" max="1000" value="0" step="1" aria-label="{{ 'lezo_home.rotation' | t }}" disabled><div class="lh-seek-label"><span>{{ 'lezo_home.scrub' | t }}</span><span data-progress>0%</span></div><p class="lh-fallback" hidden>{{ 'lezo_home.video_error' | t }}</p></div></div></section>
<section id="ritual" class="sp-promo"><img src="{{ 'seven-ugc-trio.webp' | asset_url }}" alt="LEZO LED mask lifestyle editorial" width="1536" height="1024" loading="lazy"><div><span class="lh-eyebrow">{{ 'seven_pink.hero_label' | t }}</span><h2>{{ 'seven_pink.banner_title_html' | t }}</h2><p>{{ 'seven_pink.banner_sub' | t }}</p><a class="lh-btn" href="{{ p.url }}">{{ 'seven_pink.shop' | t }}</a></div></section>

<section class="sp-community lh-wrap"><div class="sp-vip"><img src="{{ images['lz-mask-sofa.png'] | image_url: width: 1024 }}" width="1024" height="1280" loading="lazy" alt="Woman relaxing on a sofa wearing the LEZO LED mask"><button class="lh-btn" data-welcome>{{ 'seven_pink.club' | t }}</button></div><div class="sp-creators"><img src="{{ images['lz-booster-cheek.png'] | image_url: width: 1536 }}" width="1536" height="1147" loading="lazy" alt="Woman pressing the Booster Pro LED wand against her cheek"><button class="lh-btn" data-welcome>{{ 'seven_pink.creators' | t }}</button></div><p class="sp-disclosure">{{ 'seven_pink.campaign_note' | t }}</p></section>
<div class="lh-wrap lh-design"><article class="lh-detail-card"><img src="https://cdn.shopify.com/s/files/1/0833/3485/6923/files/lezo-strap-hd.webp?v=1792905330&width=650" alt="{{ 'lezo_home.strap_alt' | t }}" width="650" height="650" loading="lazy"><div class="lh-detail-copy"><h3>{{ 'lezo_home.strap_title_html' | t }}</h3><p>{{ 'lezo_home.strap_copy' | t }}</p></div></article><article class="lh-detail-card"><img src="https://cdn.shopify.com/s/files/1/0833/3485/6923/files/lezo-inside-hd.webp?v=1792905330&width=650" alt="{{ 'lezo_home.detail_alt' | t }}" width="650" height="650" loading="lazy"><div class="lh-detail-copy"><h3>{{ 'lezo_home.led_title_html' | t }}</h3><p>{{ 'lezo_home.led_copy' | t }}</p></div></article></div>
<section class="lh-wrap lh-section" id="questions"><div class="lh-faq"><div class="lh-faq-intro"><span class="lh-eyebrow">{{ 'lezo_home.faq_kicker' | t }}</span><h2>{{ 'lezo_home.faq_title_html' | t }}</h2><p>{{ 'lezo_home.faq_intro' | t }}</p></div><div><details><summary>{{ 'lezo_home.q0' | t }}</summary><p>{{ 'lezo_home.a0' | t }}</p></details><details><summary>{{ 'lezo_home.q1' | t }}</summary><p>{{ 'lezo_home.a1' | t }}</p></details><details><summary>{{ 'lezo_home.q2' | t }}</summary><p>{{ 'lezo_home.a2' | t }}</p></details><details><summary>{{ 'lezo_home.q3' | t }}</summary><p>{{ 'lezo_home.a3' | t }}</p></details></div></div><div class="lh-close"><div><span class="lh-eyebrow">LEZO / SEVENCRUSH</span><h3>{{ 'lezo_home.closing' | t }}</h3></div><a class="lh-btn" href="{{ p.url }}">{{ 'lezo_home.shop' | t }} <span aria-hidden="true">↗</span></a></div></section></main>
<footer class="lh-wrap lh-footer"><div class="lh-footer-top"><a class="lh-brand" href="{{ routes.root_url }}">sevencrush<small>THE BEAUTY EDIT</small></a><nav class="lh-footer-links" aria-label="{{ 'lezo_home.footer_nav' | t }}"><a href="/pages/lezo-delivery">{{ 'lezo_home.shipping' | t }}</a><a href="/pages/lezo-returns">{{ 'lezo_home.returns' | t }}</a><a href="/policies/privacy-policy">{{ 'lezo_home.privacy' | t }}</a><a href="/policies/terms-of-service">{{ 'lezo_home.terms' | t }}</a><a href="mailto:sevencrush.store@gmail.com">{{ 'lezo_home.contact' | t }}</a></nav></div><div class="lh-footer-bottom"><span>{{ 'lezo_home.footer_country' | t }}</span><span>{{ 'lezo_home.footer_note' | t }}</span></div></footer>
<div class="lh-sticky"><div><strong>LEZO LED Mask</strong><small>{{ v.price | money }} · {{ 'lezo_home.sticky_ship' | t }}</small></div><a class="lh-btn" href="{{ p.url }}">{{ 'lezo_home.shop' | t }} <span aria-hidden="true">↗</span></a></div>
{% schema %}
{"name":"LEZO editorial home","settings":[],"presets":[{"name":"LEZO editorial home"}]}
{% endschema %}

