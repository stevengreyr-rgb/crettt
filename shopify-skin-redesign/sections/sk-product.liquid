{% comment %}
  Section contract.
  Product landing for the four SEVENCRUSH skincare products (rendered by layout/theme.liquid
  for those handles). Gallery, buy box with native /cart/add form, benefits, editorial photo,
  details, a visual explainer, the bundle builder, and delivery / returns / FAQ. Copy only
  restates what each product description says; the original description is kept verbatim in
  "As listed by the maker". Per-product copy and image file names live in the case below.
  @example
  {% section 'sk-product' %}
{% endcomment %}
{%- liquid
  assign p = product
  assign cur = p.selected_or_first_available_variant
  assign gal_files = ''
  assign gal_media = 'all'
  assign bundle_key = 'daily'
  case p.handle
    when 'lezo-7-color-led-face-mask'
      assign k = 'lezo'
      assign kicker = 'LED face mask · 7 light modes'
      assign name = 'LEZO 7-Color LED Face Mask'
      assign sub = 'A full-face LED mask with seven light modes and an adjustable strap. Put it on, choose a color and keep your hands free.'
      assign gal_files = 'lezo-portrait-2026.webp,lz-mask-studio.png'
      assign edit_img = images['lezo-ritual-2026.webp']
      assign explain_img = images['lezo-detail-2026.webp']
      assign delivery = 'Free US shipping. Delivery in 5–12 days.'
    when 'new-booster-pro-led-facial-light-therapy-7-colors-eye-beauty-wand-red-light-eye-massager-for-skincare-blue-rejuvenation-tool'
      assign k = 'booster'
      assign kicker = 'Handheld LED wand · pink or black'
      assign name = 'Booster Pro LED Wand'
      assign sub = 'A handheld facial wand with selectable light colors, made for unhurried moments in your routine. USB rechargeable.'
      assign gal_media = 'variants'
      assign gal_files = 'sc-booster-black.jpg,sc-booster-pink.jpg,pd-booster-pro.png,sc-v3-cover.png,sp-ugc-booster.png'
      assign edit_img = images['sc-booster-cover.jpg']
      assign explain_img = nil
      assign delivery = 'Free US shipping. Processing takes 1–3 business days, then 7–14 business days in transit, tracked.'
    when 'korean-collagen-ampoule-serum-moisturizing-brightening-face-mask-gel-toner-cotton-pads-firming-gentle-and-non-irritating-skin-ca'
      assign k = 'bd'
      assign kicker = 'Biodance collagen routine · pink or blue'
      assign name = 'Collagen Gel Pads & Ampoules'
      assign sub = 'A two-step ritual built around moisture and comfort: gel pads first, then the matching ampoule.'
      assign gal_media = 'variants'
      assign gal_files = 'pd-collagen-duo.png,pd-ceranol-duo.png,sc-v3-ampoule-pink.png'
      assign edit_img = images['sc-v3-ampoule-blue.png']
      assign explain_img = images['lz2-ampoule-pink.png']
      assign bundle_key = 'collagen'
      assign delivery = 'Free US shipping. Processing takes 1–3 business days, then 7–14 business days in transit, tracked.'
    else
      assign k = 'neck'
      assign kicker = 'Face & neck device · 7 colors, 3 levels'
      assign name = 'LED Face & Neck Massager'
      assign sub = 'Seven light colors, seven modes and three vibration levels on a curved head that wraps 160° around the neck.'
      assign edit_img = p.media[6].preview_image | default: p.featured_image
      assign explain_img = p.media[2].preview_image
      assign delivery = 'Free US shipping. Processing takes 1–3 business days, then 7–14 business days in transit, tracked.'
  endcase
  assign files = gal_files | split: ','
-%}
<div class="sk" data-sk-pdp>
<script type="application/json" data-sk-variants>
  [{%- for v in p.variants -%}{"id":{{ v.id }},"price":{{ v.price }},"compare":{{ v.compare_at_price | default: 0 }},"available":{{ v.available | json }},"media":{{ v.featured_media.id | default: 0 }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]
</script>

<div class="sk-wrap">
  <div class="sk-pdp">
    {%- comment -%} 1 · Gallery {%- endcomment -%}
    <div class="sk-gal" data-sk-gal>
      <div class="sk-gal__track" data-sk-gal-track tabindex="0" aria-label="{{ name | escape }} images">
        {%- assign n = 0 -%}
        {%- if gal_media == 'all' -%}
          {%- for m in p.media limit: 7 -%}
            {%- assign n = n | plus: 1 -%}
            <figure class="sk-gal__slide{% if k == 'neck' %} is-product{% endif %}" data-media-id="{{ m.id }}">
              {%- assign m_alt = m.alt | default: name -%}
              {% render 'sk-img', img: m.preview_image, sizes: '(min-width: 1000px) 55vw, 100vw', alt: m_alt, eager: forloop.first %}
            </figure>
          {%- endfor -%}
        {%- else -%}
          {%- for v in p.variants -%}
            {%- if v.featured_media -%}
              {%- assign n = n | plus: 1 -%}
              <figure class="sk-gal__slide is-product" data-media-id="{{ v.featured_media.id }}">
                {%- capture v_alt -%}{{ name }} · {{ v.title | capitalize }}{%- endcapture -%}
                {% render 'sk-img', img: v.featured_media.preview_image, sizes: '(min-width: 1000px) 55vw, 100vw', alt: v_alt, eager: forloop.first %}
              </figure>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- for f in files -%}
          {%- if images[f] and n < 7 -%}
            {%- assign n = n | plus: 1 -%}
            <figure class="sk-gal__slide">{% render 'sk-img', img: images[f], sizes: '(min-width: 1000px) 27vw, 100vw' %}</figure>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="sk-gal__dots" data-sk-gal-dots aria-label="Choose image"></div>
    </div>

    {%- comment -%} 2–4 · Name, price, availability, variants, quantity, buttons {%- endcomment -%}
    <div class="sk-buy">
      <span class="sk-eyebrow sk-eyebrow--muted">{{ kicker }}</span>
      <h1>{{ name }}</h1>
      <p class="sk-buy__sub">{{ sub }}</p>
      <div class="sk-buy__price" data-sk-price>
        <span data-sk-price-now>{{ cur.price | money }}</span>
        {%- if cur.compare_at_price > cur.price -%}
          <s data-sk-price-was>{{ cur.compare_at_price | money }}</s>
          <span class="sk-buy__off" data-sk-price-off>Save {{ cur.compare_at_price | minus: cur.price | money }}</span>
        {%- else -%}
          <s data-sk-price-was hidden></s><span class="sk-buy__off" data-sk-price-off hidden></span>
        {%- endif -%}
      </div>
      <p class="sk-small">Free US shipping. Taxes calculated at checkout.</p>
      <p class="sk-stock{% unless cur.available %} is-out{% endunless %}" data-sk-stock><i aria-hidden="true"></i><span>{% if cur.available %}In stock, ready to ship{% else %}Sold out{% endif %}</span></p>

      <form action="{{ routes.cart_add_url }}" method="post" data-sk-form>
        {%- if p.has_only_default_variant -%}
          <input type="hidden" name="id" value="{{ cur.id }}">
        {%- else -%}
          <fieldset class="sk-opt">
            <legend>{{ p.options.first | default: 'Option' }} <span data-sk-vlabel></span></legend>
            <div class="sk-pills">
              {%- for v in p.variants -%}
                {%- liquid
                  assign vt = v.title | capitalize
                  assign dot = ''
                  case v.id
                    when 50956618858715
                      assign vt = 'Collagen Pads · pink'
                      assign dot = '#f2c5cf'
                    when 50956618891483
                      assign vt = 'Collagen Ampoule · pink'
                      assign dot = '#f2c5cf'
                    when 50956618629339
                      assign vt = 'Cera-Nol Pads · blue'
                      assign dot = '#9fb4e6'
                    when 50956618825947
                      assign vt = 'Hydro Cera-Nol Ampoule · blue'
                      assign dot = '#9fb4e6'
                    when 50957033013467
                      assign dot = '#f4cdd2'
                    when 50957033046235
                      assign dot = '#1a1a1a'
                  endcase
                -%}
                <label class="sk-pill">
                  <input type="radio" name="id" value="{{ v.id }}" data-label="{{ vt | escape }}" {% if v.id == cur.id %}checked{% endif %} {% unless v.available %}disabled{% endunless %}>
                  <span>{% if dot != '' %}<i class="sk-dot" style="--c:{{ dot }}"></i>{% endif %}{{ vt }}</span>
                </label>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endif -%}

        {%- if k == 'bd' -%}
          <p class="sk-small" style="margin:-6px 0 18px" data-sk-bogo-note>Choose pads and the matching ampoule is free: add both and checkout takes the ampoule off automatically.</p>
        {%- endif -%}

        <div class="sk-qtyrow">
          <div class="sk-qty">
            <button type="button" data-sk-qty="-1" aria-label="Decrease quantity">−</button>
            <input type="number" name="quantity" value="1" min="1" max="20" inputmode="numeric" aria-label="Quantity" data-sk-qty-input>
            <button type="button" data-sk-qty="1" aria-label="Increase quantity">+</button>
          </div>
          <button type="submit" class="sk-btn sk-btn--block" data-sk-atc {% unless cur.available %}disabled{% endunless %}>{% if cur.available %}Add to cart{% else %}Sold out{% endif %}</button>
        </div>
        <button type="submit" name="return_to" value="/checkout" class="sk-btn sk-btn--ghost sk-btn--block" data-sk-buynow {% unless cur.available %}disabled{% endunless %}>Buy it now</button>
        {%- if k == 'bd' -%}
          <button type="button" class="sk-btn sk-btn--ghost sk-btn--block" style="margin-top:10px" data-sk-pair>Add pads + matching ampoule</button>
        {%- endif -%}
        <p class="sk-msg" data-sk-msg role="status"></p>
      </form>

      <ul class="sk-assure">
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M3 7l9-4 9 4v10l-9 4-9-4V7Z"/><path d="M3 7l9 4 9-4M12 11v10"/></svg><span>{{ delivery }}</span></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M5 8h10a6 6 0 0 1 0 12H8M5 8l5-5M5 8l5 5"/></svg><span>30 days from delivery to return unopened, unused items.</span></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="m12 2 8 3v6c0 5-8 11-8 11S4 16 4 11V5l8-3Z"/><path d="m8 11 3 3 5-6"/></svg><span>Secure Shopify checkout with card, PayPal or Shop Pay.</span></li>
      </ul>
    </div>
  </div>
</div>

{%- comment -%} 5 · Benefits {%- endcomment -%}
<section class="sk-sect sk-sect--cream" aria-labelledby="sk-ben-title">
  <div class="sk-wrap">
    <div class="sk-head"><div><span class="sk-eyebrow">Why it earns its place</span><h2 id="sk-ben-title">
      {%- case k -%}
        {%- when 'lezo' -%}Seven colors, <em>no hands.</em>
        {%- when 'booster' -%}Small device. <em>Considered design.</em>
        {%- when 'bd' -%}Two steps. <em>One routine.</em>
        {%- else -%}Light and vibration, <em>shaped for the neck.</em>
      {%- endcase -%}
    </h2></div></div>
    <div class="sk-benefits">
      {%- case k -%}
        {%- when 'lezo' -%}
          <div class="sk-benefit"><h3>Seven light modes</h3><p>Red, green, blue, purple, yellow, cyan or white.</p></div>
          <div class="sk-benefit"><h3>Hands-free</h3><p>An adjustable head strap holds the mask in place.</p></div>
          <div class="sk-benefit"><h3>Full-face shell</h3><p>White shell with eye and mouth openings.</p></div>
          <div class="sk-benefit"><h3>No appointment</h3><p>Use it at home, on your own schedule.</p></div>
        {%- when 'booster' -%}
          <div class="sk-benefit"><h3>Selectable light</h3><p>Multiple light colors to choose between, set from the wand.</p></div>
          <div class="sk-benefit"><h3>Made to be held</h3><p>Shaped to sit comfortably in the hand as you move it across the face.</p></div>
          <div class="sk-benefit"><h3>USB rechargeable</h3><p>Recharge with the supplied charging setup. No batteries to replace.</p></div>
          <div class="sk-benefit"><h3>Pink or black</h3><p>A minimal silhouette that can live on your vanity, not in a drawer.</p></div>
        {%- when 'bd' -%}
          <div class="sk-benefit"><h3>Pads, then ampoule</h3><p>Gel pads for a fresh, hydrated feel, then a lightweight ampoule to finish.</p></div>
          <div class="sk-benefit"><h3>Pink or blue</h3><p>Collagen pads with the Collagen ampoule, or Cera-Nol pads with the Hydro Cera-Nol ampoule.</p></div>
          <div class="sk-benefit"><h3>Ampoule free with pads</h3><p>Add the pads and the matching ampoule; checkout takes the ampoule off.</p></div>
          <div class="sk-benefit"><h3>Easy to repeat</h3><p>A simple pairing that keeps moisture at the center of your routine.</p></div>
        {%- else -%}
          <div class="sk-benefit"><h3>7 colors, 7 modes</h3><p>Seven LED colors and seven modes, with three intensity levels.</p></div>
          <div class="sk-benefit"><h3>Curved 160° head</h3><p>A dolphin-shaped head designed to wrap around the neck.</p></div>
          <div class="sk-benefit"><h3>1–2 hours per charge</h3><p>400 mAh battery, about 3 hours to charge over USB-C.</p></div>
          <div class="sk-benefit"><h3>Pocket-sized</h3><p>13.9 × 8.8 × 3.8 cm, light enough to travel with.</p></div>
      {%- endcase -%}
    </div>
  </div>
</section>

{%- comment -%} 6 · Editorial in use {%- endcomment -%}
<section class="sk-sect" aria-labelledby="sk-use-title">
  <div class="sk-wrap sk-split">
    <figure class="sk-frame sk-frame--4x5" style="margin:0">{% render 'sk-img', img: edit_img, sizes: '(min-width: 900px) 50vw, 100vw' %}</figure>
    <div>
      <span class="sk-eyebrow">In use</span>
      {%- case k -%}
        {%- when 'lezo' -%}
          <h2 id="sk-use-title">Lie back. <em>The strap holds it.</em></h2>
          <p>LEZO sits on your face on its own, so a session can happen on the sofa, in bed or with a book. Choose a color, start it and leave your hands free.</p>
        {%- when 'booster' -%}
          <h2 id="sk-use-title">Make room <em>for your ritual.</em></h2>
          <p>The Booster Pro is built for deliberate, unhurried moments: a compact wand you move slowly across the face while the light you chose is on.</p>
        {%- when 'bd' -%}
          <h2 id="sk-use-title">Press in. <em>Let it settle.</em></h2>
          <p>After the gel pad, apply the ampoule to cleansed skin as part of your moisturizing routine: a lightweight finishing step for supple-looking skin.</p>
        {%- else -%}
          <h2 id="sk-use-title">Built around <em>the neck and jaw.</em></h2>
          <p>The curved head follows the line of the neck, with constant-temperature vibration and your choice of LED color while you use it.</p>
      {%- endcase -%}
    </div>
  </div>
</section>

{%- comment -%} 7 · Details, materials, how it works {%- endcomment -%}
<section class="sk-sect sk-sect--stone" aria-labelledby="sk-spec-title">
  <div class="sk-wrap sk-info">
    <div>
      <span class="sk-eyebrow">The details</span>
      <h2 id="sk-spec-title">What you’re <em>getting.</em></h2>
      {%- if k == 'bd' -%}<p class="sk-lede" style="margin-top:16px">The full ingredient list is printed on each jar and bottle. Patch-test before first use and stop if irritation occurs.</p>{%- endif -%}
    </div>
    <dl class="sk-specs">
      {%- case k -%}
        {%- when 'lezo' -%}
          <div><dt>Type</dt><dd>Full-face LED mask</dd></div>
          <div><dt>Light modes</dt><dd>7: red, green, blue, purple, yellow, cyan, white</dd></div>
          <div><dt>LED channels</dt><dd>470, 520 and 630 nm</dd></div>
          <div><dt>Shell</dt><dd>White, with eye and mouth openings</dd></div>
          <div><dt>Fit</dt><dd>Adjustable head strap</dd></div>
          <div><dt>Use</dt><dd>Cosmetic, at home. Session time, eye protection, charging and cleaning per the included manual</dd></div>
        {%- when 'booster' -%}
          <div><dt>Format</dt><dd>Handheld facial wand</dd></div>
          <div><dt>Light</dt><dd>Multiple selectable colors</dd></div>
          <div><dt>Power</dt><dd>USB rechargeable, supplied charging setup</dd></div>
          <div><dt>Finishes</dt><dd>Pink, Black</dd></div>
          <div><dt>Care</dt><dd>Keep away from water unless the manual allows contact</dd></div>
          <div><dt>Use</dt><dd>Cosmetic, at home. Settings, duration and eye-area use per the manual</dd></div>
        {%- when 'bd' -%}
          <div><dt>Step 1</dt><dd>Gel toner pads</dd></div>
          <div><dt>Step 2</dt><dd>Ampoule</dd></div>
          <div><dt>Pink pairing</dt><dd>Collagen Gel Toner Pads + Collagen Ampoule</dd></div>
          <div><dt>Blue pairing</dt><dd>Cera-Nol Gel Toner Pads + Hydro Cera-Nol Ampoule</dd></div>
          <div><dt>Offer</dt><dd>One free matching ampoule per eligible pads, applied at checkout</dd></div>
          <div><dt>Ingredients</dt><dd>See the jar and bottle label</dd></div>
        {%- else -%}
          <div><dt>Modes</dt><dd>7 modes, 3 intensity levels</dd></div>
          <div><dt>Light</dt><dd>7 LED colors</dd></div>
          <div><dt>Material</dt><dd>ABS with electroplated finish, white</dd></div>
          <div><dt>Battery</dt><dd>400 mAh polymer lithium · 1–2 h use · 3 h charge</dd></div>
          <div><dt>Charging</dt><dd>5 V 1 A, USB-C cable included · 3 W rated</dd></div>
          <div><dt>Size</dt><dd>13.9 × 8.8 × 3.8 cm (5.47 × 3.46 × 1.5 in)</dd></div>
          <div><dt>In the box</dt><dd>Device, USB-C cable, instruction manual</dd></div>
          <div><dt>Listed certifications</dt><dd>RoHS, FCC, CE (as stated by the manufacturer)</dd></div>
      {%- endcase -%}
    </dl>
  </div>
</section>

{%- comment -%} 8 · Visual explainer {%- endcomment -%}
<section class="sk-sect" aria-labelledby="sk-how-title">
  <div class="sk-wrap">
    {%- if k == 'lezo' -%}
      <div class="sk-led" data-sk-led>
        <figure class="sk-led__visual sk-frame" style="--sk-glow:#e0463f;margin:0" data-sk-led-visual>
          {% render 'sk-img', img: explain_img, sizes: '(min-width: 1000px) 45vw, 100vw' %}
        </figure>
        <div>
          <span class="sk-eyebrow">Explore the seven colors</span>
          <h2 id="sk-how-title">One mask, <em>three channels.</em></h2>
          <p class="sk-lede" style="margin-top:18px">Each mode lights one, two or all three of LEZO’s LED channels. Tap a color to see its makeup.</p>
          <div class="sk-led__modes" role="group" aria-label="LEZO light modes">
            {%- assign modes = 'Red|#e0463f|630,Green|#3acb68|520,Blue|#3975f2|470,Purple|#a25ada|630+470,Yellow|#f0c13e|630+520,Cyan|#26c5ce|470+520,White|#f3efe6|470+520+630' | split: ',' -%}
            {%- for m in modes -%}
              {%- assign mp = m | split: '|' -%}
              <button type="button" class="sk-mode" style="--c:{{ mp[1] }}" data-name="{{ mp[0] }}" data-c="{{ mp[1] }}" data-nm="{{ mp[2] }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="{{ mp[0] }} light"><i></i></button>
            {%- endfor -%}
          </div>
          <h3 class="sk-led__name" data-sk-led-name aria-live="polite">Red <em>light</em></h3>
          <p class="sk-led__nm" data-sk-led-nm>630 nm channel</p>
          <div class="sk-channels" aria-label="LED channels in use">
            <div class="sk-ch" data-ch="470"><b>470</b><span>nm</span></div>
            <div class="sk-ch" data-ch="520"><b>520</b><span>nm</span></div>
            <div class="sk-ch is-on" data-ch="630"><b>630</b><span>nm</span></div>
          </div>
          <p class="sk-led__note">For cosmetic use. Not intended to diagnose, treat, cure or prevent any disease. Individual results vary.</p>
        </div>
      </div>
    {%- else -%}
      <div class="sk-head"><div><span class="sk-eyebrow">How to use it</span><h2 id="sk-how-title">
        {%- case k -%}
          {%- when 'booster' -%}Three steps, <em>start to finish.</em>
          {%- when 'bd' -%}Pad. Ampoule. <em>Done.</em>
          {%- else -%}Charge, choose, <em>glide.</em>
        {%- endcase -%}
      </h2></div>
      {%- if explain_img -%}<figure class="sk-frame sk-frame--16x9" style="margin:0">{% render 'sk-img', img: explain_img, sizes: '(min-width: 900px) 40vw, 100vw' %}</figure>{%- endif -%}
      </div>
      <ol class="sk-how" style="--n:3">
        {%- case k -%}
          {%- when 'booster' -%}
            <li><b>01</b><h3>Charge</h3><p>Recharge with the supplied USB charging setup before first use.</p></li>
            <li><b>02</b><h3>Choose a light</h3><p>Select a color setting as your manual describes.</p></li>
            <li><b>03</b><h3>Move slowly</h3><p>Glide the wand across the face. Around the eyes, follow the manual exactly.</p></li>
          {%- when 'bd' -%}
            <li><b>01</b><h3>Cleanse</h3><p>Start with clean skin. Patch-test before the first use.</p></li>
            <li><b>02</b><h3>Gel pad</h3><p>Smooth a pad over the skin for a fresh, hydrated feel.</p></li>
            <li><b>03</b><h3>Ampoule</h3><p>Apply the matching ampoule as the last moisturizing step.</p></li>
          {%- else -%}
            <li><b>01</b><h3>Charge</h3><p>About 3 hours over the included USB-C cable gives 1–2 hours of use.</p></li>
            <li><b>02</b><h3>Choose</h3><p>Power on, then pick one of the seven modes and one of three levels.</p></li>
            <li><b>03</b><h3>Glide</h3><p>Hold the handle and move the curved head along the neck and jawline.</p></li>
        {%- endcase -%}
      </ol>
    {%- endif -%}
  </div>
</section>

{%- comment -%} 9 · Complementary bundle {%- endcomment -%}
<section class="sk-sect sk-sect--stone" aria-labelledby="sk-pb-title">
  <div class="sk-wrap">
    <div class="sk-head">
      <div><span class="sk-eyebrow">Bundles · 20% off</span><h2 id="sk-pb-title">{% if k == 'neck' %}Build the rest <em>of the routine.</em>{% else %}Pair it. <em>Save 20%.</em>{% endif %}</h2></div>
      <p class="sk-lede">{% if k == 'neck' %}The face and neck massager sits outside the bundle offer. These rituals pair our mask, wand and collagen steps at 20% off.{% else %}Add any two of the LEZO mask, Booster Pro and Biodance pads or ampoules and the 20% is applied at checkout.{% endif %}</p>
    </div>
    {% render 'sk-bundles', selected: bundle_key, uid: 'pdp' %}
  </div>
</section>

{%- comment -%} 10 · Delivery, returns, FAQ {%- endcomment -%}
<section class="sk-sect" aria-labelledby="sk-faq-title">
  <div class="sk-wrap sk-info">
    <div>
      <span class="sk-eyebrow">Good to know</span>
      <h2 id="sk-faq-title">Delivery, returns <em>and questions.</em></h2>
      <p class="sk-lede" style="margin-top:16px">Something else? Email <a href="mailto:{{ shop.email }}">{{ shop.email }}</a> or <a href="https://wa.me/17042267049" target="_blank" rel="noopener">message us on WhatsApp</a>.</p>
    </div>
    <div class="sk-faq">
      <details><summary>When will it arrive?</summary><div class="sk-faq__a"><p>{{ delivery }} Your tracking number is emailed the day the order ships.</p></div></details>
