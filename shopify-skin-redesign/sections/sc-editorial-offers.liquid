{% comment %}
  Section contract.
  Home, under the cover: the three lead offers as editorial banners (snippets/hb-poster: science
  micrograph, real cutouts, live price). Same banner system as the Rituals section and the
  product pages, so every offer on the site looks and reads the same.
  @example
  <!-- templates/index.json → "editorial_offers" -->
{% endcomment %}
<section class="sc-ed" aria-label="Offers">
  {% render 'hb-poster', art: 'lezo' %}
  {% render 'hb-poster', art: 'daily', url: '#hb-kits' %}
  {% render 'hb-poster', art: 'collagen' %}
</section>
<style>
.sc-ed{display:grid;gap:12px;max-width:1440px;margin:0 auto;padding:12px;background:#fff}
.sc-ed .hbp{margin:0}
@media(min-width:900px){.sc-ed{grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;padding:14px}}
</style>
{% schema %}
{"name":"SC editorial offers","settings":[],"presets":[{"name":"SC editorial offers"}]}
{% endschema %}
