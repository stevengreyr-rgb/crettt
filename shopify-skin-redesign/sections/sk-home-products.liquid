{% comment %}
  Section contract.
  Home, under the LEZO hero: the line-up. One tile per SEVENCRUSH skincare product that is
  live on the online store, priced live, with quick add where the product has a single variant.
  Archived or unpublished products are skipped (all_products still returns them, with no url).
  @example
  <!-- templates/index.json → "sk_products" -->
{% endcomment %}
{%- assign handles = 'lezo-7-color-led-face-mask,new-booster-pro-led-facial-light-therapy-7-colors-eye-beauty-wand-red-light-eye-massager-for-skincare-blue-rejuvenation-tool,korean-collagen-ampoule-serum-moisturizing-brightening-face-mask-gel-toner-cotton-pads-firming-gentle-and-non-irritating-skin-ca,home-use-led-face-neck-massager-7-colors-light-therapy-7-modes-3-levels-vibration-face-lifting-anti-wrinkle-beauty-instrument' | split: ',' -%}
<section class="hb hb-sec" id="sk-shop" aria-labelledby="hb-lineup-h">
  <div class="hb-wrap">
    <div class="hb-sec__head">
      <span class="hb-new">{{ section.settings.kicker | escape }}</span>
      <h2 class="hb-sec__h" id="hb-lineup-h">{{ section.settings.heading | escape }}</h2>
      <p class="hb-sec__lede">{{ section.settings.text | escape }}</p>
    </div>
    <div class="hb-grid hb-grid--lineup">
      {%- for h in handles -%}
        {%- assign pr = all_products[h] -%}
        {%- if pr and pr.id and pr.title != blank and pr.url != blank and pr.price > 0 -%}{% render 'hb-card', p: pr %}{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
<style>
@media(min-width:900px){.hb-grid--lineup{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:899px){
  .hb-grid--lineup>.hb-card:last-of-type:nth-of-type(odd){grid-column:1/-1;display:grid;grid-template-columns:1fr 1fr;column-gap:14px;align-items:start}
  .hb-grid--lineup>.hb-card:last-of-type:nth-of-type(odd) .hb-card__media{grid-row:1/span 6}
  .hb-grid--lineup>.hb-card:last-of-type:nth-of-type(odd) .hbc__k{margin-top:4px}
}
</style>
{% schema %}
{
  "name": "HB · Line-up",
  "settings": [
    {"type": "text", "id": "kicker", "label": "Kicker", "default": "The line-up"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Three tools. One routine."},
    {"type": "textarea", "id": "text", "label": "Intro", "default": "An LED mask for the whole face, a wand for the details and Biodance collagen to finish. Pair any two and 20% comes off at checkout."}
  ],
  "presets": [{"name": "HB · Line-up"}]
}
{% endschema %}
