{% comment %}
  Section contract.
  Home: rituals. The kits panel (live prices, 20% worked out the way checkout applies the
  automatic discount) with the posters for the live offers.
  @example
  <!-- templates/index.json → "sk_bundles" -->
{% endcomment %}
<section class="hb hb-sec hb-sec--blush" id="sk-bundles" aria-labelledby="hb-rit-h">
  <div class="hb-wrap hb-rituals">
    <div>
      <div class="hb-sec__head hb-sec__head--l">
        <span class="hb-new">{{ section.settings.kicker | escape }}</span>
        <h2 class="hb-sec__h hb-sec__h--l" id="hb-rit-h">{{ section.settings.heading | escape }}</h2>
        <p class="hb-sec__lede hb-sec__lede--l">{{ section.settings.text | escape }}</p>
      </div>
      {% render 'hb-poster', pill: 'Ritual · Save 20%', title: 'The<br>Complete<br>Routine', sub: 'Mask, wand, pads and ampoule.<br>20% off everything', art: 'complete', url: '#hb-kits' %}
      {% render 'hb-poster', pill: 'Complimentary gift', title: 'Collagen<br>Ampoule', sub: 'Free with any Biodance<br>gel toner pads', art: 'collagen', url: '/products/korean-collagen-ampoule-serum-moisturizing-brightening-face-mask-gel-toner-cotton-pads-firming-gentle-and-non-irritating-skin-ca' %}
    </div>
    <div>{% render 'hb-kits' %}</div>
  </div>
</section>
{% schema %}
{
  "name": "HB · Rituals",
  "settings": [
    {"type": "text", "id": "kicker", "label": "Kicker", "default": "Rituals"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Buy the routine. Keep 20%."},
    {"type": "textarea", "id": "text", "label": "Text", "default": "Every kit is priced from today’s prices, and the 20% is applied by Shopify at checkout, line by line. What you see here is what you pay."}
  ],
  "presets": [{"name": "HB · Rituals"}]
}
{% endschema %}
