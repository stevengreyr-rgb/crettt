{% comment %}
  Section contract.
  Home: LEZO color explorer (three LED channels behind seven modes, from the product
  description) and the five-step guide the hero's "How to use" link lands on (#como-usar).
  @example
  <!-- templates/index.json → "sk_led" -->
{% endcomment %}
{%- assign led_img = section.settings.image | default: images['sc-v3-mask-lounge.png'] -%}
<section class="hb hb-sec hb-sec--blush" id="sk-led" aria-labelledby="hb-led-h">
  <div class="hb-wrap">
    <div class="hb-story__grid hb-ledx" data-sk-led>
      <figure class="sk-led__visual" style="--sk-glow:#e0463f" data-sk-led-visual>{% render 'sk-img', img: led_img, sizes: '(min-width: 900px) 45vw, 100vw' %}</figure>
      <div>
        <span class="hb-new" style="margin-top:0">{{ section.settings.kicker | escape }}</span>
        <h2 class="hb-sec__h hb-sec__h--l" id="hb-led-h">{{ section.settings.heading | escape }}</h2>
        <p class="hb-sec__lede hb-sec__lede--l">{{ section.settings.text | escape }}</p>
        <div class="hb-ledx__modes" role="group" aria-label="LEZO light modes">
          {%- assign modes = 'Red|#e0463f|630,Green|#3acb68|520,Blue|#3975f2|470,Purple|#a25ada|630+470,Yellow|#f0c13e|630+520,Cyan|#26c5ce|470+520,White|#f3efe6|470+520+630' | split: ',' -%}
          {%- for m in modes -%}
            {%- assign mp = m | split: '|' -%}
            <button type="button" class="sk-mode" style="--c:{{ mp[1] }}" data-name="{{ mp[0] }}" data-c="{{ mp[1] }}" data-nm="{{ mp[2] }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="{{ mp[0] }} light"><i></i></button>
          {%- endfor -%}
        </div>
        <p class="sk-led__name" data-sk-led-name aria-live="polite">Red <em>light</em></p>
        <p class="sk-led__nm" data-sk-led-nm>630 nm channel</p>
        <div class="sk-channels" aria-label="LED channels in use">
          <div class="sk-ch" data-ch="470"><b>470</b><span>nm</span></div>
          <div class="sk-ch" data-ch="520"><b>520</b><span>nm</span></div>
          <div class="sk-ch is-on" data-ch="630"><b>630</b><span>nm</span></div>
        </div>
        <p class="hb-note">Photographed in blue mode. Session time and eye protection for every mode are in the manual in the box.</p>
      </div>
    </div>
    <div id="como-usar" class="hb-steps-wrap">
      <h3 class="hb-steps__h">How to use LEZO</h3>
      <ol class="hb-steps">
        <li><b>01</b><span>Charge the mask fully before the first session.</span></li>
        <li><b>02</b><span>Start with clean, dry skin.</span></li>
        <li><b>03</b><span>Fit the strap so the shell sits evenly.</span></li>
        <li><b>04</b><span>Pick a color. Keep to the session time in your manual.</span></li>
        <li><b>05</b><span>Clean it as the manual says. Store it dry.</span></li>
      </ol>
      <p style="margin-top:22px"><a class="hb-pill hb-pill--pk" href="/products/lezo-7-color-led-face-mask">Shop LEZO</a></p>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "HB · LEZO explorer",
  "settings": [
    {"type": "text", "id": "kicker", "label": "Kicker", "default": "Inside LEZO"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Seven colors. Three LEDs."},
    {"type": "textarea", "id": "text", "label": "Text", "default": "Every LEZO mode is a mix of the same three channels: 470, 520 and 630 nm. Tap a color to see which ones it lights."},
    {"type": "image_picker", "id": "image", "label": "Image"}
  ],
  "presets": [{"name": "HB · LEZO explorer"}]
}
{% endschema %}
