{% comment %}
  Section contract.
  Home: editorial photographs of the products in use (#ritual, linked from the hero nav).
  @example
  <!-- templates/index.json → "sk_lifestyle" -->
{% endcomment %}
{%- liquid
  assign img_a = section.settings.image_a | default: images['lz-mask-sofa.png']
  assign img_b = section.settings.image_b | default: images['sc-v3-vanity.png']
  assign img_c = section.settings.image_c | default: images['lz-ritual-table.webp']
-%}
<section class="hb hb-sec" id="ritual" aria-labelledby="hb-life-h">
  <div class="hb-wrap">
    <div class="hb-sec__head">
      <span class="hb-new">{{ section.settings.kicker | escape }}</span>
      <h2 class="hb-sec__h" id="hb-life-h">{{ section.settings.heading | escape }}</h2>
      <p class="hb-sec__lede">{{ section.settings.text | escape }}</p>
    </div>
    <div class="hb-edit">
      <figure class="hb-edit__a"><div class="hb-frame">{% render 'sk-img', img: img_a, sizes: '(min-width: 900px) 50vw, 100vw' %}</div><figcaption><b>01 · Light.</b> {{ section.settings.cap_a | escape }}</figcaption></figure>
      <figure><div class="hb-frame">{% render 'sk-img', img: img_b, sizes: '(min-width: 900px) 25vw, 50vw' %}</div><figcaption><b>02 · Touch.</b> {{ section.settings.cap_b | escape }}</figcaption></figure>
      <figure><div class="hb-frame">{% render 'sk-img', img: img_c, sizes: '(min-width: 900px) 25vw, 50vw' %}</div><figcaption><b>03 · Hydrate.</b> {{ section.settings.cap_c | escape }}</figcaption></figure>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "HB · In use",
  "settings": [
    {"type": "text", "id": "kicker", "label": "Kicker", "default": "In use"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Made for the end of the day."},
    {"type": "textarea", "id": "text", "label": "Text", "default": "Strap on the mask and lie back. Follow with the wand where you want more attention. Finish with a gel pad and an ampoule before bed."},
    {"type": "image_picker", "id": "image_a", "label": "Large image"},
    {"type": "text", "id": "cap_a", "label": "Caption 1", "default": "LEZO on red, hands free."},
    {"type": "image_picker", "id": "image_b", "label": "Image 2"},
    {"type": "text", "id": "cap_b", "label": "Caption 2", "default": "The wand, at the vanity."},
    {"type": "image_picker", "id": "image_c", "label": "Image 3"},
    {"type": "text", "id": "cap_c", "label": "Caption 3", "default": "Pad, then ampoule."}
  ],
  "presets": [{"name": "HB · In use"}]
}
{% endschema %}
