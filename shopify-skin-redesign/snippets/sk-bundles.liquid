{% doc %}
  Bundle builder: pick a ritual, choose variants, see the real 20% saving and add every item
  to the cart in one request. Prices come from the live variants; the discount itself is the
  automatic "Ritual bundle · 20% off 2+" discount, so the checkout applies it, not this UI.

  @param {string} [selected] - bundle key shown first: daily, collagen or complete
  @param {string} [uid] - unique suffix when the builder renders more than once per page

  @example
  {% render 'sk-bundles', selected: 'complete', uid: 'home' %}
{% enddoc %}
{%- liquid
  assign lezo = all_products['lezo-7-color-led-face-mask']
  assign booster = all_products['new-booster-pro-led-facial-light-therapy-7-colors-eye-beauty-wand-red-light-eye-massager-for-skincare-blue-rejuvenation-tool']
  assign bd = all_products['korean-collagen-ampoule-serum-moisturizing-brightening-face-mask-gel-toner-cotton-pads-firming-gentle-and-non-irritating-skin-ca']
  assign selected = selected | default: 'complete'
  assign uid = uid | default: 'b'
-%}
{%- capture sk_bundle_json -%}
{
  "pct": 20,
  "money": {{ shop.money_format | json }},
  "products": {
    "lezo": {"title": "LEZO 7-Color LED Face Mask", "url": {{ lezo.url | json }}, "label": "Mask", "variants": [
      {%- for v in lezo.variants -%}{"id": {{ v.id }}, "name": "One size", "price": {{ v.price }}, "available": {{ v.available | json }}, "img": {{ lezo.featured_image | image_url: width: 500 | json }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}
    ]},
    "booster": {"title": "Booster Pro LED Wand", "url": {{ booster.url | json }}, "label": "Finish", "variants": [
      {%- for v in booster.variants -%}{"id": {{ v.id }}, "name": {{ v.title | capitalize | json }}, "price": {{ v.price }}, "available": {{ v.available | json }}, "img": {{ v.featured_image | default: booster.featured_image | image_url: width: 500 | json }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}
    ]},
    "bd": {"title": "Biodance Collagen Step", "url": {{ bd.url | json }}, "label": "Choose your step", "variants": [
      {%- for v in bd.variants -%}
        {%- liquid
          case v.id
            when 50956618858715
              assign vname = 'Collagen Gel Toner Pads · pink'
            when 50956618891483
              assign vname = 'Collagen Ampoule · pink'
            when 50956618629339
              assign vname = 'Cera-Nol Gel Toner Pads · blue'
            when 50956618825947
              assign vname = 'Hydro Cera-Nol Ampoule · blue'
            else
              assign vname = v.title
          endcase
        -%}
        {"id": {{ v.id }}, "name": {{ vname | json }}, "price": {{ v.price }}, "available": {{ v.available | json }}, "img": {{ v.featured_image | default: bd.featured_image | image_url: width: 500 | json }}}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]}
  },
  "bundles": [
    {"key": "daily", "name": "The Daily Ritual", "for": "Full-face light while you rest, plus a handheld wand for the areas you want to focus on.", "items": ["lezo", "booster"]},
    {"key": "collagen", "name": "Light & Collagen", "for": "Your LED session, then a hydrating gel pad or ampoule to finish.", "items": ["lezo", "bd"]},
    {"key": "complete", "name": "The Complete Routine", "for": "Every step we sell, in the order you use it: mask, wand, collagen.", "items": ["lezo", "booster", "bd"]}
  ]
}
{%- endcapture -%}
<div class="sk-bundle" data-sk-bundle data-selected="{{ selected | escape }}" id="sk-bundle-{{ uid }}">
  <script type="application/json" data-sk-bundle-data>{{ sk_bundle_json | strip_newlines }}</script>
  <div class="sk-bundle__pick">
    <div class="sk-bundle__tabs" role="tablist" aria-label="Choose a bundle">
      <button type="button" class="sk-tab" role="tab" data-key="daily" aria-selected="{% if selected == 'daily' %}true{% else %}false{% endif %}" aria-controls="sk-bpanel-{{ uid }}">The Daily Ritual · 2</button>
      <button type="button" class="sk-tab" role="tab" data-key="collagen" aria-selected="{% if selected == 'collagen' %}true{% else %}false{% endif %}" aria-controls="sk-bpanel-{{ uid }}">Light &amp; Collagen · 2</button>
      <button type="button" class="sk-tab" role="tab" data-key="complete" aria-selected="{% if selected == 'complete' %}true{% else %}false{% endif %}" aria-controls="sk-bpanel-{{ uid }}">The Complete Routine · 3</button>
    </div>
    <div class="sk-bundle__items" data-sk-bitems style="margin-top:14px"></div>
  </div>
  <div class="sk-bundle__panel" id="sk-bpanel-{{ uid }}" role="tabpanel" aria-live="polite">
    <span class="sk-eyebrow sk-eyebrow--muted" data-sk-bcount>Bundle</span>
    <h3 class="sk-bundle__name" data-sk-bname>Build your ritual</h3>
    <p class="sk-bundle__for" data-sk-bfor></p>
    <div class="sk-sum">
      <div><span>Items at today’s prices</span><span data-sk-borig></span></div>
      <div class="is-off"><span>Bundle saving · 20%</span><span data-sk-boff></span></div>
      <div class="is-total"><span>Your price</span><span><s data-sk-borig2></s><span data-sk-bfinal></span></span></div>
    </div>
    <span class="sk-save" data-sk-bsave></span>
    <button type="button" class="sk-btn sk-btn--block" data-sk-badd>Add bundle to cart</button>
    <p class="sk-msg" data-sk-bmsg role="status"></p>
    <p class="sk-bundle__fine">The 20% is applied automatically at checkout to any 2 or more of the LEZO mask, Booster Pro and Biodance pads or ampoules. It doesn’t stack with other discount codes; checkout keeps whichever single offer saves you more.</p>
    <noscript><p class="sk-bundle__fine">Add the items from their product pages; the 20% applies automatically at checkout.</p></noscript>
  </div>
</div>
