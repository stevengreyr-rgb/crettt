{% doc %}
  "Save with rituals" kit cards for the home and the product landings. Each kit lists real
  variants priced live from Shopify; the 20% shown is worked out the way checkout applies the
  automatic "Ritual bundle · 20% off 2+" discount (per line, rounded down). Kits add every item
  in one request; "Check out now" adds and goes straight to the Shopify checkout.

  Finish and pairing choices are swatch radios that drive a hidden select[data-slot], which is
  what initKit() in sk.js listens to; the small script at the end keeps "Save $X" in step. Each card is an editorial banner on the
  same micrographs as snippets/hb-poster.

  @example
  {% render 'hb-kits' %}
{% enddoc %}
{%- liquid
  assign lezo = all_products['lezo-7-color-led-face-mask']
  assign booster = all_products['new-booster-pro-led-facial-light-therapy-7-colors-eye-beauty-wand-red-light-eye-massager-for-skincare-blue-rejuvenation-tool']
  assign bd = all_products['korean-collagen-ampoule-serum-moisturizing-brightening-face-mask-gel-toner-cotton-pads-firming-gentle-and-non-irritating-skin-ca']
  assign v_lezo = lezo.selected_or_first_available_variant
  for v in booster.variants
    if v.id == 50957033046235
      assign v_bk = v
    elsif v.id == 50957033013467
      assign v_pk = v
    endif
  endfor
  for v in bd.variants
    case v.id
      when 50956618858715
        assign v_pads_pink = v
      when 50956618891483
        assign v_amp_pink = v
      when 50956618629339
        assign v_pads_blue = v
      when 50956618825947
        assign v_amp_blue = v
    endcase
  endfor
  assign kits = 'complete,daily,collagen' | split: ','
  assign i_lezo = images['sk-cut-lezo.png'] | image_url: width: 600
  assign i_bk = images['sk-cut-booster-black.png'] | image_url: width: 400
  assign i_pk = images['sk-cut-booster-pink.png'] | image_url: width: 400
  assign i_bdp = images['sk-cut-collagen-duo.png'] | image_url: width: 500
  assign i_bdb = images['sk-cut-ceranol-duo.png'] | image_url: width: 500
-%}
{%- capture o_lezo -%}{"name":"LEZO LED Mask","img":{{ i_lezo | json }},"items":[{"id":{{ v_lezo.id }},"price":{{ v_lezo.price }}}]}{%- endcapture -%}
{%- capture o_bk -%}{"name":"Booster Pro · Black","img":{{ i_bk | json }},"items":[{"id":{{ v_bk.id }},"price":{{ v_bk.price }}}]}{%- endcapture -%}
{%- capture o_pk -%}{"name":"Booster Pro · Pink","img":{{ i_pk | json }},"items":[{"id":{{ v_pk.id }},"price":{{ v_pk.price }}}]}{%- endcapture -%}
{%- capture o_bdp -%}{"name":"Pink Collagen pads + ampoule","img":{{ i_bdp | json }},"items":[{"id":{{ v_pads_pink.id }},"price":{{ v_pads_pink.price }}},{"id":{{ v_amp_pink.id }},"price":{{ v_amp_pink.price }}}]}{%- endcapture -%}
{%- capture o_bdb -%}{"name":"Blue Cera-Nol pads + ampoule","img":{{ i_bdb | json }},"items":[{"id":{{ v_pads_blue.id }},"price":{{ v_pads_blue.price }}},{"id":{{ v_amp_blue.id }},"price":{{ v_amp_blue.price }}}]}{%- endcapture -%}
<section class="rk" id="hb-kits" aria-labelledby="hb-kits-h">
  <header class="rk__head">
    <p class="rk__eyebrow">Three rituals · 20% off each</p>
    <h2 class="rk__h" id="hb-kits-h">Save with rituals</h2>
  </header>
  {%- for k in kits -%}
    {%- liquid
      case k
        when 'complete'
          assign k_name = 'The Complete Routine'
          assign k_flag = 'Most complete'
          assign k_count = '4 items'
          assign k_vars = v_lezo.price | append: ',' | append: v_bk.price | append: ',' | append: v_pads_pink.price | append: ',' | append: v_amp_pink.price
        when 'daily'
          assign k_name = 'The Daily Ritual'
          assign k_flag = 'Light duo'
          assign k_count = '2 items'
          assign k_vars = v_lezo.price | append: ',' | append: v_bk.price
        when 'collagen'
          assign k_name = 'Light & Hydration'
          assign k_flag = 'Mask + collagen'
          assign k_count = '3 items'
          assign k_vars = v_lezo.price | append: ',' | append: v_pads_pink.price | append: ',' | append: v_amp_pink.price
      endcase
      assign k_total = 0
      assign k_off = 0
      assign k_prices = k_vars | split: ','
      for pr in k_prices
        assign pi = pr | plus: 0
        assign k_total = k_total | plus: pi
        assign line_off = pi | times: 20 | divided_by: 100
        assign k_off = k_off | plus: line_off
      endfor
      assign k_final = k_total | minus: k_off
      if k == 'complete'
        assign bslot = 2
      else
        assign bslot = 1
      endif
    -%}
    {%- capture k_json -%}{"name":{{ k_name | json }},"pct":20,"slots":[
      [{{ o_lezo }}]
      {%- if k == 'complete' or k == 'daily' -%},[{{ o_bk }},{{ o_pk }}]{%- endif -%}
      {%- if k == 'complete' or k == 'collagen' -%},[{{ o_bdp }},{{ o_bdb }}]{%- endif -%}
    ]}{%- endcapture -%}
    {%- liquid
      case k
        when 'complete'
          assign k_sci = 'hb-sci-complete.png'
          assign k_h = 'The Complete'
          assign k_em = 'Routine.'
          assign k_what = 'Mask · wand · pads + ampoule'
          assign k_tone = 'light'
        when 'daily'
          assign k_sci = 'hb-sci-cells.png'
          assign k_h = 'The Daily'
          assign k_em = 'Ritual.'
          assign k_what = 'Mask · wand'
          assign k_tone = 'light'
        else
          assign k_sci = 'hb-sci-collagen.png'
          assign k_h = 'Light &'
          assign k_em = 'Hydration.'
          assign k_what = 'Mask · pads + ampoule'
          assign k_tone = 'light'
      endcase
    -%}
    <article class="rk-card rk-card--{{ k }}" data-hb-kit>
      <script type="application/json" data-hb-kit-data>{{ k_json | strip_newlines }}</script>
      <div class="rk-ban rk-ban--{{ k_tone }}">
        {%- if images[k_sci] -%}{{ images[k_sci] | image_url: width: 1400 | image_tag: class: 'rk-ban__ph', widths: '600,900,1200,1400', sizes: '(min-width: 1000px) 45vw, 100vw', alt: '', loading: 'lazy' }}{%- endif -%}
        <div class="rk-ban__art" aria-hidden="true">
          {%- if k == 'complete' -%}
            <img data-slot-img="0" src="{{ i_lezo }}" alt="" style="right:29%;bottom:9%;width:24%" loading="lazy">
            <img data-slot-img="1" src="{{ i_bk }}" alt="" style="right:18%;bottom:6%;width:12%;z-index:2" loading="lazy">
            <img data-slot-img="2" src="{{ i_bdp }}" alt="" style="right:1%;bottom:5%;width:22%;z-index:3" loading="lazy">
          {%- elsif k == 'daily' -%}
            <img data-slot-img="0" src="{{ i_lezo }}" alt="" style="right:19%;bottom:7%;width:30%" loading="lazy">
            <img data-slot-img="1" src="{{ i_bk }}" alt="" style="right:5%;bottom:6%;width:13%;z-index:2" loading="lazy">
          {%- else -%}
            <img data-slot-img="0" src="{{ i_lezo }}" alt="" style="right:25%;bottom:8%;width:27%" loading="lazy">
            <img data-slot-img="1" src="{{ i_bdp }}" alt="" style="right:2%;bottom:5%;width:26%;z-index:2" loading="lazy">
          {%- endif -%}
        </div>
        <div class="rk-ban__c">
          <p class="rk-ban__k">0{{ forloop.index }} · {{ k_count }} · {{ k_flag }}</p>
          <h3 class="rk-ban__h">{{ k_h }}<br><em>{{ k_em }}</em></h3>
          <p class="rk-ban__o"><b data-hb-kit-now>{{ k_final | money }}</b><span><s data-hb-kit-was>{{ k_total | money }}</s><i data-rk-save>Save {{ k_off | money }}</i></span></p>
          <p class="rk-ban__w">{{ k_what }}</p>
        </div>
        <span class="rk-ban__cap">Illustrative micrograph</span>
      </div>
      <div class="rk-card__body">
        {%- if k == 'complete' or k == 'daily' -%}
          <fieldset class="rk-opt" data-rk-for="hb-k-{{ k }}-1">
            <legend>Wand</legend>
            <label><input type="radio" name="rk-{{ k }}-1" value="0" checked><i style="--c:#161616"></i>Black</label>
            <label><input type="radio" name="rk-{{ k }}-1" value="1"><i style="--c:#f4c3cf"></i>Pink</label>
          </fieldset>
          <select id="hb-k-{{ k }}-1" data-slot="1" hidden tabindex="-1" aria-hidden="true"><option value="0">Booster Pro · Black</option><option value="1">Booster Pro · Pink</option></select>
        {%- endif -%}
        {%- if k == 'complete' or k == 'collagen' -%}
          <fieldset class="rk-opt" data-rk-for="hb-k-{{ k }}-{{ bslot }}">
            <legend>Biodance</legend>
            <label><input type="radio" name="rk-{{ k }}-{{ bslot }}" value="0" checked><i style="--c:#f2a9bd"></i>Pink Collagen</label>
            <label><input type="radio" name="rk-{{ k }}-{{ bslot }}" value="1"><i style="--c:#93bde8"></i>Blue Cera-Nol</label>
          </fieldset>
          <select id="hb-k-{{ k }}-{{ bslot }}" data-slot="{{ bslot }}" hidden tabindex="-1" aria-hidden="true"><option value="0">Biodance · Pink Collagen</option><option value="1">Biodance · Blue Cera-Nol</option></select>
        {%- endif -%}
        <div class="rk-card__btns">
          <button type="button" class="rk-card__add" data-hb-kit-add>Add ritual to bag</button>
          <button type="button" class="rk-card__buy" data-hb-kit-buy>Or check out now <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></button>
        </div>
        <p class="rk-card__msg" data-hb-kit-msg role="status"></p>
      </div>
    </article>
  {%- endfor -%}
  <p class="rk__note">20% comes off automatically at checkout on any 2 or more of the LEZO mask, Booster Pro and Biodance pads or ampoules. It doesn’t stack with other codes; checkout keeps the single offer that saves you more.</p>
</section>
<style>
.rk{scroll-margin-top:84px;margin:26px 0;font-family:var(--hb-sans);color:var(--hb-ink);--rk-ed:"Instrument Serif","Times New Roman",serif}
.rk__head{display:flex;flex-direction:column;gap:6px;margin:0 0 18px}
.rk__eyebrow{margin:0;font:800 15px/1 var(--hb-disp);letter-spacing:.08em;text-transform:uppercase;color:var(--hb-pk)}
.rk__h{margin:0;font:800 clamp(38px,6vw,54px)/.92 var(--hb-disp);text-transform:uppercase;letter-spacing:-.005em}
.rk-card{background:#fff;border-radius:22px;overflow:hidden;margin-top:16px;box-shadow:0 1px 0 rgba(0,0,0,.03),0 18px 40px -22px rgba(120,40,70,.28)}
.rk-ban{position:relative;overflow:hidden;aspect-ratio:16/9;container-type:inline-size;isolation:isolate;background:#f6dfe6;color:#1a1012;--rk-ac:#b8336a}
.rk-ban__ph{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2}
.rk-ban__art{position:absolute;inset:0;z-index:1;pointer-events:none}
.rk-ban__art img{position:absolute;height:auto;max-width:none;filter:drop-shadow(0 0 2.2cqi rgba(255,255,255,.75)) drop-shadow(0 1.6cqi 1.4cqi rgba(40,15,25,.32));transition:opacity .25s}
.rk-ban__c{position:absolute;left:5.5%;top:50%;transform:translateY(-50%);width:46%;z-index:2}
.rk-ban__k{margin:0 0 1.6cqi;font:800 max(2.1cqi,10px)/1.2 var(--hb-disp);letter-spacing:.18em;text-transform:uppercase;color:var(--rk-ac)}
.rk-ban__h{margin:0;font:800 7.2cqi/.86 var(--hb-disp);text-transform:uppercase;letter-spacing:-.01em}
.rk-ban__h em{display:inline-block;margin-top:.6cqi;font:italic 400 6cqi/.95 var(--rk-ed);text-transform:none;color:var(--rk-ac)}
.rk-ban__o{display:flex;flex-wrap:wrap;align-items:flex-end;gap:1cqi 1.8cqi;margin:2.8cqi 0 0}
.rk-ban__o b{font:800 9cqi/.8 var(--hb-disp);letter-spacing:-.02em}
.rk-ban__o span{display:flex;flex-direction:column;gap:.7cqi;padding-bottom:.3cqi}
.rk-ban__o s{font:600 max(2.4cqi,11px)/1 var(--hb-sans);opacity:.7}
.rk-ban__o i{font:italic 400 max(3cqi,13px)/1 var(--rk-ed);color:var(--rk-ac)}
.rk-ban__w{margin:2.4cqi 0 0;padding-bottom:.5cqi;font:800 max(2.3cqi,11px)/1 var(--hb-disp);letter-spacing:.16em;text-transform:uppercase}
.rk-ban__cap{position:absolute;right:4%;top:5%;z-index:2;font:600 max(1.5cqi,8px)/1 var(--hb-sans);letter-spacing:.14em;text-transform:uppercase;opacity:.55}
.rk-card__body{display:grid;gap:14px;padding:18px 20px 16px}
.rk-opt{border:0;margin:0;padding:0;display:flex;flex-wrap:wrap;align-items:center;gap:8px;min-inline-size:0}
.rk-opt legend{float:left;width:100%;margin:0 0 8px;padding:0;font:800 13px/1 var(--hb-disp);letter-spacing:.16em;text-transform:uppercase;color:var(--hb-grey)}
.rk-opt label{position:relative;display:inline-flex;align-items:center;gap:8px;min-height:40px;padding:0 14px 0 8px;border:1.5px solid var(--hb-line);border-radius:999px;font:600 14px/1 var(--hb-sans);cursor:pointer;transition:border-color .2s,box-shadow .2s}
.rk-opt input{position:absolute;opacity:0;inset:0;margin:0;cursor:pointer}
.rk-opt i{width:24px;height:24px;border-radius:50%;background:var(--c);box-shadow:inset 0 0 0 1px rgba(0,0,0,.12)}
.rk-opt label:has(input:checked){border-color:var(--hb-ink);box-shadow:inset 0 0 0 1px var(--hb-ink)}
.rk-opt label:has(input:focus-visible){outline:2px solid var(--hb-pk);outline-offset:2px}
.rk-card__btns{display:grid;gap:2px;margin-top:2px}
.rk-card__add{display:flex;align-items:center;justify-content:center;width:100%;min-height:54px;border:0;border-radius:999px;background:var(--hb-pk);color:#fff;font:800 20px/1 var(--hb-disp);letter-spacing:.05em;text-transform:uppercase;cursor:pointer;transition:background .2s,transform .2s}
.rk-card__add:hover{background:var(--hb-pk-dk)}
.rk-card__add:active{transform:scale(.99)}
.rk-card__buy{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;min-height:42px;border:0;background:none;color:var(--hb-ink);font:800 15px/1 var(--hb-disp);letter-spacing:.16em;text-transform:uppercase;cursor:pointer;text-decoration:underline;text-underline-offset:4px}
.rk-card__buy svg{width:16px;height:16px}
.rk-card [disabled],.rk-card [aria-busy=true]{opacity:.55;cursor:not-allowed}
.rk-card__msg{margin:0;min-height:1em;font-size:13px;text-align:center}
.rk-card__msg.is-err{color:#b3261e}
.rk__note{margin:16px 4px 0;font-size:13px;line-height:1.45;color:var(--hb-grey)}
.rk-opt legend{float:left;width:auto;line-height:40px;margin:0 6px 0 0;min-width:72px}
@media(min-width:620px){.rk-card__body{padding:20px 24px 18px}}
</style>
<script>
(() => {
  const money = (t) => Number(String(t).replace(/[^0-9.]/g, '')) || 0;
  document.querySelectorAll('.rk-card').forEach((card) => {
    card.querySelectorAll('.rk-opt').forEach((fs) => {
      const sel = document.getElementById(fs.dataset.rkFor);
      fs.addEventListener('change', (e) => {
        if (!sel || !e.target.checked) return;
        sel.value = e.target.value;
        sel.dispatchEvent(new Event('change'));
      });
    });
    const now = card.querySelector('[data-hb-kit-now]'), was = card.querySelector('[data-hb-kit-was]'), save = card.querySelector('[data-rk-save]');
    if (!now || !was || !save) return;
    const paint = () => {
      const d = money(was.textContent) - money(now.textContent);
      const cur = now.textContent.trim().replace(/[0-9.,\s]+$/, '') || '$';
      if (d > 0) save.textContent = 'Save ' + cur + d.toFixed(2);
    };
    new MutationObserver(paint).observe(now, { childList: true, characterData: true, subtree: true });
  });
})();
</script>
