{%- liquid
  # SEVENCRUSH: one design system ("hb") for every storefront route except blogs,
  # gift cards and the password page, which keep their original templates below.
  assign hb = false
  case request.page_type
    when 'index', 'product', 'cart', 'collection', 'list-collections', 'search', 'page', 'policy', '404'
      assign hb = true
  endcase
-%}
{% if hb %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#d8457f">
{%- capture hb_title -%}
  {%- case request.page_type -%}
    {%- when 'index' -%}SEVENCRUSH — LED masks, skin tools and collagen care
    {%- when 'product' -%}{% render 'hb-name', p: product %} — SEVENCRUSH
    {%- when 'cart' -%}Your bag — SEVENCRUSH
    {%- when 'collection' -%}{% if collection.handle == 'all' %}Shop all{% else %}{{ collection.title | escape }}{% endif %} — SEVENCRUSH
    {%- when 'search' -%}Search — SEVENCRUSH
    {%- when 'page' -%}{% if page.handle == 'contact' %}Help &amp; contact{% else %}{{ page.title | escape }}{% endif %} — SEVENCRUSH
    {%- when '404' -%}Page not found — SEVENCRUSH
    {%- else -%}{{ page_title | escape }} — SEVENCRUSH
  {%- endcase -%}
{%- endcapture -%}
<title>{{ hb_title }}</title>
{%- liquid
  if request.page_type == 'product'
    # Products whose description opens with a supplier spec dump or an internal label get a
    # written summary; every other product keeps its own description.
    case product.handle
      when 'home-use-led-face-neck-massager-7-colors-light-therapy-7-modes-3-levels-vibration-face-lifting-anti-wrinkle-beauty-instrument'
        assign hb_desc = 'A face and neck massager with seven LED colors, seven modes and three vibration levels on a curved 160° head. USB-C rechargeable. Free US shipping.'
      when 'new-booster-pro-led-facial-light-therapy-7-colors-eye-beauty-wand-red-light-eye-massager-for-skincare-blue-rejuvenation-tool'
        assign hb_desc = 'Booster Pro: a handheld LED facial wand in pink or black, with selectable light colors and a digital display. USB rechargeable. Free US shipping.'
      when 'korean-collagen-ampoule-serum-moisturizing-brightening-face-mask-gel-toner-cotton-pads-firming-gentle-and-non-irritating-skin-ca'
        assign hb_desc = 'Biodance gel toner pads and their matching ampoule, in pink Collagen or blue Cera-Nol. With the pads, the ampoule is free. Free US shipping.'
      else
        assign hb_desc = product.description | strip_html | strip_newlines | truncate: 155
    endcase
  elsif request.page_type == 'index'
    assign hb_desc = 'The LEZO 7-color LED mask, the Booster Pro wand and Biodance collagen pads and ampoules. Any two together are 20% off. Free US shipping.'
  else
    assign hb_desc = page_description | default: 'SEVENCRUSH: at-home LED and collagen skincare. Free US shipping.'
  endif
-%}
<meta name="description" content="{{ hb_desc | escape }}">
<link rel="canonical" href="{{ canonical_url }}">
<meta property="og:site_name" content="SEVENCRUSH"><meta property="og:title" content="{{ hb_title | strip_html | escape }}"><meta property="og:description" content="{{ hb_desc | escape }}"><meta property="og:url" content="{{ canonical_url }}">
{%- if request.page_type == 'product' and product.featured_image -%}<meta property="og:type" content="product"><meta property="og:image" content="https:{{ product.featured_image | image_url: width: 1200 }}">{%- else -%}<meta property="og:image" content="https://cdn.shopify.com/s/files/1/0833/3485/6923/files/lezo-hero-2026.webp?v=1792897033">{%- endif -%}
<link rel="icon" type="image/svg+xml" href="{{ 'lezo-favicon.svg' | asset_url }}">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800&family=Anton&family=Archivo:wght@400;500;600;700;800&family=Archivo+Black&family=Archivo+Narrow:wght@600;700&family=Inter+Tight:wght@400;500;600;700;800&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
{%- if request.page_type == 'index' -%}{{ 'sc-cover.css' | asset_url | stylesheet_tag }}{%- endif -%}
{{ 'sk.css' | asset_url | stylesheet_tag }}
{{ 'hb.css' | asset_url | stylesheet_tag }}
<style>@view-transition{navigation:auto}::view-transition-old(root),::view-transition-new(root){animation-duration:.38s;animation-timing-function:cubic-bezier(.16,1,.3,1)}::view-transition-group(*){animation-duration:.6s;animation-timing-function:cubic-bezier(.16,1,.3,1)}@media(prefers-reduced-motion:reduce){@view-transition{navigation:none}}</style>
<script src="{{ 'sk.js' | asset_url }}" defer></script>
{{ content_for_header }}
{%- if request.page_type == 'product' -%}<script type="application/ld+json">{{ product | structured_data }}</script>{%- endif -%}
</head>
<body class="hb-page{% if request.page_type == 'index' %} sk-home{% endif %}">
<a class="hb-skip" href="#MainContent">Skip to content</a>
{% render 'hb-header' %}
<main id="MainContent" tabindex="-1">
{%- case request.page_type -%}
  {%- when 'product' -%}{% if template.suffix contains 'promo' %}{{ content_for_layout }}{% else %}{% section 'sk-product' %}{% endif %}
  {%- when 'cart' -%}{% section 'hb-cart' %}
  {%- when 'collection', 'search', 'list-collections' -%}{% section 'hb-grid' %}
  {%- when 'page' -%}{% section 'hb-page' %}
  {%- when '404' -%}{% section 'hb-404' %}
  {%- when 'policy' -%}<div class="hb hb-wrap hb-policy">{{ content_for_layout }}</div>
  {%- else -%}{{ content_for_layout }}
{%- endcase -%}
</main>
{% section 'hb-footer' %}
{% render 'sk-cart-drawer' %}
</body>
</html>
{% elsif request.page_type == 'index' or product.handle == 'lezo-7-color-led-face-mask' or page.handle == 'lezo-delivery' or page.handle == 'lezo-returns' or request.page_type == 'cart' %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#ffffff">
<title>{% if request.page_type == 'index' %}{{ 'lezo.title' | t }}{% else %}{{ page_title | escape }} — LEZO{% endif %}</title>
<meta name="description" content="{{ 'lezo.description' | t | escape }}">
<link rel="canonical" href="{{ canonical_url }}">
<meta property="og:title" content="{{ page_title | escape }}"><meta property="og:description" content="{{ 'lezo.description' | t | escape }}"><meta property="og:image" content="https://cdn.shopify.com/s/files/1/0833/3485/6923/files/lezo-hero-2026.webp?v=1792897033">
<link rel="icon" type="image/svg+xml" href="{{ 'lezo-favicon.svg' | asset_url }}">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700;800&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
{{ 'lezo-studio.css' | asset_url | stylesheet_tag }}
{{ 'lezo-premium.css' | asset_url | stylesheet_tag }}
{%- if request.page_type == 'index' -%}{{ 'sk.css' | asset_url | stylesheet_tag }}{%- endif -%}
<script>window.LEZO_PX={turn:{{ 'lezo-turn.mp4' | asset_url | json }},poster:{{ 'lezo-turn-poster.webp' | asset_url | json }}};</script>
<script src="{{ 'lezo-studio.js' | asset_url }}" defer></script>
<script src="{{ 'lezo-premium.js' | asset_url }}" defer></script>
{%- if request.page_type == 'index' -%}<script src="{{ 'sk.js' | asset_url }}" defer></script>{%- endif -%}
{{ content_for_header }}
{% if request.page_type == 'product' %}<script type="application/ld+json">{{ product | structured_data }}</script>{% endif %}
</head><body{% if request.page_type == 'index' %} class="sk-home"{% endif %}>
{% if request.page_type == 'index' %}{{ content_for_layout }}{% section 'sk-footer' %}{% render 'sk-cart-drawer' %}{% else %}{% section 'lezo-experience' %}{% endif %}
</body></html>
{% else %}
{% liquid
  assign sevencrush_audio_page = false
  if request.page_type == 'index' or request.page_type == 'cart' or product.handle == 'sevencrush-the-everyday-earbuds'
    assign sevencrush_audio_page = true
  endif
%}
{% if sevencrush_audio_page %}
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ 'sevencrush_audio.copy.t001' | t }}</title>
<meta name="description" content="{{ 'sevencrush_audio.copy.t002' | t }}">
<meta name="theme-color" content="#ffffff"><meta property="og:title" content="{{ 'sevencrush_audio.copy.t001' | t }}"><meta property="og:description" content="{{ 'sevencrush_audio.copy.t003' | t }}">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' fill='white'/%3E%3Ctext x='16' y='47' font-size='48' font-family='Georgia' fill='black'%3E7%3C/text%3E%3C/svg%3E">
<link rel="preload" href="https://cdn.shopify.com/s/files/1/0833/3485/6923/files/sevencrish-earbuds-white-hero.png?v=1792357062" as="image"><link rel="stylesheet" href="{{ 'sevencrush-audio.css' | asset_url }}">
<script defer src="{{ 'sevencrush-audio.js' | asset_url }}"></script>

<link rel="canonical" href="{{ canonical_url }}">
{{ content_for_header }}
</head>
<body data-sevencrush-page="{{ request.page_type }}">
{% if request.page_type == 'index' %}
{{ content_for_layout }}
{% else %}
{% section 'sevencrush-audio' %}
{% endif %}
{% render 'sc-earbuds-extras' %}
</body></html>
{% else %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#e9e9e7">
<title>{% if request.page_type == 'index' %}Store 7 — Direct supplier contacts in China and Hong Kong{% else %}{{ page_title | escape }} | Store 7{% endif %}</title>
<meta name="description" content="{% if page.handle contains 'store7-' %}{{ page.content | strip_html | truncate: 160 | escape }}{% elsif request.page_type == 'index' %}12 supplier contacts in China and Hong Kong in one PDF, with WhatsApp links and a first message ready to send. The catalogs cover 200+ brands.{% else %}{{ 's7.meta.description' | t | escape }}{% endif %}">
<link rel="canonical" href="{{ canonical_url }}">
{% render 's7n-fonts' %}
{{ 'hanken-variable.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{{ 's7-new.css' | asset_url | stylesheet_tag }}
{{ 's7-editorial.css' | asset_url | stylesheet_tag }}
{{ 's7-poster.css' | asset_url | stylesheet_tag }}
<script src="{{ 's7-new.js' | asset_url }}" defer></script>
<script src="{{ 's7-editorial.js' | asset_url }}" defer></script>
<script src="{{ 's7-poster.js' | asset_url }}" defer></script>
{{ content_for_header }}
</head>
<body class="s7p{% if request.page_type == 'index' or page.handle == 'suppliers' %} s7e-home{% endif %}">
<a class="s7-skip" href="#MainContent">{{ 's7.nav.skip' | t }}</a>
<main id="MainContent" tabindex="-1">
{% if request.page_type == 'policy' %}
{% render 's7n-nav' %}
{{ content_for_layout }}
{% render 's7n-footer' %}
{% elsif request.page_type == 'index' or request.page_type == 'cart' or request.page_type == '404' %}
{{ content_for_layout }}
{% else %}
{% section 's7-experience' %}
{% endif %}
</main>
</body>
</html>


{% endif %}


{% endif %}
