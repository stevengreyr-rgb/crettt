<dialog class="bfx-lb" data-bfx-lb><button type="button" class="bfx-lb__x" data-bfx-lbx aria-label="Close">×</button><img alt="" data-bfx-lbimg></dialog>
</section>

<style>
.bfx{--ink:#f5f3f4;--mut:#a29ca0;--dim:#6e686c;--bg:#0b0a0b;--card:#151315;--card2:#1c191b;--line:#2a2629;--hot:#ff3b5c;--hot2:#ff7a59;--ok:#3ddc97;--grad:linear-gradient(135deg,#ff3b5c,#ff7a59);--ease:cubic-bezier(.16,1,.3,1);
  --f:"Inter Tight",system-ui,-apple-system,"Segoe UI",sans-serif;--fs:"Instrument Serif","Times New Roman",serif;
  background:var(--bg);color:var(--ink);font-family:var(--f);-webkit-font-smoothing:antialiased;padding-bottom:110px;overflow:clip}
.bfx--portal{--hot:#4f7cff;--hot2:#8b5cff;--grad:linear-gradient(135deg,#4f7cff,#8b5cff)}
.bfx *{box-sizing:border-box}
.bfx [hidden]{display:none!important}
.bfx-wrap{max-width:1200px;margin:0 auto;padding:0 18px}
.bfx-eye{display:flex;align-items:center;gap:8px;margin:0 0 10px;font:700 11px/1 var(--f);letter-spacing:.22em;text-transform:uppercase;color:var(--hot)}
.bfx-dot{width:7px;height:7px;border-radius:50%;background:var(--hot);box-shadow:0 0 0 0 var(--hot);animation:bfxPulse 1.8s infinite}
@keyframes bfxPulse{70%{box-shadow:0 0 0 9px transparent}100%{box-shadow:0 0 0 0 transparent}}
.bfx-h1{margin:0;font:800 clamp(40px,6.4vw,72px)/.92 var(--f);letter-spacing:-.045em}
.bfx-h1 em,.bfx-h2 em{font:italic 400 1.06em/1 var(--fs);letter-spacing:-.01em;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;padding-right:.06em}
.bfx-h2{margin:0 0 26px;font:800 clamp(30px,5vw,52px)/1 var(--f);letter-spacing:-.04em;text-wrap:balance}
.bfx-p,.bfx-lede{color:var(--mut);font-size:16px;line-height:1.55;margin:0}
.bfx-lede{margin-top:14px;max-width:46ch}
.bfx-sec{padding-top:clamp(80px,12vw,140px)}

/* Strip */
.bfx-strip{position:sticky;top:0;z-index:40;display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:6px 14px;padding:9px 14px;background:#000;border-bottom:1px solid var(--line);font-size:13px}
.bfx-strip__k{font-weight:800;letter-spacing:.22em;text-transform:uppercase;font-size:11px;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.bfx-strip__t{color:#d8d3d6}
@media(max-width:520px){.bfx-hide-s{display:none}}
.bfx-clock{display:inline-flex;align-items:baseline;gap:3px;font-variant-numeric:tabular-nums}
.bfx-clock b{display:inline-block;font-weight:800;min-width:1.7em;text-align:center;border-radius:6px;background:#ffffff14;padding:3px 4px}
.bfx-clock b.is-tick{animation:bfxFlip .5s var(--ease)}
@keyframes bfxFlip{0%{transform:rotateX(90deg);opacity:.2}100%{transform:none;opacity:1}}
.bfx-clock i{font-style:normal;color:var(--mut);font-size:11px;margin-right:4px}
.bfx-clock--l{gap:6px;margin:6px 0 22px}
.bfx-clock--l b{font-size:clamp(34px,7vw,64px);padding:10px 12px;border-radius:14px;background:var(--card2);border:1px solid var(--line);min-width:1.5em}
.bfx-clock--l i{font-size:12px;margin-right:10px;text-transform:uppercase;letter-spacing:.14em}
.bfx-over .bfx-clock{display:none}

/* Hero */
.bfx-hero{position:relative;padding:22px 0 10px;isolation:isolate}
.bfx-hero__bg{position:absolute;inset:0;z-index:-1;overflow:hidden}
.bfx-hero__bg i{position:absolute;width:60vmax;height:60vmax;border-radius:50%;filter:blur(90px);opacity:.33;background:var(--hot);top:-30vmax;left:-12vmax;animation:bfxDrift 18s ease-in-out infinite alternate}
.bfx-hero__bg i+i{background:var(--hot2);top:auto;bottom:-36vmax;left:auto;right:-20vmax;opacity:.22;animation-duration:24s}
@keyframes bfxDrift{to{transform:translate(8vmax,6vmax) scale(1.1)}}
.bfx-hero__grid{display:grid;gap:26px}
@media(min-width:960px){.bfx-hero__grid{grid-template-columns:1.05fr 1fr;gap:56px;align-items:start;padding-top:28px}.bfx-stage{position:sticky;top:64px}}
.bfx-stage{position:relative;min-width:0}
.bfx-stage__zoom{display:block;width:100%;padding:0;border:0;background:radial-gradient(80% 70% at 50% 40%,#fff,#ececef);border-radius:28px;aspect-ratio:1/1;overflow:hidden;cursor:zoom-in;border:1px solid var(--line);perspective:900px}
.bfx-stage__img{width:100%;height:100%;object-fit:contain;padding:4%;display:block;transition:transform .8s var(--ease),opacity .35s;mix-blend-mode:multiply;will-change:transform}
.bfx-stage__img.is-swap{opacity:0;transform:scale(.96)}
.bfx-burst{position:absolute;z-index:3;top:-10px;right:-6px;display:grid;place-items:center;width:104px;height:104px;border-radius:50%;background:var(--grad);color:#fff;text-align:center;transform:rotate(10deg);box-shadow:0 18px 40px -14px var(--hot);animation:bfxSpin 14s linear infinite}
.bfx-burst b{font:800 28px/1 var(--f);letter-spacing:-.04em;display:block}
.bfx-burst small{display:block;font:700 9px/1 var(--f);letter-spacing:.16em;text-transform:uppercase;margin-top:-18px}
@keyframes bfxSpin{0%,100%{transform:rotate(10deg)}50%{transform:rotate(-6deg) scale(1.04)}}
.bfx-film{display:flex;gap:8px;overflow-x:auto;padding:12px 2px 2px;scrollbar-width:none}
.bfx-film::-webkit-scrollbar{display:none}
.bfx-film__b{flex:0 0 66px;height:66px;border-radius:14px;border:1.5px solid var(--line);background:var(--card);padding:4px;cursor:pointer;opacity:.55;transition:opacity .25s,border-color .25s,transform .3s var(--ease)}
.bfx-film__b img{width:100%;height:100%;object-fit:contain;display:block}
.bfx-film__b:hover{opacity:.9}
.bfx-film__b.is-on{opacity:1;border-color:var(--ink);transform:translateY(-2px)}

.bfx-price{display:flex;align-items:flex-end;gap:14px;margin:22px 0 4px;flex-wrap:wrap}
.bfx-price__now{font:800 clamp(46px,8vw,68px)/.9 var(--f);letter-spacing:-.05em;font-variant-numeric:tabular-nums}
.bfx-price__side{display:flex;flex-direction:column;gap:6px;padding-bottom:4px}
.bfx-price__side s{color:var(--dim);font-size:18px;font-weight:600;font-variant-numeric:tabular-nums}
.bfx-save{display:inline-block;padding:5px 10px;border-radius:99px;background:#3ddc9722;color:var(--ok);font-size:13px;font-weight:700}
.bfx-terms{font-size:13px;color:var(--mut);min-height:6px;margin-top:8px}
.bfx-terms *{color:inherit!important}

.bfx-pick{border:0;margin:20px 0 0;padding:0;min-width:0}
.bfx-pick legend{display:flex;justify-content:space-between;gap:10px;width:100%;padding:0;margin-bottom:10px;font-weight:700;font-size:14px}
.bfx-pick legend span{color:var(--mut);font-weight:500}
.bfx-opts{display:grid;gap:8px}
.bfx-opt{position:relative;display:grid;grid-template-columns:52px 1fr auto;align-items:center;gap:12px;width:100%;padding:8px 14px 8px 8px;border-radius:18px;border:1.5px solid var(--line);background:var(--card);color:var(--ink);font:inherit;text-align:left;cursor:pointer;transition:border-color .25s,background .25s,transform .2s var(--ease);-webkit-tap-highlight-color:transparent}
.bfx-opt:hover{border-color:#4a4447}
.bfx-opt:active{transform:scale(.985)}
.bfx-opt:focus-visible{outline:2px solid var(--hot);outline-offset:2px}
.bfx-opt[aria-checked=true]{border-color:var(--hot);background:linear-gradient(var(--card2),var(--card2)) padding-box,var(--grad) border-box;border-color:transparent;box-shadow:0 14px 34px -22px var(--hot)}
.bfx-opt__img{width:52px;height:52px;border-radius:12px;background:#ffffff0d;overflow:hidden}
.bfx-opt__img img{width:100%;height:100%;object-fit:contain}
.bfx-opt__t{display:flex;flex-direction:column;gap:2px;min-width:0}
.bfx-opt__t b{font-size:15px}
.bfx-opt__t small{font-size:12px;color:var(--mut)}
.bfx-opt__t b::before{content:"";display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:7px;background:var(--sw,#888);box-shadow:inset 0 0 0 1px #ffffff40;vertical-align:1px}
.bfx-opt__p{display:flex;flex-direction:column;align-items:flex-end;gap:2px;font-variant-numeric:tabular-nums}
.bfx-opt__p b{font-size:15px}
.bfx-opt__p s{font-size:12px;color:var(--dim)}
.bfx-opt[data-soldout]{opacity:.45}
.bfx-opt__so{position:absolute;top:6px;right:10px;font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--mut)}

.bfx-stock{display:flex;align-items:center;gap:10px;margin:14px 0 0;font-size:13px;color:#ffc9a8}
.bfx-stock__bar{flex:0 0 90px;height:6px;border-radius:9px;background:#ffffff14;overflow:hidden}
.bfx-stock__bar i{display:block;height:100%;background:var(--grad);border-radius:inherit;transition:width .8s var(--ease)}

.bfx-ctas{display:grid;grid-template-columns:1fr auto;gap:8px;margin-top:18px}
.bfx-cta{position:relative;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:19px 24px;border:0;border-radius:99px;background:var(--grad);color:#fff;font:800 16px/1 var(--f);text-decoration:none;cursor:pointer;overflow:hidden;box-shadow:0 18px 40px -18px var(--hot);transition:transform .25s var(--ease),box-shadow .25s,filter .2s}
.bfx-cta::after{content:"";position:absolute;inset:0;background:linear-gradient(110deg,transparent 30%,#ffffff55 50%,transparent 70%);transform:translateX(-120%);animation:bfxShine 3.6s 1.2s infinite}
@keyframes bfxShine{40%,100%{transform:translateX(120%)}}
.bfx-cta:hover{transform:translateY(-2px);box-shadow:0 22px 46px -18px var(--hot)}
.bfx-cta:active{transform:scale(.97)}
.bfx-cta[disabled]{opacity:.4;cursor:not-allowed;transform:none}
.bfx-cta--ghost{background:transparent;border:1.5px solid #ffffff38;box-shadow:none}
.bfx-cta--ghost::after{content:none}
.bfx-cta--sm{padding:13px 18px;font-size:14px}
.bfx-cta--inline{padding:20px 40px;font-size:17px}
.bfx-cta.is-busy .bfx-cta__t{opacity:.5}
.bfx-cta.is-done{background:var(--ok);color:#06200f}
.bfx-eta{margin:12px 0 0;text-align:center;font-size:13px;color:var(--mut)}
.bfx-eta b{color:var(--ink)}
.bfx-trust{list-style:none;margin:18px 0 0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:8px}
.bfx-trust li{display:flex;align-items:center;gap:8px;padding:11px 12px;border-radius:14px;background:#ffffff08;border:1px solid var(--line);font-size:12.5px;color:#d8d3d6}
.bfx-trust svg{flex:none;width:18px;height:18px;fill:none;stroke:var(--hot);stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}

/* Receipt */
.bfx-split{display:grid;gap:30px}
@media(min-width:900px){.bfx-split{grid-template-columns:1fr 1fr;gap:64px;align-items:center}}
.bfx-rcpt{position:relative;padding:26px 24px 30px;background:#f6f3ee;color:#1b1718;border-radius:6px;font:500 14px/1.4 ui-monospace,"SF Mono",Menlo,monospace;box-shadow:0 40px 80px -40px #000;transform:rotate(-1.2deg);
  -webkit-mask:radial-gradient(circle 7px at 50% 100%,transparent 98%,#000) 0 0/18px 100% repeat-x;mask:radial-gradient(circle 7px at 50% 100%,transparent 98%,#000) 0 0/18px 100% repeat-x}
.bfx-rcpt__h{margin:0 0 14px;padding-bottom:12px;border-bottom:1.5px dashed #c9c2b8;text-align:center;font-weight:700;letter-spacing:.12em;text-transform:uppercase;font-size:12px}
.bfx-rcpt__r{display:flex;justify-content:space-between;gap:16px;padding:7px 0;font-variant-numeric:tabular-nums}
.bfx-rcpt__r span:first-child{min-width:0}
.bfx-rcpt__r.is-off{color:#c4213e}
.bfx--portal .bfx-rcpt__r.is-off{color:#3a5bd9}
.bfx-rcpt__r.is-tot{margin-top:8px;padding-top:12px;border-top:1.5px dashed #c9c2b8;font-weight:800;font-size:20px}
.bfx-rcpt__f{margin:12px 0 0;font-size:11px;color:#8b847b;text-align:center}
.bfx-rcpt .is-tick{animation:bfxPop .5s var(--ease)}
@keyframes bfxPop{40%{transform:scale(1.08)}}

/* Quiz */
.bfx-quiz{max-width:760px}
.bfx-q{padding:26px;border-radius:24px;background:var(--card);border:1px solid var(--line);animation:bfxIn .5s var(--ease)}
@keyframes bfxIn{from{opacity:0;transform:translateY(12px)}}
.bfx-q__h{margin:0 0 16px;font:700 20px/1.25 var(--f);letter-spacing:-.02em}
.bfx-q__h span{display:inline-block;margin-right:10px;padding:4px 8px;border-radius:8px;background:#ffffff12;color:var(--mut);font-size:12px;vertical-align:3px}
.bfx-q p{color:var(--mut);line-height:1.55}
.bfx-q__a{display:flex;flex-wrap:wrap;gap:8px}
.bfx-q__a button{padding:14px 18px;border-radius:99px;border:1.5px solid var(--line);background:#ffffff08;color:var(--ink);font:600 15px/1 var(--f);cursor:pointer;transition:border-color .2s,background .2s,transform .2s var(--ease)}
.bfx-q__a button:hover{border-color:var(--hot);background:#ffffff10}
.bfx-q__a button:active{transform:scale(.96)}
.bfx-q--warn{border-color:#ffb02e55;background:linear-gradient(#2a2010,#1a160f)}
.bfx-q--warn .bfx-q__h{color:#ffc65c}
.bfx-q--ok{border-color:transparent;background:linear-gradient(var(--card2),var(--card2)) padding-box,var(--grad) border-box;border:1.5px solid transparent}
.bfx-q--ok b{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}

/* Compare */
.bfx-cmp{border:1px solid var(--line);border-radius:24px;overflow:hidden;background:var(--card)}
.bfx-cmp__r{display:grid;grid-template-columns:minmax(120px,1.3fr) repeat(var(--n),1fr);align-items:center;border-top:1px solid var(--line)}
.bfx-cmp__r:first-child{border-top:0}
.bfx-cmp__r>span{padding:14px 10px;font-size:13.5px}
.bfx-cmp__r>span:first-child{color:var(--mut);padding-left:18px}
.bfx-cmp__col{text-align:center;display:flex;flex-direction:column;align-items:center;gap:6px;height:100%;justify-content:center;transition:background .3s}
.bfx-cmp__col.is-on{background:#ffffff0c}
.bfx-cmp__head .bfx-cmp__col img{width:min(110px,100%);aspect-ratio:1;object-fit:contain}
.bfx-cmp__head b{font-size:13px;line-height:1.2}
.bfx-cmp__head .bfx-cmp__col.is-on b{color:var(--hot)}
.bfx-yes,.bfx-no{display:inline-grid;place-items:center;width:24px;height:24px;border-radius:50%}
.bfx-yes{background:#3ddc9722}
.bfx-yes::before{content:"";width:9px;height:5px;border:2px solid var(--ok);border-top:0;border-right:0;transform:rotate(-45deg) translate(1px,-1px)}
.bfx-no::before{content:"";width:10px;height:2px;border-radius:2px;background:var(--dim)}
.bfx-cmp__price b{font-size:17px;font-variant-numeric:tabular-nums}
.bfx-cmp__price s{font-size:12px;color:var(--dim)}
.bfx-cmp__btn{margin-top:4px;padding:9px 14px;border-radius:99px;border:1.5px solid var(--line);background:transparent;color:var(--ink);font:700 12px/1 var(--f);cursor:pointer}
.bfx-cmp__col.is-on .bfx-cmp__btn{background:var(--grad);border-color:transparent;color:#fff}
.bfx-cmp__btn[disabled]{opacity:.4;cursor:not-allowed}
@media(max-width:600px){.bfx-cmp__r{grid-template-columns:96px repeat(var(--n),1fr)}.bfx-cmp__r>span{padding:12px 4px;font-size:12px}.bfx-cmp__r>span:first-child{padding-left:12px}.bfx-cmp__head b{font-size:11px}.bfx-cmp__price b{font-size:14px}}

/* Bento */
.bfx-bento{display:grid;gap:10px;grid-template-columns:1fr 1fr}
.bfx-tile{position:relative;display:flex;flex-direction:column;justify-content:flex-end;gap:8px;min-height:150px;padding:20px;border-radius:24px;background:var(--card);border:1px solid var(--line);overflow:hidden;transition:transform .4s var(--ease),border-color .3s}
.bfx-tile:hover{transform:translateY(-3px);border-color:#3a3437}
.bfx-tile span{font-size:13.5px;line-height:1.45;color:var(--mut)}
.bfx-tile--xl{grid-column:1/-1;min-height:220px;background:radial-gradient(90% 90% at 100% 0%,color-mix(in srgb,var(--hot) 35%,transparent),transparent 60%),var(--card)}
.bfx-tile:last-child{grid-column:1/-1;min-height:120px}
@media(min-width:900px){.bfx-bento{grid-template-columns:repeat(4,1fr)}.bfx-tile--xl{grid-column:span 2;grid-row:span 2}}
.bfx-big{font:800 clamp(80px,14vw,150px)/.8 var(--f);letter-spacing:-.06em;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.bfx-mid{font:800 clamp(22px,3vw,30px)/1 var(--f);letter-spacing:-.03em}

/* Steps */
.bfx-steps{list-style:none;margin:0;padding:0;display:grid;gap:10px;counter-reset:s}
@media(min-width:900px){.bfx-steps{grid-template-columns:repeat(5,1fr)}}
.bfx-steps li{counter-increment:s;position:relative;display:flex;flex-direction:column;gap:6px;padding:22px 18px 20px;border-radius:22px;background:var(--card);border:1px solid var(--line)}
.bfx-steps li::before{content:counter(s,decimal-leading-zero);font:italic 400 34px/1 var(--fs);color:var(--hot);margin-bottom:8px}
.bfx-steps b{font-size:16px}
.bfx-steps span{font-size:13.5px;color:var(--mut);line-height:1.45}

/* Checks + FAQ */
.bfx-checks{list-style:none;margin:0;padding:0;display:grid;gap:10px}
.bfx-checks li{position:relative;padding:14px 16px 14px 46px;border-radius:16px;background:#ffffff07;border:1px solid var(--line);font-size:14.5px;line-height:1.45;color:#d8d3d6}
.bfx-checks li::before{content:"!";position:absolute;left:14px;top:13px;width:20px;height:20px;border-radius:50%;display:grid;place-items:center;background:#ffb02e22;color:#ffc65c;font-weight:800;font-size:12px}
.bfx-faq__s{display:flex;align-items:center;gap:10px;padding:0 16px;border-radius:99px;background:var(--card);border:1px solid var(--line);margin-bottom:8px}
.bfx-faq__s svg{width:18px;height:18px;fill:none;stroke:var(--mut);stroke-width:1.8;stroke-linecap:round}
.bfx-faq__s input{flex:1;min-width:0;padding:15px 0;border:0;background:transparent;color:var(--ink);font:500 15px var(--f);outline:0}
.bfx-faq details{border-bottom:1px solid var(--line)}
.bfx-faq summary{display:flex;justify-content:space-between;gap:12px;padding:18px 2px;cursor:pointer;list-style:none;font-weight:700;font-size:15.5px}
.bfx-faq summary::-webkit-details-marker{display:none}
.bfx-faq summary::after{content:"";flex:none;width:12px;height:12px;margin-top:4px;background:linear-gradient(var(--hot),var(--hot)) center/12px 2px no-repeat,linear-gradient(var(--hot),var(--hot)) center/2px 12px no-repeat;transition:transform .35s var(--ease)}
.bfx-faq details[open] summary::after{transform:rotate(135deg)}
.bfx-faq p{margin:0 0 18px;color:var(--mut);line-height:1.6;font-size:14.5px}
.bfx-faq__none{color:var(--mut);font-size:14px;padding:12px 2px}
.bfx-faq mark{background:color-mix(in srgb,var(--hot) 40%,transparent);color:inherit;border-radius:3px}

/* End */
.bfx-end{margin-top:clamp(80px,12vw,140px);padding:clamp(60px,9vw,110px) 0;text-align:center;background:radial-gradient(60% 80% at 50% 0%,color-mix(in srgb,var(--hot) 30%,transparent),transparent 70%),#000;border-block:1px solid var(--line)}
.bfx-end__in{display:flex;flex-direction:column;align-items:center}
.bfx-end .bfx-eye{justify-content:center}
.bfx-legal{margin-top:30px;font-size:12px;line-height:1.5;color:var(--dim)}

/* Sticky bar */
.bfx-bar{position:fixed;left:10px;right:10px;bottom:calc(10px + env(safe-area-inset-bottom));z-index:60;display:flex;align-items:center;gap:10px;padding:8px 8px 8px 8px;border-radius:22px;background:#151315ee;backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border:1px solid var(--line);box-shadow:0 20px 50px -14px #000;transform:translateY(150%);transition:transform .5s var(--ease)}
.bfx-bar.is-on{transform:none}
.bfx-bar__img{flex:0 0 44px;height:44px;border-radius:12px;background:#ffffff10;overflow:hidden}
.bfx-bar__img img{width:100%;height:100%;object-fit:contain}
.bfx-bar__t{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px}
.bfx-bar__t b{font-size:13.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bfx-bar__t small{font-size:12px;color:var(--mut);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bfx-bar__t s{color:var(--dim)}
@media(min-width:900px){.bfx-bar{left:50%;right:auto;width:560px;transform:translate(-50%,150%)}.bfx-bar.is-on{transform:translate(-50%,0)}}

.bfx-toast{position:fixed;left:50%;top:58px;z-index:70;transform:translate(-50%,-20px);opacity:0;pointer-events:none;padding:12px 18px;border-radius:99px;background:var(--ok);color:#06200f;font-weight:800;font-size:14px;box-shadow:0 14px 30px -10px #0009;transition:opacity .3s,transform .4s var(--ease)}
.bfx-toast.is-on{opacity:1;transform:translate(-50%,0)}
.bfx-toast.is-err{background:#ff5c5c;color:#fff}

.bfx-lb{width:min(96vw,1000px);max-height:92vh;padding:0;border:0;border-radius:24px;background:#111;overflow:hidden}
.bfx-lb::backdrop{background:#000c;backdrop-filter:blur(6px)}
.bfx-lb img{display:block;width:100%;height:auto;max-height:92vh;object-fit:contain}
.bfx-lb__x{position:absolute;top:12px;right:12px;width:44px;height:44px;border-radius:50%;border:0;background:#fffe;color:#000;font-size:24px;cursor:pointer}

/* Reveal */
.bfx-js [data-bfx-rv]{opacity:0;transform:translateY(34px);transition:opacity 1s var(--ease),transform 1.2s var(--ease)}
.bfx-js [data-bfx-rv].is-in{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){.bfx *,.bfx *::before,.bfx *::after{animation:none!important;transition:none!important}.bfx-js [data-bfx-rv]{opacity:1;transform:none}}
</style>

<script>
(() => {
  const root = document.querySelector('[data-bfx]');
  if (!root) return;
  const $ = (q, el = root) => el.querySelector(q), $$ = (q, el = root) => [...el.querySelectorAll(q)];
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const V = JSON.parse($('[data-bfx-json]').textContent);
  const fmt = (c) => '$' + (c / 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  const low = +root.dataset.low || 10;
  const byId = (id) => V.find((v) => v.id == id);
  let cur = byId($('[data-bfx-id]').value) || V[0];

  // Labels and swatches on the option buttons come from the variant data
  $$('.bfx-opt').forEach((b) => { const v = byId(b.dataset.vid); if (!v) return; $('[data-bfx-lab]', b).textContent = v.label; $('[data-bfx-sub]', b).textContent = v.sub; b.style.setProperty('--sw', v.sw); });
  $$('[data-bfx-lab-of]').forEach((b) => { const v = byId(b.dataset.bfxLabOf); if (v) b.textContent = v.label; });

  // Reveal on scroll
  if (!calm && 'IntersectionObserver' in window) {
    root.classList.add('bfx-js');
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -10% 0px' });
    $$('[data-bfx-rv]').forEach((el) => io.observe(el));
  }

  // Price count (from the original price down to the sale price)
  const roll = (el, from, to, ms = 900) => {
    if (!el) return;
    if (calm || from === to) { el.textContent = fmt(to); return; }
    const t0 = performance.now();
    const step = (t) => { const k = Math.min(1, (t - t0) / ms), e = 1 - Math.pow(1 - k, 4); el.textContent = fmt(Math.round(from + (to - from) * e)); if (k < 1) requestAnimationFrame(step); };
    requestAnimationFrame(step);
  };
  const tick = (el) => { if (!el || calm) return; el.classList.remove('is-tick'); void el.offsetWidth; el.classList.add('is-tick'); };

  // Hero photo
  const hero = $('[data-bfx-hero]');
  const film = $$('.bfx-film__b');
  const showImg = (src, mediaId) => {
    if (hero && src) {
      if (hero.getAttribute('src') !== src) { hero.classList.add('is-swap'); setTimeout(() => { hero.removeAttribute('srcset'); hero.src = src; hero.onload = () => hero.classList.remove('is-swap'); setTimeout(() => hero.classList.remove('is-swap'), 400); }, 160); }
    }
    film.forEach((b) => b.classList.toggle('is-on', mediaId ? b.dataset.media == mediaId : b.dataset.src === src));
  };
  film.forEach((b) => b.addEventListener('click', () => showImg(b.dataset.src, b.dataset.media)));

  // Pointer tilt on the hero photo
  const stage = $('[data-bfx-stage]');
  if (hero && stage && !calm && matchMedia('(hover: hover)').matches) {
    stage.addEventListener('pointermove', (e) => { const r = stage.getBoundingClientRect(); const x = (e.clientX - r.left) / r.width - .5, y = (e.clientY - r.top) / r.height - .5; hero.style.transform = `rotateY(${x * 10}deg) rotateX(${-y * 8}deg) scale(1.03)`; });
    stage.addEventListener('pointerleave', () => { hero.style.transform = ''; });
  }

  // Lightbox
  const lb = $('[data-bfx-lb]');
  $('[data-bfx-zoom]')?.addEventListener('click', () => { if (!lb?.showModal || !hero) return; $('[data-bfx-lbimg]', lb).src = hero.currentSrc || hero.src; lb.showModal(); });
  lb?.addEventListener('click', (e) => { if (e.target === lb || e.target.closest('[data-bfx-lbx]')) lb.close(); });

  // Select a variant: everything on the page follows
  function select(id, { scrollPhoto = true, animate = true } = {}) {
    const v = byId(id); if (!v) return;
    const prev = cur; cur = v;
    $('[data-bfx-id]').value = v.id;
    $$('.bfx-opt').forEach((b) => { const on = b.dataset.vid == v.id; b.setAttribute('aria-checked', on); b.tabIndex = on ? 0 : -1; });
    $$('.bfx-cmp__col').forEach((c) => c.classList.toggle('is-on', c.dataset.vid == v.id));
    $('[data-bfx-picked]').textContent = v.label;
    const off = v.was > v.price;
    animate ? roll($('[data-bfx-now]'), prev.price, v.price, 600) : ($('[data-bfx-now]').textContent = fmt(v.price));
    const was = $('[data-bfx-was]'); was.hidden = !off; was.textContent = fmt(v.was);
    const save = $('[data-bfx-save]'); save.hidden = !off; save.textContent = 'You save ' + fmt(v.was - v.price);
    $('[data-bfx-addt]').textContent = (v.available ? 'Add to bag · ' : 'Sold out · ') + fmt(v.price);
    $$('[data-bfx-add],[data-bfx-buy],[data-bfx-baradd]').forEach((b) => b.disabled = !v.available);
    // receipt
    const rn = $('[data-bfx-rname]'); if (rn) rn.textContent = v.title;
    const rw = $('[data-bfx-rwas]'); if (rw) { rw.textContent = fmt(off ? v.was : v.price); tick(rw); }
    const ro = $('[data-bfx-roff]'); if (ro) { ro.textContent = '−' + fmt(off ? v.was - v.price : 0); tick(ro); }
    const rp = $('[data-bfx-rnow]'); if (rp) { rp.textContent = fmt(v.price); tick(rp); }
    $('[data-bfx-endp]').textContent = fmt(v.price);
    // sticky bar
    $('[data-bfx-barv]').textContent = v.label; $('[data-bfx-barp]').textContent = fmt(v.price);
    const bw = $('[data-bfx-barwas]'); bw.hidden = !off; bw.textContent = fmt(v.was);
    if (v.img) $('[data-bfx-barimg]').src = v.img;
    // honest low-stock line: only when Shopify tracks stock and it is low
    const st = $('[data-bfx-stock]');
    if (v.qty != null && v.qty > 0 && v.qty <= low) { st.hidden = false; $('[data-bfx-stocktxt]').textContent = 'Only ' + v.qty + ' left at this price'; $('[data-bfx-stockbar]').style.width = Math.max(8, (v.qty / low) * 100) + '%'; }
    else st.hidden = true;
    if (scrollPhoto) showImg(v.img, v.media);
    if (location.pathname.includes('/products/')) history.replaceState(null, '', '?variant=' + v.id);
  }
  const opts = $('[data-bfx-opts]');
  opts.addEventListener('click', (e) => { const b = e.target.closest('.bfx-opt'); if (b) select(b.dataset.vid); });
  opts.addEventListener('keydown', (e) => {
    const bs = $$('.bfx-opt', opts), i = bs.findIndex((b) => b.dataset.vid == cur.id);
    const d = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[e.key]; if (!d) return;
    e.preventDefault(); const n = bs[(i + d + bs.length) % bs.length]; select(n.dataset.vid); n.focus();
  });
  $$('[data-choose]').forEach((b) => b.addEventListener('click', () => { select(b.dataset.choose); goForm(); }));
  const goForm = () => { const f = $('#bfx-form') || $('[data-bfx-form]'); f?.scrollIntoView({ behavior: calm ? 'auto' : 'smooth', block: 'center' }); };
  $$('[data-bfx-go]').forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); goForm(); }));

  // First paint: price counts down from the original price
  select(cur.id, { scrollPhoto: false, animate: false });
  if (cur.was > cur.price) roll($('[data-bfx-now]'), cur.was, cur.price, 1400);

  // Add to bag without leaving the page; opens the theme's cart drawer when there is one
  const toast = $('[data-bfx-toast]');
  const say = (msg, err) => { toast.textContent = msg; toast.classList.toggle('is-err', !!err); toast.classList.add('is-on'); clearTimeout(say.t); say.t = setTimeout(() => toast.classList.remove('is-on'), 2600); };
  const form = $('[data-bfx-form]');
  const addBtn = $('[data-bfx-add]');
  async function add(btn) {
    btn.classList.add('is-busy'); btn.disabled = true;
    try {
      const r = await fetch((window.Shopify?.routes?.root || '/') + 'cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ items: [{ id: cur.id, quantity: 1 }] }) });
      const j = await r.json(); if (!r.ok) throw new Error(j.description || j.message || 'Could not add');
      btn.classList.add('is-done'); say('Added to your bag ✓');
      document.dispatchEvent(new CustomEvent('sk:cart'));
      const o = document.createElement('a'); o.setAttribute('data-sk-cart-open', ''); o.href = '/cart'; o.hidden = true; document.body.append(o);
      if (document.getElementById('sk-cart')) o.click(); o.remove();
      setTimeout(() => btn.classList.remove('is-done'), 1800);
    } catch (err) { say(err.message, true); }
    finally { btn.classList.remove('is-busy'); btn.disabled = !cur.available; }
  }
  form.addEventListener('submit', (e) => { if (e.submitter && e.submitter.hasAttribute('data-bfx-buy')) return; e.preventDefault(); add(addBtn); });
  $('[data-bfx-baradd]').addEventListener('click', (e) => add(e.currentTarget));

  // Sticky bar after the main button scrolls away
  const bar = $('[data-bfx-bar]');
  if ('IntersectionObserver' in window) new IntersectionObserver(([e]) => { const on = !e.isIntersecting && e.boundingClientRect.top < 0; bar.classList.toggle('is-on', on); bar.setAttribute('aria-hidden', !on); $('[data-bfx-baradd]').tabIndex = on ? 0 : -1; }).observe(addBtn);

  // Delivery dates
  const eta = $('[data-bfx-eta]');
  const day = (n) => { const d = new Date(); d.setDate(d.getDate() + n); return d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }); };
  eta.innerHTML = 'Free tracked shipping · arrives <b>' + day(5) + ' – ' + day(12) + '</b>';

  // Countdown
  const end = Date.parse(root.dataset.end);
  const clocks = $$('[data-bfx-clock]');
  if (end) {
    const set = (u, n) => clocks.forEach((c) => { const b = c.querySelector('[data-u="' + u + '"]'); const t = String(n).padStart(2, '0'); if (b && b.textContent !== t) { b.textContent = t; tick(b); } });
    const run = () => {
      let s = Math.max(0, Math.floor((end - Date.now()) / 1000));
      if (!s) { root.classList.add('bfx-over'); clearInterval(iv); return; }
      set('d', Math.floor(s / 86400)); s %= 86400; set('h', Math.floor(s / 3600)); s %= 3600; set('m', Math.floor(s / 60)); set('s', s % 60);
    };
    const iv = setInterval(run, 1000); run();
  }

  // Quiz
  const quiz = $('[data-bfx-quiz]');
  if (quiz) {
    const show = (q) => $$('.bfx-q', quiz).forEach((el) => el.hidden = el.dataset.q !== q);
    const pickBy = (key) => V.find((v) => { const t = v.title.toLowerCase(); if (key === 'console' || key === 'white') return !/mario|pok|black|30/.test(t); return t.includes(key); }) || V[0];
    quiz.addEventListener('click', (e) => {
      const b = e.target.closest('button'); if (!b) return;
      if (b.hasAttribute('data-reset')) return show('1');
      if (b.dataset.a === 'yes') return show('2');
      if (b.dataset.a === 'no') return show('no');
      if (b.dataset.pick) {
        const v = pickBy(b.dataset.pick); select(v.id);
        $('[data-bfx-qres]', quiz).textContent = v.label;
        $('[data-bfx-qprice]', quiz).textContent = fmt(v.price) + (v.was > v.price ? ' instead of ' + fmt(v.was) + '. It is now selected above.' : '. It is now selected above.');
        show('done');
      }
    });
  }

  // FAQ search
  const qs = $('[data-bfx-faqs]');
  if (qs) qs.addEventListener('input', () => {
    const q = qs.value.trim().toLowerCase(); let any = false;
    $$('[data-bfx-faq] details').forEach((d) => { const hit = !q || d.textContent.toLowerCase().includes(q); d.hidden = !hit; if (hit) any = true; if (q && hit) d.open = true; if (!q) d.open = false; });
    $('[data-bfx-faqnone]').hidden = any;
  });
})();
</script>

{% schema %}
{
  "name": "Black Friday console",
  "settings": [
    {"type": "select", "id": "kind", "label": "Product", "default": "switch2", "options": [{"value": "switch2", "label": "Nintendo Switch 2"}, {"value": "portal", "label": "PlayStation Portal"}]},
    {"type": "text", "id": "handle", "label": "Product handle (used outside product pages)", "default": "nintendo-switch-2-black-friday"},
    {"type": "text", "id": "ends", "label": "Sale ends (ISO date)", "default": "2026-11-30T23:59:00-05:00"},
    {"type": "number", "id": "low_stock", "label": "Show 'Only N left' at or below", "default": 10}
  ],
  "presets": [{"name": "Black Friday console"}]
}
{% endschema %}
