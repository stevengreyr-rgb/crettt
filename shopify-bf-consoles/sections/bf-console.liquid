{%- comment -%}
  Black Friday console landing (Nintendo Switch 2 / PlayStation Portal).
  One section, two products: the "kind" setting picks the copy. Prices, variants, photos and stock come
  from the Shopify product: price = Black Friday price, compare-at price = original price.
  Own look (dark Black Friday), scoped under .bfx; does not depend on the Glow Ritual styles.
{%- endcomment -%}
{%- liquid
  assign k = section.settings.kind
  assign p = product | default: all_products[section.settings.handle]
  assign cur = p.selected_or_first_available_variant
  assign low = section.settings.low_stock | default: 10
  assign off_pct = 0
  if cur.compare_at_price > cur.price
    assign off_pct = cur.compare_at_price | minus: cur.price | times: 100 | divided_by: cur.compare_at_price | round
  endif
  if k == 'portal'
    assign name_a = 'PlayStation'
    assign name_b = 'Portal'
    assign pick_word = 'finish'
    assign thing = 'remote player'
  else
    assign name_a = 'Nintendo Switch'
    assign name_b = '2'
    assign pick_word = 'edition'
    assign thing = 'console'
  endif
-%}
<section class="bfx bfx--{{ k }}" data-bfx data-kind="{{ k }}" data-low="{{ low }}" data-end="{{ section.settings.ends | escape }}">
<script type="application/json" data-bfx-json>[
{%- for v in p.variants -%}
  {%- liquid
    assign vd = v.title | downcase
    if k == 'portal'
      assign lab = 'White'
      assign sub = 'The original'
      assign sw = '#f2f2f4'
      if vd contains '30'
        assign lab = '30th Anniversary'
        assign sub = 'Limited · PS1 gray'
        assign sw = '#a9a9b2'
      elsif vd contains 'black'
        assign lab = 'Midnight Black'
        assign sub = 'All black'
        assign sw = '#1c1d22'
      endif
    else
      assign lab = 'Console'
      assign sub = 'Console only'
      assign sw = '#2a2a30'
      if vd contains 'mario'
        assign lab = '+ Mario Kart World'
        assign sub = 'Game as download code'
        assign sw = '#e60012'
      elsif vd contains 'pok'
        assign lab = '+ Pokémon Legends: Z-A'
        assign sub = 'Game as download code'
        assign sw = '#2a6fdb'
      endif
    endif
    assign vimg = v.featured_image | default: p.featured_image
  -%}
  {"id":{{ v.id }},"title":{{ v.title | json }},"label":{{ lab | json }},"sub":{{ sub | json }},"sw":{{ sw | json }},"price":{{ v.price }},"was":{{ v.compare_at_price | default: 0 }},"available":{{ v.available }},"qty":{% if v.inventory_management == 'shopify' and v.inventory_policy == 'deny' %}{{ v.inventory_quantity }}{% else %}null{% endif %},"media":{{ v.featured_media.id | default: 0 }},"img":{% if vimg %}{{ vimg | image_url: width: 1400 | json }}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]</script>

{%- comment -%} ───────────── 1. Countdown strip ───────────── {%- endcomment -%}
<div class="bfx-strip" data-bfx-strip>
  <span class="bfx-strip__k">Black Friday</span>
  <span class="bfx-strip__t">{{ off_pct | default: 30 }}% off every {{ pick_word }}<span class="bfx-hide-s"> · free US shipping</span></span>
  <span class="bfx-clock bfx-clock--s" data-bfx-clock aria-label="Time left in the sale"><b data-u="d">00</b><i>d</i><b data-u="h">00</b><i>h</i><b data-u="m">00</b><i>m</i><b data-u="s">00</b><i>s</i></span>
</div>

{%- comment -%} ───────────── 2. Hero + buy box ───────────── {%- endcomment -%}
<div class="bfx-hero">
  <div class="bfx-hero__bg" aria-hidden="true"><i></i><i></i></div>
  <div class="bfx-wrap bfx-hero__grid">

    <div class="bfx-stage" data-bfx-stage>
      <span class="bfx-burst" aria-hidden="true"><b>-{{ off_pct | default: 30 }}%</b><small>Black Friday</small></span>
      <button type="button" class="bfx-stage__zoom" data-bfx-zoom aria-label="Open photo full screen">
        {%- assign hero_img = cur.featured_image | default: p.featured_image -%}
        {%- if hero_img -%}
          {{ hero_img | image_url: width: 1400 | image_tag: class: 'bfx-stage__img', widths: '500,800,1100,1400', sizes: '(min-width: 960px) 50vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: p.title, data-bfx-hero: '' }}
        {%- endif -%}
      </button>
      <div class="bfx-film" data-bfx-film aria-label="More photos">
        {%- for m in p.media limit: 8 -%}
          <button type="button" class="bfx-film__b{% if m.id == cur.featured_media.id or forloop.first and cur.featured_media == blank %} is-on{% endif %}" data-media="{{ m.id }}" data-src="{{ m.preview_image | image_url: width: 1400 }}" aria-label="Photo {{ forloop.index }}">
            {{ m.preview_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: '' }}
          </button>
        {%- endfor -%}
      </div>
    </div>

    <div class="bfx-buy">
      <p class="bfx-eye"><span class="bfx-dot" aria-hidden="true"></span>Black Friday · while stock lasts</p>
      <h1 class="bfx-h1">{{ name_a | replace: " ", "&nbsp;" | replace_first: "&nbsp;", " " }}&nbsp;<em>{{ name_b }}</em></h1>
      <p class="bfx-lede">
        {%- if k == 'portal' -%}Your PS5, off the TV. An 8" screen between two DualSense halves, now {{ off_pct | default: 30 }}% off.
        {%- else -%}The new Nintendo console, on its own or with Mario Kart World or Pokémon Legends: Z-A. {{ off_pct | default: 30 }}% off.{%- endif -%}
      </p>

      <div class="bfx-price" aria-live="polite">
        <span class="bfx-price__now" data-bfx-now>{{ cur.price | money }}</span>
        <span class="bfx-price__side">
          <s data-bfx-was {% unless cur.compare_at_price > cur.price %}hidden{% endunless %}>{{ cur.compare_at_price | money }}</s>
          <span class="bfx-save" data-bfx-save {% unless cur.compare_at_price > cur.price %}hidden{% endunless %}>You save {{ cur.compare_at_price | minus: cur.price | money }}</span>
        </span>
      </div>

      {%- form 'product', p, id: 'bfx-form', class: 'bfx-form', data-bfx-form: '' -%}
        <input type="hidden" name="id" value="{{ cur.id }}" data-bfx-id>
        <div class="bfx-terms">{{ form | payment_terms }}</div>

        <fieldset class="bfx-pick">
          <legend>Choose your {{ pick_word }} <span data-bfx-picked>{{ cur.title }}</span></legend>
          <div class="bfx-opts" role="radiogroup" aria-label="Choose your {{ pick_word }}" data-bfx-opts>
            {%- for v in p.variants -%}
              <button type="button" role="radio" class="bfx-opt" data-vid="{{ v.id }}" aria-checked="{% if v.id == cur.id %}true{% else %}false{% endif %}" tabindex="{% if v.id == cur.id %}0{% else %}-1{% endif %}" {% unless v.available %}data-soldout{% endunless %}>
                <span class="bfx-opt__img">{%- assign oi = v.featured_image | default: p.featured_image -%}{% if oi %}{{ oi | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}{% endif %}</span>
                <span class="bfx-opt__t"><b data-bfx-lab></b><small data-bfx-sub></small></span>
                <span class="bfx-opt__p"><b>{{ v.price | money }}</b>{% if v.compare_at_price > v.price %}<s>{{ v.compare_at_price | money }}</s>{% endif %}</span>
                {%- unless v.available -%}<span class="bfx-opt__so">Sold out</span>{%- endunless -%}
              </button>
            {%- endfor -%}
          </div>
        </fieldset>

        <p class="bfx-stock" data-bfx-stock hidden><span class="bfx-stock__bar"><i data-bfx-stockbar></i></span><span data-bfx-stocktxt></span></p>

        <div class="bfx-ctas">
          <button type="submit" class="bfx-cta" data-bfx-add {% unless cur.available %}disabled{% endunless %}>
            <span class="bfx-cta__t" data-bfx-addt>Add to bag · {{ cur.price | money }}</span>
          </button>
          <button type="submit" name="return_to" value="/checkout" class="bfx-cta bfx-cta--ghost" data-bfx-buy {% unless cur.available %}disabled{% endunless %}>Buy now</button>
        </div>
        <p class="bfx-eta" data-bfx-eta>Free tracked shipping · arrives in 5–12 days</p>
      {%- endform -%}

      <ul class="bfx-trust">
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6l-8-3Z"/><path d="m8.5 12 2.5 2.5 4.5-5"/></svg>New, sealed, US model</li>
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>Free tracked shipping</li>
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 14 4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-3"/></svg>30-day returns</li>
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>Secure checkout</li>
      </ul>
    </div>
  </div>
</div>

{%- comment -%} ───────────── 3. Savings receipt ───────────── {%- endcomment -%}
<div class="bfx-sec bfx-wrap bfx-split" data-bfx-rv>
  <div>
    <p class="bfx-eye">The math</p>
    <h2 class="bfx-h2">The real price. <em>Then {{ off_pct | default: 30 }}% less.</em></h2>
    <p class="bfx-p">The original price is the maker's US list price. The Black Friday price is that, minus {{ off_pct | default: 30 }}%. Shipping is free. Nothing is added at checkout except sales tax where it applies.</p>
  </div>
  <div class="bfx-rcpt" aria-live="polite">
    <p class="bfx-rcpt__h">SEVENCRUSH · Black Friday</p>
    <div class="bfx-rcpt__r"><span data-bfx-rname>{{ p.title }} · {{ cur.title }}</span><span data-bfx-rwas>{{ cur.compare_at_price | default: cur.price | money }}</span></div>
    <div class="bfx-rcpt__r is-off"><span>Black Friday −{{ off_pct | default: 30 }}%</span><span data-bfx-roff>−{{ cur.compare_at_price | minus: cur.price | at_least: 0 | money }}</span></div>
    <div class="bfx-rcpt__r"><span>Shipping (US, tracked)</span><span>Free</span></div>
    <div class="bfx-rcpt__r is-tot"><span>You pay</span><span data-bfx-rnow>{{ cur.price | money }}</span></div>
    <p class="bfx-rcpt__f">Before tax · prices from this product, live</p>
  </div>
</div>

{%- comment -%} ───────────── 4. Find yours (quiz) ───────────── {%- endcomment -%}
<div class="bfx-sec bfx-wrap" data-bfx-rv>
  <p class="bfx-eye">30 seconds</p>
  <h2 class="bfx-h2">Not sure? <em>We'll pick with you.</em></h2>
  <div class="bfx-quiz" data-bfx-quiz>
    {%- if k == 'portal' -%}
      <div class="bfx-q" data-q="1">
        <p class="bfx-q__h"><span>1/2</span>Do you have a PS5 at home?</p>
        <div class="bfx-q__a">
          <button type="button" data-a="yes">Yes, I have a PS5</button>
          <button type="button" data-a="no">No, not yet</button>
        </div>
      </div>
      <div class="bfx-q" data-q="2" hidden>
        <p class="bfx-q__h"><span>2/2</span>Which look is you?</p>
        <div class="bfx-q__a">
          <button type="button" data-pick="white">Clean white</button>
          <button type="button" data-pick="black">All black</button>
          <button type="button" data-pick="30">Retro PS1 gray</button>
        </div>
      </div>
      <div class="bfx-q bfx-q--warn" data-q="no" hidden>
        <p class="bfx-q__h">Heads-up: the Portal needs a PS5</p>
        <p>It plays the games installed on your PS5 over Wi-Fi. Without a PS5, it can only stream selected PS5 games from the cloud with a PlayStation Plus Premium membership.</p>
        <div class="bfx-q__a"><button type="button" data-a="yes">I'll use cloud streaming, continue</button><button type="button" data-reset>Start over</button></div>
      </div>
    {%- else -%}
      <div class="bfx-q" data-q="1">
        <p class="bfx-q__h"><span>1/1</span>What do you want to play first?</p>
        <div class="bfx-q__a">
          <button type="button" data-pick="mario">Racing with friends</button>
          <button type="button" data-pick="pok">Catching Pokémon</button>
          <button type="button" data-pick="console">I'll choose my own games</button>
        </div>
      </div>
    {%- endif -%}
    <div class="bfx-q bfx-q--ok" data-q="done" hidden>
      <p class="bfx-q__h">Your pick: <b data-bfx-qres></b></p>
      <p data-bfx-qprice></p>
      <div class="bfx-q__a"><a href="#bfx-form" class="bfx-cta bfx-cta--sm" data-bfx-go>It's selected · go to bag</a><button type="button" data-reset>Start over</button></div>
    </div>
  </div>
</div>

{%- comment -%} ───────────── 5. Compare ───────────── {%- endcomment -%}
<div class="bfx-sec bfx-wrap" data-bfx-rv id="bfx-compare">
  <p class="bfx-eye">Side by side</p>
  <h2 class="bfx-h2">Every {{ pick_word }}, <em>every price.</em></h2>
  <div class="bfx-cmp" style="--n:{{ p.variants.size }}" role="table" aria-label="Compare every {{ pick_word }}">
    <div class="bfx-cmp__r bfx-cmp__head" role="row">
      <span role="columnheader"></span>
      {%- for v in p.variants -%}
        <span role="columnheader" class="bfx-cmp__col" data-vid="{{ v.id }}">
          {%- assign ci = v.featured_image | default: p.featured_image -%}{% if ci %}{{ ci | image_url: width: 300 | image_tag: loading: 'lazy', alt: '' }}{% endif %}
          <b data-bfx-lab-of="{{ v.id }}">{{ v.title }}</b>
        </span>
      {%- endfor -%}
    </div>
    {%- if k == 'portal' -%}
      {%- assign rows = '8" 1080p remote player|DualSense haptics & adaptive triggers|Remote Play + cloud streaming|Limited edition' | split: '|' -%}
    {%- else -%}
      {%- assign rows = 'Nintendo Switch 2 · 256 GB|Joy-Con 2, grip, dock & cables|Mario Kart World (download code)|Pokémon Legends: Z-A (download code)' | split: '|' -%}
    {%- endif -%}
    {%- for r in rows -%}
      {%- assign ri = forloop.index -%}
      <div class="bfx-cmp__r" role="row">
        <span role="rowheader">{{ r }}</span>
        {%- for v in p.variants -%}
          {%- liquid
            assign vd = v.title | downcase
            assign yes = true
            if ri == 4
              if k == 'portal'
                unless vd contains '30'
                  assign yes = false
                endunless
              else
                unless vd contains 'pok'
                  assign yes = false
                endunless
              endif
            elsif ri == 3 and k != 'portal'
              unless vd contains 'mario'
                assign yes = false
              endunless
            endif
          -%}
          <span role="cell" class="bfx-cmp__col" data-vid="{{ v.id }}">{% if yes %}<i class="bfx-yes" aria-label="Included"></i>{% else %}<i class="bfx-no" aria-label="Not included"></i>{% endif %}</span>
        {%- endfor -%}
      </div>
    {%- endfor -%}
    <div class="bfx-cmp__r bfx-cmp__price" role="row">
      <span role="rowheader">Black Friday price</span>
      {%- for v in p.variants -%}
        <span role="cell" class="bfx-cmp__col" data-vid="{{ v.id }}"><b>{{ v.price | money }}</b>{% if v.compare_at_price > v.price %}<s>{{ v.compare_at_price | money }}</s>{% endif %}<button type="button" class="bfx-cmp__btn" data-choose="{{ v.id }}" {% unless v.available %}disabled{% endunless %}>{% if v.available %}Choose{% else %}Sold out{% endif %}</button></span>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- comment -%} ───────────── 6. Feature bento ───────────── {%- endcomment -%}
<div class="bfx-sec bfx-wrap" data-bfx-rv>
  <p class="bfx-eye">{% if k == 'portal' %}Why it's good{% else %}What's new{% endif %}</p>
  <h2 class="bfx-h2">{% if k == 'portal' %}Built like a DualSense. <em>Sees like a screen.</em>{% else %}Bigger, sharper. <em>Still a Switch.</em>{% endif %}</h2>
  <div class="bfx-bento">
    {%- if k == 'portal' -%}
      <div class="bfx-tile bfx-tile--xl"><b class="bfx-big">8"</b><span>LCD screen, 1080p at 60 fps.</span></div>
      <div class="bfx-tile"><b class="bfx-mid">Haptics</b><span>DualSense haptic feedback and adaptive triggers, on both sides.</span></div>
      <div class="bfx-tile"><b class="bfx-mid">Remote Play</b><span>Plays the games installed on your PS5, over Wi-Fi.</span></div>
      <div class="bfx-tile"><b class="bfx-mid">Cloud</b><span>PlayStation Plus Premium members can stream selected PS5 games, no console needed.</span></div>
      <div class="bfx-tile"><b class="bfx-mid">5 / 15</b><span>Mbps: Sony's minimum and recommended connection.</span></div>
      <div class="bfx-tile"><b class="bfx-mid">3.5 mm</b><span>Headphone jack, plus PlayStation Link for wireless earbuds.</span></div>
    {%- else -%}
      <div class="bfx-tile bfx-tile--xl"><b class="bfx-big">7.9"</b><span>1080p screen with HDR, up to 120 fps handheld.</span></div>
      <div class="bfx-tile"><b class="bfx-mid">4K</b><span>On your TV through the dock.</span></div>
      <div class="bfx-tile"><b class="bfx-mid">256 GB</b><span>Built in. Add more with a microSD Express card.</span></div>
      <div class="bfx-tile"><b class="bfx-mid">Joy-Con 2</b><span>Snap on magnetically. Work as a mouse, too.</span></div>
      <div class="bfx-tile"><b class="bfx-mid">C button</b><span>GameChat with the built-in mic.</span></div>
      <div class="bfx-tile"><b class="bfx-mid">Switch games</b><span>Most Nintendo Switch games play on it.</span></div>
    {%- endif -%}
  </div>
</div>

{%- comment -%} ───────────── 7. Box / How it works ───────────── {%- endcomment -%}
<div class="bfx-sec bfx-wrap" data-bfx-rv>
  <p class="bfx-eye">{% if k == 'portal' %}How it works{% else %}In the box{% endif %}</p>
  <h2 class="bfx-h2">{% if k == 'portal' %}Five steps. <em>Then just play.</em>{% else %}Open it. <em>Play it.</em>{% endif %}</h2>
  <ol class="bfx-steps">
    {%- if k == 'portal' -%}
      <li><b>Connect</b><span>Put your PS5 and the Portal on Wi-Fi.</span></li>
      <li><b>Sign in</b><span>Same PlayStation account on both.</span></li>
      <li><b>Turn on Remote Play</b><span>In the PS5 settings. Leave the PS5 on or in rest mode.</span></li>
      <li><b>Play</b><span>Your installed PS5 games, on the 8" screen.</span></li>
      <li><b>Or stream</b><span>Selected PS5 games from the cloud with PlayStation Plus Premium.</span></li>
    {%- else -%}
      <li><b>Console</b><span>Nintendo Switch 2, 256 GB.</span></li>
      <li><b>Joy-Con 2 (L) and (R)</b><span>Plus the Joy-Con 2 grip and two straps.</span></li>
      <li><b>Dock</b><span>For your TV, up to 4K.</span></li>
      <li><b>Cables</b><span>AC adapter, USB-C charging cable, Ultra High Speed HDMI cable.</span></li>
      <li><b>The game</b><span>On the bundles: Mario Kart World or Pokémon Legends: Z-A, as a download code.</span></li>
    {%- endif -%}
  </ol>
</div>

{%- comment -%} ───────────── 8. Before you buy + FAQ ───────────── {%- endcomment -%}
<div class="bfx-sec bfx-wrap bfx-split" data-bfx-rv>
  <div>
    <p class="bfx-eye">Before you buy</p>
    <h2 class="bfx-h2">No surprises <em>after checkout.</em></h2>
    <ul class="bfx-checks">
      {%- if k == 'portal' -%}
        <li>You need a PS5 for Remote Play, or PlayStation Plus Premium for cloud streaming.</li>
        <li>No Bluetooth audio: use the 3.5 mm jack or PlayStation Link earbuds.</li>
        <li>PS VR2 games aren't supported.</li>
        <li>Works best on your home Wi-Fi (Sony: 5 Mbps minimum, 15 recommended).</li>
      {%- else -%}
        <li>Bundle games come as a download code, not a cartridge.</li>
        <li>Extra storage needs a microSD Express card.</li>
        <li>Online play needs Nintendo Switch Online, sold separately.</li>
        <li>A few Nintendo Switch games may not be fully compatible.</li>
      {%- endif -%}
    </ul>
  </div>
  <div class="bfx-faq" data-bfx-faq>
    <label class="bfx-faq__s"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg><input type="search" placeholder="Search questions" data-bfx-faqs aria-label="Search questions"></label>
    {%- if k == 'portal' -%}
      <details><summary>Do I need a PS5?</summary><p>Yes, for Remote Play: it streams the games installed on your PS5. Without one, you can stream selected PS5 games from the cloud with PlayStation Plus Premium.</p></details>
      <details><summary>Can I play away from home?</summary><p>Yes, on Wi-Fi with a fast, stable connection. It works best on your home network.</p></details>
      <details><summary>What's the difference between the finishes?</summary><p>Only the look. White is the original, Midnight Black is all black, and the 30th Anniversary is a limited edition in PS1 gray.</p></details>
    {%- else -%}
      <details><summary>Which edition should I get?</summary><p>The bundles cost $50 more at list price and add a full game as a download code. If you want Mario Kart World or Pokémon Legends: Z-A anyway, the bundle is the better deal.</p></details>
      <details><summary>Can I play my Switch games?</summary><p>Most Nintendo Switch physical and digital games work on Nintendo Switch 2. A few may not be fully compatible; Nintendo keeps the list on its site.</p></details>
      <details><summary>Is the game a cartridge?</summary><p>No. On the bundles the game comes as a download code.</p></details>
    {%- endif -%}
    <details><summary>Is the 30% off the original price?</summary><p>Yes. The struck-through price is the maker's US list price, and you pay 30% less. You see both before you pay.</p></details>
    <details><summary>Is it new?</summary><p>Yes. Brand new, factory sealed, US model.</p></details>
    <details><summary>How long does shipping take?</summary><p>5–12 days in the US, free and tracked. The tracking number comes by email.</p></details>
    <details><summary>Can I return it?</summary><p>Yes, within 30 days of delivery, unopened. Email sevencrush.store@gmail.com with your order number.</p></details>
    <p class="bfx-faq__none" data-bfx-faqnone hidden>No question matches. Email sevencrush.store@gmail.com and we'll answer.</p>
  </div>
</div>

{%- comment -%} ───────────── 9. Final call ───────────── {%- endcomment -%}
<div class="bfx-end" data-bfx-rv>
  <div class="bfx-wrap bfx-end__in">
    <p class="bfx-eye">Ends in</p>
    <div class="bfx-clock bfx-clock--l" data-bfx-clock aria-label="Time left in the sale"><b data-u="d">00</b><i>days</i><b data-u="h">00</b><i>hrs</i><b data-u="m">00</b><i>min</i><b data-u="s">00</b><i>sec</i></div>
    <h2 class="bfx-h2">{{ name_a }} <em>{{ name_b }}</em> for <span data-bfx-endp>{{ cur.price | money }}</span></h2>
    <a href="#bfx-form" class="bfx-cta bfx-cta--inline" data-bfx-go>Get mine</a>
  </div>
</div>

