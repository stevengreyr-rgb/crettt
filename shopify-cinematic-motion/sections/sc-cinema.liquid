{% comment %}
  SEVENCRUSH — Cinematic product story (home + product page).
  Scenes: 1 Reveal · 2 Details (real studio angles) · 3 Experience · 4 Benefits · 5 Routine (in the box) · 6 Offer, then FAQ.
  Bundles are real automatic discounts in Shopify (Duo 15% off 2 pairs, Trio 25% off 3+): the tiers only set the quantity.
  Add to cart goes through window.SK.addItems (assets/sk.js), which opens the side bag; without it the form posts to /cart/add.
  Styles: assets/sc-cinema.css · Script: assets/sc-cinema.js (GSAP + ScrollTrigger from cdnjs, progressive enhancement).
{% endcomment %}
{%- liquid
  assign p = section.settings.product | default: all_products['sevencrush-the-everyday-earbuds']
  if product
    assign p = product
  endif
  assign cur = p.selected_or_first_available_variant
  assign u = cur.price
  assign duo_full = u | times: 2
  assign duo = duo_full | times: 85 | divided_by: 100
  assign trio_full = u | times: 3
  assign trio = trio_full | times: 75 | divided_by: 100
  assign low = false
  if cur.inventory_management == 'shopify' and cur.inventory_quantity > 0 and cur.inventory_quantity <= 10
    assign low = true
  endif
  assign i_hero = section.settings.img_hero | default: p.featured_image
  assign i_a1 = section.settings.img_a1 | default: p.media[1].preview_image
  assign i_a2 = section.settings.img_a2 | default: p.media[2].preview_image
  assign i_a3 = section.settings.img_a3 | default: p.media[3].preview_image
  assign i_exp = section.settings.img_exp | default: p.media[4].preview_image
  assign i_b1 = section.settings.img_b1 | default: p.media[5].preview_image
  assign i_b2 = section.settings.img_b2 | default: p.media[6].preview_image
  assign i_b3 = section.settings.img_b3 | default: p.media[7].preview_image
  assign i_b4 = section.settings.img_b4 | default: p.media[8].preview_image
  assign i_box = section.settings.img_box | default: p.media[1].preview_image
  assign i_offer = section.settings.img_offer | default: i_hero
  assign title_tag = 'h2'
  if request.page_type == 'product'
    assign title_tag = 'h1'
  endif
  assign arrow = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"/></svg>'
-%}
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&display=swap" rel="stylesheet">
{{ 'sc-cinema.css' | asset_url | stylesheet_tag }}

<div class="cnm" data-cnm data-unit="{{ u }}" data-money="{{ shop.money_format | escape }}" data-rw2="{{ section.settings.rw_2 | escape }}" data-rw3="{{ section.settings.rw_3 | escape }}" data-save-label="{{ section.settings.save_label | escape }}">
  <div class="cnm-progress" data-cnm-progress aria-hidden="true"></div>
  <nav class="cnm-dots" data-cnm-dots aria-label="{{ section.settings.nav_label | escape }}">
    <button type="button" data-to="cnm-s1"><span>{{ section.settings.s1_label }}</span><i></i></button>
    <button type="button" data-to="cnm-s2"><span>{{ section.settings.s2_label }}</span><i></i></button>
    <button type="button" data-to="cnm-s3"><span>{{ section.settings.s3_label }}</span><i></i></button>
    <button type="button" data-to="cnm-s4"><span>{{ section.settings.s4_label }}</span><i></i></button>
    <button type="button" data-to="cnm-s5"><span>{{ section.settings.s5_label }}</span><i></i></button>
    <button type="button" data-to="cnm-offer"><span>{{ section.settings.s6_label }}</span><i></i></button>
  </nav>

  {%- comment -%} ───── Scene 1 · The reveal ───── {%- endcomment -%}
  <section class="cnm-reveal" id="cnm-s1" data-cnm-scene aria-labelledby="cnm-title">
    <div class="cnm-reveal__media" data-cnm-hero-media>
      <div class="cnm-reveal__img">
        <div class="cnm-reveal__floor" aria-hidden="true"></div>
        {% render 'sc-cinema-img', image: i_hero, sizes: '(min-width: 900px) 62vw, 86vw', eager: true, alt: section.settings.hero_alt %}
      </div>
    </div>
    <div class="cnm-wrap cnm-reveal__copy" data-cnm-hero-copy>
      <{{ title_tag }} class="cnm-d cnm-d--xl cnm-reveal__title" id="cnm-title">
        <span class="cnm-line"><span>{{ section.settings.hero_word }}</span></span>
        <span class="cnm-line"><span class="cnm-sr">— </span><span style="font-size:.42em;font-stretch:100%;letter-spacing:-.01em;font-weight:700;padding-top:.2em">{{ section.settings.product_name }}</span></span>
      </{{ title_tag }}>
      <p class="cnm-p cnm-reveal__sub">{{ section.settings.hero_text }}</p>
      <div class="cnm-reveal__buy">
        <p class="cnm-price">
          <span data-cnm-unit>{{ u | money }}</span>
          {%- if cur.compare_at_price > cur.price -%}<s>{{ cur.compare_at_price | money }}</s>{%- endif -%}
        </p>
        <div class="cnm-reveal__ctas">
          <a class="cnm-btn cnm-btn--accent" href="#cnm-offer" data-cnm-jump>{{ section.settings.hero_cta }}{{ arrow }}</a>
          <a class="cnm-btn cnm-btn--ghost" href="#cnm-s2" data-cnm-jump>{{ section.settings.hero_cta2 }}</a>
        </div>
        <p class="cnm-reveal__note">{{ section.settings.hero_note }}</p>
      </div>
    </div>
    <span class="cnm-scrollcue" aria-hidden="true"></span>
  </section>

  {%- if section.settings.band != blank -%}
    {%- assign band_items = section.settings.band | split: '|' -%}
    <div class="cnm-band" aria-label="{{ section.settings.band | replace: '|', ' · ' | escape }}">
      <div class="cnm-band__track" aria-hidden="true">
        {%- for r in (1..2) -%}{%- for b in band_items -%}<span>{{ b | strip }}</span>{%- endfor -%}{%- for b in band_items -%}<span>{{ b | strip }}</span>{%- endfor -%}{%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ───── Scene 2 · The details: real studio angles, turned by scroll or by drag ───── {%- endcomment -%}
  <section class="cnm-details" id="cnm-s2" data-cnm-scene data-cnm-details aria-labelledby="cnm-s2-h">
    <div class="cnm-details__stage">
      <div class="cnm-wrap cnm-details__grid">
        <div class="cnm-details__copy">
          <p class="cnm-k">{{ section.settings.s2_kicker }}</p>
          <h2 class="cnm-d cnm-d--l" id="cnm-s2-h" data-cnm-lines>{{ section.settings.s2_title }}</h2>
          <p class="cnm-p">{{ section.settings.s2_text }}</p>
        </div>
        <div class="cnm-angles" data-cnm-angles>
          <div class="cnm-angles__stage" data-cnm-angles-stage tabindex="0" role="group" aria-roledescription="carousel" aria-label="{{ section.settings.s2_aria | escape }}">
            {%- assign caps = section.settings.s2_caps | split: '|' -%}
            {%- assign frames = 0 -%}
            {%- for img in (1..3) -%}
              {%- case img -%}{%- when 1 -%}{%- assign fi = i_a1 -%}{%- when 2 -%}{%- assign fi = i_a2 -%}{%- else -%}{%- assign fi = i_a3 -%}{%- endcase -%}
              {%- if fi != blank -%}
                <figure class="cnm-angles__frame{% if forloop.first %} is-active{% endif %}" data-cnm-frame aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}">
                  {% render 'sc-cinema-img', image: fi, sizes: '(min-width: 900px) 56vw, 92vw', alt: caps[forloop.index0] %}
                </figure>
              {%- endif -%}
            {%- endfor -%}
            <span class="cnm-angles__hint" aria-hidden="true"><svg viewBox="0 0 22 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 2 1 6l4 4M17 2l4 4-4 4M1 6h20"/></svg>{{ section.settings.s2_hint }}</span>
            <button type="button" class="cnm-angles__zoom" data-cnm-zoom aria-pressed="false" aria-label="{{ section.settings.s2_zoom | escape }}"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="8.5" cy="8.5" r="6"/><path d="m13 13 5 5M8.5 5.8v5.4M5.8 8.5h5.4"/></svg></button>
          </div>
          <div class="cnm-angles__caps" aria-live="polite">
            {%- for c in caps -%}
              {%- assign parts = c | split: ':' -%}
              <p class="cnm-angles__cap{% if forloop.first %} is-active{% endif %}" data-cnm-cap><b>{{ parts[0] | strip }}</b>{{ parts[1] | strip }}</p>
            {%- endfor -%}
          </div>
          <div class="cnm-angles__ticks" data-cnm-ticks>
            {%- for c in caps -%}<button type="button" aria-label="{{ c | split: ':' | first | strip | escape }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"><i></i></button>{%- endfor -%}
          </div>
          <p class="cnm-angles__honest">{{ section.settings.s2_note }}</p>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ───── Scene 3 · The experience ───── {%- endcomment -%}
  <section class="cnm-exp" id="cnm-s3" data-cnm-scene data-cnm-exp aria-labelledby="cnm-s3-h">
    <div class="cnm-exp__stage">
      <div class="cnm-exp__media" data-cnm-exp-media>
        {% render 'sc-cinema-img', image: i_exp, sizes: '100vw', alt: section.settings.s3_alt %}
      </div>
      <div class="cnm-wrap cnm-exp__copy" data-cnm-exp-copy>
        <p class="cnm-k">{{ section.settings.s3_kicker }}</p>
        <h2 class="cnm-d cnm-d--l" id="cnm-s3-h" data-cnm-lines>{{ section.settings.s3_title }}</h2>
        <p class="cnm-p">{{ section.settings.s3_text }}</p>
      </div>
    </div>
  </section>

  {%- comment -%} ───── Scene 4 · The benefits ───── {%- endcomment -%}
  <section class="cnm-ben" id="cnm-s4" data-cnm-scene aria-labelledby="cnm-s4-h">
    <div class="cnm-wrap">
      <div class="cnm-ben__head">
        <p class="cnm-k">{{ section.settings.s4_kicker }}</p>
        <h2 class="cnm-d cnm-d--l" id="cnm-s4-h" data-cnm-lines>{{ section.settings.s4_title }}</h2>
      </div>
      <div class="cnm-ben__grid">
        <div class="cnm-ben__media" aria-hidden="true">
          {%- for n in (1..4) -%}
            {%- case n -%}{%- when 1 -%}{%- assign bi = i_b1 -%}{%- assign bc = section.settings.b1_tag -%}{%- when 2 -%}{%- assign bi = i_b2 -%}{%- assign bc = section.settings.b2_tag -%}{%- when 3 -%}{%- assign bi = i_b3 -%}{%- assign bc = section.settings.b3_tag -%}{%- else -%}{%- assign bi = i_b4 -%}{%- assign bc = section.settings.b4_tag -%}{%- endcase -%}
            <figure class="cnm-ben__img{% if n == 1 %} is-active{% endif %}" data-cnm-bimg>
              {% render 'sc-cinema-img', image: bi, sizes: '(min-width: 900px) 46vw, 92vw', alt: '' %}
              {%- if bc != blank -%}<figcaption>{{ bc }}</figcaption>{%- endif -%}
            </figure>
          {%- endfor -%}
        </div>
        <div class="cnm-ben__list">
          {%- for n in (1..4) -%}
            {%- case n -%}
              {%- when 1 -%}{%- assign bt = section.settings.b1_title -%}{%- assign bx = section.settings.b1_text -%}
              {%- when 2 -%}{%- assign bt = section.settings.b2_title -%}{%- assign bx = section.settings.b2_text -%}
              {%- when 3 -%}{%- assign bt = section.settings.b3_title -%}{%- assign bx = section.settings.b3_text -%}
              {%- else -%}{%- assign bt = section.settings.b4_title -%}{%- assign bx = section.settings.b4_text -%}
            {%- endcase -%}
            <article class="cnm-ben__item{% if n == 1 %} is-active{% endif %}" data-cnm-bitem>
              <p class="cnm-ben__n">0{{ n }} / 04</p>
              <h3>{{ bt }}</h3>
              <p class="cnm-p">{{ bx }}</p>
              <span class="cnm-ben__bar" aria-hidden="true"><i data-cnm-bbar></i></span>
            </article>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ───── Scene 5 · The routine: what's in the box + how they fit the day ───── {%- endcomment -%}
  <section class="cnm-rt" id="cnm-s5" data-cnm-scene aria-labelledby="cnm-s5-h">
    <div class="cnm-wrap cnm-rt__grid">
      <div class="cnm-rt__photo" data-cnm-mask>
        <div data-cnm-par>{% render 'sc-cinema-img', image: i_box, sizes: '(min-width: 900px) 52vw, 92vw', alt: section.settings.s5_alt %}</div>
        <button type="button" class="cnm-pin" style="--x:{{ section.settings.pin1_x }}%;--y:{{ section.settings.pin1_y }}%" aria-expanded="false" data-cnm-pin>
          <span class="cnm-pin__dot"><i></i></span><span class="cnm-pin__tip"><b>{{ section.settings.pin1_title }}</b>{{ section.settings.pin1_text }}</span>
        </button>
        <button type="button" class="cnm-pin" style="--x:{{ section.settings.pin2_x }}%;--y:{{ section.settings.pin2_y }}%" aria-expanded="false" data-cnm-pin>
          <span class="cnm-pin__dot"><i></i></span><span class="cnm-pin__tip"><b>{{ section.settings.pin2_title }}</b>{{ section.settings.pin2_text }}</span>
        </button>
      </div>
      <div class="cnm-rt__copy">
        <p class="cnm-k">{{ section.settings.s5_kicker }}</p>
        <h2 class="cnm-d cnm-d--l" id="cnm-s5-h" data-cnm-lines>{{ section.settings.s5_title }}</h2>
        <p class="cnm-p">{{ section.settings.s5_text }}</p>
        <ul class="cnm-rt__list" data-cnm-stagger>
          {%- assign box = section.settings.s5_box | split: '|' -%}
          {%- for b in box -%}{%- assign bp = b | split: ':' -%}<li><span>{{ bp[0] | strip }}</span><span>{{ bp[1] | strip }}</span></li>{%- endfor -%}
        </ul>
      </div>
    </div>
    <div class="cnm-rail" data-cnm-rail>
      <div class="cnm-wrap cnm-rail__head">
        <h3 class="cnm-d cnm-d--m" data-cnm-lines>{{ section.settings.rail_title }}</h3>
        <div class="cnm-rail__nav">
          <button type="button" data-cnm-rail-prev aria-label="{{ section.settings.rail_prev | escape }}"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M14 8H3M7 4 3 8l4 4"/></svg></button>
          <button type="button" data-cnm-rail-next aria-label="{{ section.settings.rail_next | escape }}"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"/></svg></button>
        </div>
      </div>
      <div class="cnm-rail__track" data-cnm-rail-track tabindex="0" aria-label="{{ section.settings.rail_title | escape }}">
        {%- assign moments = section.settings.rail_items | split: '|' -%}
        {%- for m in moments -%}
          {%- assign mp = m | split: '~' -%}
          <div class="cnm-card cnm-moment" style="--h:{{ forloop.index0 | times: 18 }}">
            <div class="cnm-card__img cnm-moment__panel"><span class="cnm-moment__time">{{ mp[0] | strip }}</span><span class="cnm-moment__t">{{ mp[1] | strip }}</span></div>
            <span>{{ mp[2] | strip }}</span>
          </div>
        {%- endfor -%}
        {%- for rp in section.settings.pairs -%}
          <a class="cnm-card" href="{{ rp.url }}">
            <div class="cnm-card__img">{% render 'sc-cinema-img', image: rp.featured_image, sizes: '(min-width: 900px) 26vw, 72vw', max: 900 %}</div>
            <b>{{ rp.title }}</b><span>{{ rp.price | money }}</span>
          </a>
        {%- endfor -%}
      </div>
      <div class="cnm-rail__dots" data-cnm-rail-dots aria-hidden="true"></div>
    </div>
  </section>

  {%- comment -%} ───── Scene 6 · The offer ───── {%- endcomment -%}
  <section class="cnm-offer" id="cnm-offer" data-cnm-scene aria-labelledby="cnm-s6-h">
    <div class="cnm-wrap cnm-offer__grid">
      <div class="cnm-offer__media" data-cnm-mask>
        <div data-cnm-offer-img>{% render 'sc-cinema-img', image: i_offer, sizes: '(min-width: 900px) 46vw, 92vw', alt: section.settings.hero_alt %}</div>
        <span class="cnm-offer__count" data-cnm-count aria-hidden="true">×1</span>
      </div>
      <div class="cnm-offer__form">
        <div class="cnm-offer__title">
          <p class="cnm-k">{{ section.settings.s6_kicker }}</p>
          <h2 class="cnm-d cnm-d--l" id="cnm-s6-h" data-cnm-lines>{{ section.settings.s6_title }}</h2>
        </div>
        {%- form 'product', p, id: 'cnm-form', data-cnm-form: '' -%}
          <input type="hidden" name="id" value="{{ cur.id }}" data-cnm-id>
          <input type="hidden" name="quantity" value="1" data-cnm-qty>
          <div class="cnm-tiers" role="radiogroup" aria-label="{{ section.settings.s6_tiers_label | escape }}" data-cnm-tiers>
            <button type="button" class="cnm-tier" role="radio" aria-checked="true" data-q="1" data-off="0" data-name="{{ section.settings.t1_name | escape }}">
              <span class="cnm-tier__radio" aria-hidden="true"></span>
              <span class="cnm-tier__t"><b>{{ section.settings.t1_name }}</b><small>{{ section.settings.t1_sub }}</small></span>
              <span class="cnm-tier__p"><b>{{ u | money }}</b></span>
            </button>
            <button type="button" class="cnm-tier" role="radio" aria-checked="false" data-q="2" data-off="15" data-name="{{ section.settings.t2_name | escape }}">
              <span class="cnm-tier__radio" aria-hidden="true"></span>
              <span class="cnm-tier__t"><b>{{ section.settings.t2_name }}</b><small>{{ section.settings.t2_sub }}</small></span>
              <span class="cnm-tier__p"><b>{{ duo | money }}</b><s>{{ duo_full | money }}</s></span>
            </button>
            <button type="button" class="cnm-tier" role="radio" aria-checked="false" data-q="3" data-off="25" data-name="{{ section.settings.t3_name | escape }}">
              <span class="cnm-tier__flag">{{ section.settings.t3_flag }}</span>
              <span class="cnm-tier__radio" aria-hidden="true"></span>
              <span class="cnm-tier__t"><b>{{ section.settings.t3_name }}</b><small>{{ section.settings.t3_sub }}</small></span>
              <span class="cnm-tier__p"><b>{{ trio | money }}</b><s>{{ trio_full | money }}</s></span>
            </button>
          </div>
          <div class="cnm-reward" data-cnm-reward>
            <div class="cnm-reward__bar" aria-hidden="true"><i></i></div>
            <div class="cnm-reward__steps" aria-hidden="true"><span class="is-on">1</span><span>2 · −15%</span><span>3 · −25%</span></div>
            <p class="cnm-reward__msg" data-cnm-reward-msg role="status">{{ section.settings.rw_1 }}</p>
          </div>
          <div class="cnm-total">
            <div>
              <span class="cnm-total__v" data-cnm-total>{{ u | money }}</span>
              <p class="cnm-total__save" data-cnm-save hidden></p>
            </div>
            {%- if low -%}<p class="cnm-stock is-low"><i></i>{{ section.settings.low_stock | replace: '[n]', cur.inventory_quantity }}</p>{%- elsif cur.available -%}<p class="cnm-stock"><i></i>{{ section.settings.in_stock }}</p>{%- endif -%}
          </div>
          <button type="submit" class="cnm-btn cnm-btn--accent cnm-btn--wide" data-cnm-atc {% unless cur.available %}disabled{% endunless %}>
            <span class="cnm-btn__label">{% if cur.available %}{{ section.settings.atc }} · <span data-cnm-total-btn>{{ u | money }}</span>{% else %}{{ section.settings.sold_out }}{% endif %}</span>
            <span class="cnm-btn__spin" aria-hidden="true"></span>
            <span class="cnm-btn__done" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9.5 4 4 8-9"/></svg>{{ section.settings.added }}</span>
          </button>
          <p class="cnm-err" data-cnm-err role="alert"></p>
          <p class="cnm-reward__msg">{{ section.settings.s6_note }}</p>
          <div class="cnm-trust">
            <span><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M1 4h9v7H1zM10 6.5h3l2 2V11h-5"/><circle cx="4" cy="12" r="1.4"/><circle cx="12" cy="12" r="1.4"/></svg>{{ section.settings.trust1 }}</span>
            <span><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M2 8a6 6 0 1 0 2-4.5M2 2v3h3"/></svg>{{ section.settings.trust2 }}</span>
            <span><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="7" width="10" height="7" rx="1"/><path d="M5 7V5a3 3 0 0 1 6 0v2"/></svg>{{ section.settings.trust3 }}</span>
          </div>
          {%- if shop.enabled_payment_types.size > 0 -%}<ul class="cnm-pay" aria-label="{{ section.settings.pay_label | escape }}">{%- for t in shop.enabled_payment_types limit: 6 -%}<li>{{ t | payment_type_svg_tag }}</li>{%- endfor -%}</ul>{%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </section>

  <section class="cnm-faq" aria-labelledby="cnm-faq-h">
    <div class="cnm-wrap cnm-faq__grid">
      <h2 class="cnm-d cnm-d--m" id="cnm-faq-h" data-cnm-lines>{{ section.settings.faq_title }}</h2>
      <div data-cnm-faq>
        {%- for block in section.blocks -%}
          <details {{ block.shopify_attributes }}>
            <summary>{{ block.settings.q }}<i aria-hidden="true"></i></summary>
            <div class="cnm-faq__body"><div><p>{{ block.settings.a }}</p></div></div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <div class="cnm-sticky" data-cnm-sticky aria-hidden="true">
    {%- if i_offer != blank -%}{{ i_offer | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
    <span class="cnm-sticky__t"><b>{{ section.settings.product_name }}</b><span data-cnm-sticky-sub>{{ section.settings.t1_name }} · {{ u | money }}</span></span>
    <a class="cnm-btn cnm-btn--accent" href="#cnm-offer" data-cnm-jump tabindex="-1">{{ section.settings.sticky_cta }}</a>
  </div>
</div>

<style>
  .cnm-moment__panel{position:relative;display:flex;flex-direction:column;justify-content:space-between;padding:22px;color:var(--cnm-ink);
    background:linear-gradient(160deg,hsl(calc((28 + var(--h)) * 1deg) 30% 92%),hsl(calc((18 + var(--h)) * 1deg) 22% 84%))}
  .cnm-moment__time{font:800 clamp(44px,5vw,72px)/1 var(--cnm-display);font-stretch:72%;font-variant-numeric:tabular-nums;letter-spacing:-.02em}
  .cnm-moment__t{font:700 22px/1.1 var(--cnm-display)}
  .cnm-moment>span{font-size:15px;line-height:1.45;color:var(--cnm-ink-2)}
</style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>
<script src="{{ 'sc-cinema.js' | asset_url }}" defer></script>

