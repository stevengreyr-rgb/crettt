{%- liquid
  assign p = product | default: all_products[section.settings.handle]
  assign cur = p.selected_or_first_available_variant
  assign img_box = images['psp-whats-in-the-box.jpg']
-%}
{%- comment -%}
  PlayStation Portal · Black Friday landing. Same layout, classes and motion as the Glow Ritual Set
  (glow-set.liquid), so glow-fix.css and glow-motion.js style it exactly the same.
  Prices come from the product: compare-at price = original price, price = 30% off.
{%- endcomment -%}
<script>try{if(!matchMedia('(prefers-reduced-motion: reduce)').matches)document.documentElement.classList.add('gm-js')}catch(e){}</script>
<script src="{{ 'glow-motion.js' | asset_url }}" defer></script>
<section class="gr gr--bf" data-gr>
<script type="application/json" data-gr-json>{{ p.variants | json }}</script>

<div class="bf-bar" data-bf-end="{{ section.settings.ends | escape }}">
  <b>BLACK FRIDAY</b>
  <span>30% off every PlayStation Portal finish</span>
  <span class="bf-clock" data-bf-clock aria-label="Time left"><i data-bf="d">00</i>d <i data-bf="h">00</i>h <i data-bf="m">00</i>m <i data-bf="s">00</i>s</span>
</div>

<div class="gr-wrap gr-top">

  <div class="gr-gal">
    {%- liquid
      assign gr_n = 0
      assign gr_slides = ''
      assign gr_thumbs = ''
    -%}
    {%- for m in p.media -%}
      {%- assign gr_n = gr_n | plus: 1 -%}
      {%- capture one -%}
        <figure class="gr-slide" data-media-id="{{ m.id }}">
          {%- if gr_n == 1 -%}
            {{ m.preview_image | image_url: width: 1400 | image_tag: widths: '500,800,1100,1400', sizes: '(min-width: 900px) 55vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: m.alt | default: p.title }}
          {%- else -%}
            {{ m.preview_image | image_url: width: 1400 | image_tag: widths: '500,800,1100,1400', sizes: '(min-width: 900px) 55vw, 100vw', loading: 'lazy', alt: m.alt | default: p.title }}
          {%- endif -%}
          {%- if gr_n == 1 -%}<span class="bf-badge" aria-hidden="true">-30%</span>{%- endif -%}
        </figure>
      {%- endcapture -%}
      {%- capture th -%}<button type="button" aria-label="Image {{ gr_n }}">{{ m.preview_image | image_url: width: 220 | image_tag: loading: 'lazy', alt: '' }}</button>{%- endcapture -%}
      {%- assign gr_slides = gr_slides | append: one -%}
      {%- assign gr_thumbs = gr_thumbs | append: th -%}
      {%- if gr_n == 1 and img_box -%}
        {%- assign gr_n = gr_n | plus: 1 -%}
        {%- capture one -%}
          <figure class="gr-slide gr-slide--box">
            {{ img_box | image_url: width: 300 | image_tag: class: 'gr-box__bg', loading: 'lazy', alt: '' }}
            {{ img_box | image_url: width: 1400 | image_tag: class: 'gr-box__ph', widths: '500,800,1100,1400', sizes: '(min-width: 900px) 55vw, 100vw', loading: 'lazy', alt: 'PlayStation Portal remote player out of the box' }}
          </figure>
        {%- endcapture -%}
        {%- capture th -%}<button type="button" aria-label="Image {{ gr_n }}: what's in the box">{{ img_box | image_url: width: 220 | image_tag: loading: 'lazy', alt: '' }}</button>{%- endcapture -%}
        {%- assign gr_slides = gr_slides | append: one -%}
        {%- assign gr_thumbs = gr_thumbs | append: th -%}
      {%- endif -%}
    {%- endfor -%}
    <div class="gr-stage">
      <div class="gr-track" data-gr-track tabindex="0" aria-label="Product images, {{ gr_n }} slides">{{ gr_slides }}</div>
    </div>
    <div class="gr-thumbs" data-gr-thumbs>{{ gr_thumbs }}</div>
    <div class="gr-ctrl">
      <button type="button" class="gr-arrow" data-gr-prev aria-label="Previous image"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m14.5 5-7 7 7 7"/></svg></button>
      <div class="gr-dots" data-gr-dots aria-hidden="true">{%- for i in (1..gr_n) -%}<i></i>{%- endfor -%}</div>
      <button type="button" class="gr-arrow" data-gr-next aria-label="Next image"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9.5 5 7 7-7 7"/></svg></button>
    </div>
  </div>

  <div class="gr-buy">
    <p class="gr-eye">SEVENCRUSH · BLACK FRIDAY</p>
    <h1 class="gr-h1">PlayStation <em>Portal</em></h1>
    <p class="gr-sub">The remote player for your PS5: an 8" screen between two DualSense halves. White, Midnight Black or the 30th Anniversary, all 30% off for Black Friday.</p>
    <div class="gr-price">
      <b data-gr-price>{{ cur.price | money }}</b>
      <s class="bf-was" data-gr-was {% unless cur.compare_at_price > cur.price %}hidden{% endunless %}>{{ cur.compare_at_price | money }}</s>
      <span class="gr-tag bf-off">-30%</span>
      <span class="gr-ship">Free US shipping</span>
    </div>
    <p class="bf-save" data-gr-save {% unless cur.compare_at_price > cur.price %}hidden{% endunless %}>You save <b>{{ cur.compare_at_price | minus: cur.price | money }}</b> on the original price</p>

    {%- form 'product', p, id: 'gr-form', class: 'gr-form' -%}
      <input type="hidden" name="id" value="{{ cur.id }}" data-gr-id>
      <div class="gr-pay">{{ form | payment_terms }}</div>

      <div class="gr-step">
        <p class="gr-step__h"><span>1</span>Your remote player <em>· included</em></p>
        <div class="gr-fixed">
          {% if p.featured_image %}{{ p.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: 'PlayStation Portal remote player' }}{% endif %}
          <div><b>PlayStation Portal Remote Player</b><span>8" 1080p screen · DualSense controls</span></div>
          <i aria-hidden="true">✓</i>
        </div>
      </div>

      {%- for opt in p.options_with_values -%}
        <fieldset class="gr-step gr-opt" data-gr-opt>
          <legend class="gr-step__h"><span>{{ forloop.index | plus: 1 }}</span>Choose your finish</legend>
          <div class="gr-tiles bf-tiles">
            {%- for val in opt.values -%}
              {%- liquid
                assign vd = val | downcase
                assign t_v = nil
                for v in p.variants
                  if v.options contains val
                    assign t_v = v
                    break
                  endif
                endfor
                assign t_name = val
                assign t_sub = 'The original'
                if vd contains '30'
                  assign t_name = '30th Anniversary'
                  assign t_sub = 'Limited edition, PS1 gray'
                elsif vd contains 'black'
                  assign t_name = 'Midnight Black'
                  assign t_sub = 'All black'
                else
                  assign t_name = 'White'
                endif
                assign t_img = t_v.featured_image | default: p.featured_image
              -%}
              <button type="button" class="gr-tile" data-val="{{ val | escape }}" data-name="{{ t_name | escape }}" aria-pressed="{% if val == opt.selected_value %}true{% else %}false{% endif %}">
                <span class="gr-tile__img">{% if t_img %}{{ t_img | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}{% endif %}</span>
                <b>{{ t_name }}</b>
                <small>{{ t_sub }}</small>
                {%- if t_v -%}<small class="bf-tp"><b>{{ t_v.price | money }}</b>{% if t_v.compare_at_price > t_v.price %} <s>{{ t_v.compare_at_price | money }}</s>{% endif %}</small>{%- endif -%}
                <i class="gr-tile__ok" aria-hidden="true">✓</i>
              </button>
            {%- endfor -%}
          </div>
        </fieldset>
      {%- endfor -%}

      <div class="gr-sum" aria-live="polite">
        <p class="gr-sum__h">Your Portal</p>
        <ul>
          <li><i class="gr-ck" aria-hidden="true"></i><span>PlayStation Portal · <span data-gr-sum="0">{{ p.options_with_values[0].selected_value }}</span></span></li>
          <li><i class="gr-ck" aria-hidden="true"></i>Plays your PS5 games over Wi-Fi</li>
          <li class="bf-sum-off"><i class="gr-ck" aria-hidden="true"></i>Black Friday: 30% off the original price</li>
        </ul>
      </div>

      <button type="submit" class="gr-cta" data-gr-atc {% unless cur.available %}disabled{% endunless %}>Add to bag · <span data-gr-price2>{{ cur.price | money }}</span></button>
      <button type="submit" name="return_to" value="/checkout" class="gr-cta gr-cta--2" data-gr-buy {% unless cur.available %}disabled{% endunless %}>Buy it now</button>
      <p class="gr-eta" data-gr-eta>Order today, arrives in 5–12 days</p>
    {%- endform -%}

    <ul class="gr-trust">
      <li><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg></i><span><b>Free shipping</b>US, tracked</span></li>
      <li><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 14 4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-3"/></svg></i><span><b>30-day returns</b>Unopened items</span></li>
      <li><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg></i><span><b>Secure checkout</b>Card, PayPal, Shop Pay</span></li>
    </ul>
    <a class="gr-5" href="#bf-compare">See every Black Friday price →</a>
  </div>
</div>

<div class="gr-wrap gr-sec" id="ritual">
  <p class="gr-eye">HOW IT WORKS</p>
  <h2 class="gr-h2">Your PS5, <em>in your hands.</em></h2>
  <div class="gr-rit">
    {%- assign rit_img = img_box | default: p.media[1].preview_image | default: p.featured_image -%}
    {%- if rit_img -%}
    <figure class="gr-rit__ph">
      {{ rit_img | image_url: width: 1400 | image_tag: widths: '500,800,1100,1400', sizes: '(min-width: 900px) 45vw, 100vw', loading: 'lazy', alt: 'PlayStation Portal remote player' }}
      <figcaption><b>Off the TV</b><span>Your PS5 games, on the couch or in bed.</span></figcaption>
    </figure>
    {%- endif -%}
    <ol class="gr-steps">
      <li><span class="gr-steps__n">01</span><b>Connect</b><span>Put your PS5 and the Portal on Wi-Fi.</span></li>
      <li><span class="gr-steps__n">02</span><b>Sign in</b><span>Use the same PlayStation account on both.</span></li>
      <li><span class="gr-steps__n">03</span><b>Turn on Remote Play</b><span>In the PS5 settings, and leave the PS5 on or in rest mode.</span></li>
      <li><span class="gr-steps__n">04</span><b>Play</b><span>Your installed PS5 games on the 8" screen, with haptic feedback and adaptive triggers.</span></li>
      <li class="is-hl"><span class="gr-steps__n">05</span><b>Or stream from the cloud</b><span>PlayStation Plus Premium members can stream selected PS5 games without the console.</span></li>
    </ol>
  </div>
  <p class="gr-quote">Black Friday only. 30% off, while stock lasts.</p>
</div>

<div class="gr-wrap gr-sec">
  <p class="gr-eye">THE FINISHES</p>
  <h2 class="gr-h2">Pick yours. <em>All 30% off.</em></h2>
  <div class="gr-ed bf-ed" data-gr-ed>
    {%- for v in p.variants -%}
      {%- liquid
        assign vd = v.title | downcase
        assign e_k = 'Finish · 0' | append: forloop.index
        assign e_mod = 'white'
        assign e_h = 'White,<br><em>the original.</em>'
        assign e_cta = 'Get it in white'
        if vd contains '30'
          assign e_mod = 'anniv'
          assign e_h = '30th Anniversary,<br><em>PS1 gray.</em>'
          assign e_cta = 'Get the 30th Anniversary'
        elsif vd contains 'black'
          assign e_mod = 'black'
          assign e_h = 'Midnight Black,<br><em>all black.</em>'
          assign e_cta = 'Get it in black'
        endif
        assign e_img = v.featured_image | default: p.featured_image
      -%}
      <a class="gr-ed__b bf-ed__b bf-ed__b--{{ e_mod }}{% if forloop.first %} bf-ed__b--wide{% endif %}" href="#gr-form" data-bf-pick="{{ v.option1 | escape }}">
        {%- if e_img -%}{{ e_img | image_url: width: 1600 | image_tag: class: 'gr-ed__ph', widths: '600,900,1200,1600', sizes: '(min-width: 900px) 50vw, 100vw', alt: v.title, loading: 'lazy' }}{%- endif -%}
        <div class="gr-ed__c">
          <p class="gr-ed__k">{{ e_k }}</p>
          <h3 class="gr-ed__h">{{ e_h }}</h3>
          <p class="gr-ed__o"><b>{{ v.price | money_without_trailing_zeros }}</b><span><small>{% if v.compare_at_price > v.price %}Was {{ v.compare_at_price | money }}{% else %}Black Friday{% endif %}</small><i>30% off, free shipping</i></span></p>
          <span class="gr-ed__cta">{{ e_cta }}</span>
        </div>
      </a>
    {%- endfor -%}
  </div>
  <details class="gr-specs">
    <summary>Specs at a glance</summary>
    <dl>
      <div><dt>Screen</dt><dd>8" LCD, 1080p, up to 60 fps</dd></div>
      <div><dt>Controls</dt><dd>DualSense: haptic feedback, adaptive triggers</dd></div>
      <div><dt>Plays</dt><dd>PS5 games via Remote Play over Wi-Fi</dd></div>
      <div><dt>Internet (Sony)</dt><dd>5 Mbps minimum, 15 Mbps recommended</dd></div>
      <div><dt>Audio</dt><dd>3.5 mm jack, PlayStation Link</dd></div>
      <div><dt>Finishes</dt><dd>White · Midnight Black · 30th Anniversary</dd></div>
    </dl>
  </details>
</div>

<div class="gr-wrap gr-sec" id="bf-compare">
  <p class="gr-eye">ORIGINAL PRICE VS. BLACK FRIDAY</p>
  <h2 class="gr-h2">The same Portal, <em>30% less.</em></h2>
  <div class="gr-table" role="table" aria-label="Original price versus Black Friday price for each finish">
    <div class="gr-tr gr-th" role="row"><span role="columnheader">Finish</span><span role="columnheader">Original price</span><span role="columnheader" class="is-us">Black Friday</span></div>
    {%- for v in p.variants -%}
      <div class="gr-tr" role="row"><span role="rowheader">{{ v.title }}</span><span>{% if v.compare_at_price > v.price %}<s>{{ v.compare_at_price | money }}</s>{% else %}—{% endif %}</span><span class="is-us">{{ v.price | money }}</span></div>
    {%- endfor -%}
  </div>
  <p class="gr-fine">Original prices are Sony's US list prices (MSRP). Black Friday prices are 30% off those, while stock lasts.</p>
</div>

<div class="gr-wrap gr-sec">
  <p class="gr-eye">BEFORE YOU BUY</p>
  <h2 class="gr-h2">Is it right for you?</h2>
  <div class="gr-safe">
    <div><b>Good to know</b><p>US model, brand new and sealed. The Portal plays the games installed on your PS5 over Wi-Fi; it doesn't run games on its own. Cloud streaming needs PlayStation Plus Premium.</p></div>
    <div><b>Check before you order</b><p>You need a PS5 and a broadband connection (Sony asks for 5 Mbps, 15 Mbps recommended). No Bluetooth audio: use the 3.5 mm jack or PlayStation Link earbuds. PS VR2 games aren't supported.</p></div>
  </div>
</div>

<div class="gr-wrap gr-sec">
  <p class="gr-eye">QUESTIONS</p>
  <h2 class="gr-h2">Asked before you.</h2>
  <details class="gr-faq"><summary>What exactly do I get?</summary><p>The PlayStation Portal remote player in the finish you choose: White, Midnight Black or the limited 30th Anniversary edition.</p></details>
  <details class="gr-faq"><summary>Is the 30% off the original price?</summary><p>Yes. Each finish is 30% off Sony's US list price: White and Midnight Black from $199.99, the 30th Anniversary from $219.99. You see both prices before you pay.</p></details>
  <details class="gr-faq"><summary>Is it new?</summary><p>Yes. Brand new, factory sealed, US model.</p></details>
  <details class="gr-faq"><summary>Do I need a PS5?</summary><p>Yes, for Remote Play: the Portal streams the games installed on your PS5. Without the console you can only stream selected PS5 games from the cloud with PlayStation Plus Premium.</p></details>
  <details class="gr-faq"><summary>Can I play away from home?</summary><p>Yes, on any Wi-Fi with a fast, stable connection. It works best on your home network.</p></details>
  <details class="gr-faq"><summary>How long does shipping take?</summary><p>Delivery takes 5–12 days in the US, free and tracked. You get the tracking number by email.</p></details>
  <details class="gr-faq"><summary>Can I return it?</summary><p>Yes. You have 30 days from delivery to return unopened items. Email sevencrush.store@gmail.com with your order number.</p></details>
  <details class="gr-faq"><summary>Full product description</summary><div>{{ p.description }}</div></details>
  <p class="gr-fine">PlayStation, PS5, PlayStation Portal and DualSense are trademarks of Sony Interactive Entertainment. SEVENCRUSH is an independent retailer, not affiliated with Sony.</p>
</div>

<div class="gr-sticky" data-gr-sticky>
  <span class="gr-sticky__img">{{ p.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}</span>
  <span class="gr-sticky__t"><b>PlayStation Portal · -30%</b><small data-gr-sticky-v>{{ cur.title }}</small></span>
  <button type="button" class="gr-cta" data-gr-sticky-btn {% unless cur.available %}disabled{% endunless %}>Add · <span data-gr-price3>{{ cur.price | money }}</span></button>
</div>
</section>

<style>
.gr{--pk:#e8508a;--pk2:#fde7ef;--ink:#1a1214;--mut:#6f6266;--line:#f1e6ea;background:#fff;color:var(--ink);font-family:system-ui,-apple-system,"Segoe UI",sans-serif;padding-bottom:100px}
.gr *{box-sizing:border-box}
.gr-wrap{max-width:1200px;margin:0 auto;padding:0 16px}
.gr-top{display:grid;gap:20px;padding-top:12px}
@media(min-width:900px){.gr-top{grid-template-columns:1.12fr 1fr;gap:48px;align-items:start;padding-top:32px}.gr-gal{position:sticky;top:20px}}
.gr-gal{min-width:0}
.gr-stage{position:relative}
/* Carousel: full-bleed slide, square thumbnails with a frame on the active one, round arrows and dots underneath */
.gr .gr-track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;background:#f4efea;border:0;border-radius:0;box-shadow:none;overscroll-behavior-x:contain}
.gr-track::-webkit-scrollbar{display:none}
.gr-slide{flex:0 0 100%;margin:0;scroll-snap-align:center;scroll-snap-stop:always;aspect-ratio:1/1;overflow:hidden;background:#fff}
.gr-slide>img{width:100%;height:100%;object-fit:contain;display:block}
.gr-slide--box{position:relative;background:#8e8b88}
.gr-slide--box .gr-box__bg{position:absolute;inset:-8%;width:116%;height:116%;object-fit:cover;filter:blur(26px) brightness(.96)}
.gr-slide--box .gr-box__ph{position:relative;width:100%;height:100%;object-fit:contain;display:block}
.gr-slide--ed{display:flex;flex-direction:column;background:#f4efea}
.gr-slide__cap{flex:none;display:flex;flex-direction:column;gap:4px;padding:5.5% 6% 4%}
.gr-slide__cap b{font:600 clamp(18px,5vw,26px)/1.1 var(--gl-font,system-ui);letter-spacing:-.025em;color:var(--ink)}
.gr-slide__cap span{font:400 clamp(13px,3.4vw,16px)/1.35 var(--gl-font,system-ui);color:#5e5154}
.gr-slide .gr-slide__ph{flex:1;min-height:0;width:100%;object-fit:cover;display:block}
.gr .gr-thumbs{position:relative;display:flex;gap:10px;overflow-x:auto;padding:14px 16px 4px;scroll-padding:0 16px;scrollbar-width:none}
.gr-thumbs::-webkit-scrollbar{display:none}
.gr .gr-thumbs button{position:relative;flex:0 0 84px;height:84px;border-radius:0;border:2px solid transparent;background:#f4efea;padding:0;overflow:hidden;cursor:pointer;opacity:.45;transform:none;transition:opacity .3s,border-color .3s}
.gr .gr-thumbs button img{width:100%;height:100%;object-fit:cover;display:block}
.gr .gr-thumbs button:hover{opacity:.8}
.gr .gr-thumbs button.is-on{opacity:1;border-color:var(--ink);transform:none}
.gr-thumbs .gr-th--ed small{position:absolute;left:0;right:0;top:0;padding:4px 5px 6px;background:linear-gradient(#f4efea 70%,#f4efea00);font:600 7.5px/1.15 var(--gl-font,system-ui);color:var(--ink);text-align:left}
.gr-thumbs .gr-th--ed img{padding-top:16px}
.gr-ctrl{display:flex;align-items:center;justify-content:center;gap:clamp(14px,4vw,26px);padding:18px 0 4px}
.gr .gr-ctrl .gr-arrow{position:static;flex:none;width:52px;height:52px;border-radius:50%;border:1px solid #e4dcd8;background:#fff;color:var(--ink);display:grid;place-items:center;cursor:pointer;box-shadow:none;transform:none;transition:border-color .2s,transform .4s cubic-bezier(.16,1,.3,1),background .2s}
.gr .gr-ctrl .gr-arrow svg{width:22px;height:22px}
.gr .gr-ctrl .gr-arrow:hover{border-color:var(--ink);transform:none}
.gr .gr-ctrl .gr-arrow:active{transform:scale(.93)}
.gr .gr-ctrl .gr-arrow[disabled]{opacity:.35;cursor:default}
.gr-dots{display:flex;align-items:center;gap:7px;flex-wrap:wrap;justify-content:center;max-width:62%}
.gr-dots i{width:8px;height:8px;border-radius:50%;background:#e9e1db;transition:background .3s,transform .4s cubic-bezier(.16,1,.3,1)}
.gr-dots i.is-on{background:#3a1a22;transform:scale(1.15)}
@media(max-width:899px){.gr-gal{margin:0 -16px}}
@media(min-width:900px){.gr .gr-track{border-radius:4px}.gr .gr-thumbs{padding:14px 0 4px}.gr .gr-thumbs button{flex-basis:92px;height:92px}}
.gr-eye{margin:0 0 8px;font-size:11px;font-weight:800;letter-spacing:.18em;color:var(--pk)}
.gr-h1{margin:0;font-size:clamp(30px,6vw,44px);line-height:1;font-weight:800;letter-spacing:-.025em}
.gr-sub{margin:10px 0 0;color:var(--mut);font-size:15px;line-height:1.5}
.gr-price{display:flex;align-items:center;flex-wrap:wrap;gap:8px 10px;margin:16px 0 4px}
.gr-price b{font-size:32px;font-weight:800}
.gr-tag{background:var(--pk2);color:var(--pk);font-size:12px;font-weight:800;padding:6px 12px;border-radius:99px}
.gr-ship{background:#eaf7ef;color:#23784a;font-size:12px;font-weight:800;padding:6px 12px;border-radius:99px}
.gr-pay{font-size:13px;color:var(--mut);min-height:4px}
.gr-step{border:0;margin:18px 0 0;padding:0;min-width:0}
.gr-step__h{display:flex;align-items:center;gap:10px;margin:0 0 10px;padding:0;font:800 15px/1.2 system-ui}
.gr-step__h span{flex:none;width:26px;height:26px;border-radius:50%;background:var(--ink);color:#fff;display:grid;place-items:center;font-size:13px}
