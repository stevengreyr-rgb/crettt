{%- liquid
  assign p = product | default: all_products['sevencrush-glow-ritual-set-led-mask-eye-wand-collagen-duo']
  assign cur = p.selected_or_first_available_variant
  assign img_mask = images['sk-cut-lezo.png']
  assign img_wand_pink = images['sc-booster-pink-hd.png']
  assign img_wand_black = images['sc-booster-black-hd.png']
  assign img_col_pink = images['sk-cut-collagen-duo.png']
  assign img_col_blue = images['sk-cut-ceranol-duo.png']
  assign img_ritual = images['IMG_1723.png']
-%}
<script>try{if(!matchMedia('(prefers-reduced-motion: reduce)').matches)document.documentElement.classList.add('gm-js')}catch(e){}</script>
<script src="{{ 'glow-motion.js' | asset_url }}" defer></script>
<section class="gr" data-gr>
<script type="application/json" data-gr-json>{{ p.variants | json }}</script>
<div class="gr-wrap gr-top">

  <div class="gr-gal">
    {%- comment -%} The LEZO light infographic stays out: it repeats the Booster Pro skin one. {%- endcomment -%}
    {%- liquid
      assign gr_n = 0
      assign gr_slides = ''
      assign gr_thumbs = ''
    -%}
    {%- for m in p.media -%}
      {%- assign m_src = m.preview_image.src | append: '' -%}
      {%- if m_src contains 'lezo-light-layers' -%}{%- continue -%}{%- endif -%}
      {%- assign gr_n = gr_n | plus: 1 -%}
      {%- capture one -%}
        <figure class="gr-slide" data-media-id="{{ m.id }}">
          {%- if gr_n == 1 -%}
            {{ m.preview_image | image_url: width: 1400 | image_tag: widths: '500,800,1100,1400', sizes: '(min-width: 900px) 55vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: m.alt | default: p.title }}
          {%- else -%}
            {{ m.preview_image | image_url: width: 1400 | image_tag: widths: '500,800,1100,1400', sizes: '(min-width: 900px) 55vw, 100vw', loading: 'lazy', alt: m.alt | default: p.title }}
          {%- endif -%}
        </figure>
      {%- endcapture -%}
      {%- capture th -%}<button type="button" aria-label="Image {{ gr_n }}">{{ m.preview_image | image_url: width: 220 | image_tag: loading: 'lazy', alt: '' }}</button>{%- endcapture -%}
      {%- assign gr_slides = gr_slides | append: one -%}
      {%- assign gr_thumbs = gr_thumbs | append: th -%}
    {%- endfor -%}
    <div class="gr-stage">
      <div class="gr-track" data-gr-track tabindex="0" aria-label="Product images, {{ gr_n }} slides">{{ gr_slides }}</div>
    </div>
    <div class="gr-thumbs" data-gr-thumbs>{{ gr_thumbs }}</div>
    <div class="gr-ctrl">
      <button type="button" class="gr-arrow" data-gr-prev aria-label="Previous image"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m14.5 5-7 7 7 7"/></svg></button>
      <div class="gr-dots" data-gr-dots aria-hidden="true">{%- for i in (1..gr_n) -%}<i></i>{%- endfor -%}</div>
      <button type="button" class="gr-arrow" data-gr-next aria-label="Next image"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9.5 5 7 7-7 7"/></svg></button>
    </div>
  </div>

  <div class="gr-buy">
    <p class="gr-eye">SEVENCRUSH · THE GLOW RITUAL</p>
    <h1 class="gr-h1">The Glow <em>Ritual</em> Set</h1>
    <p class="gr-sub">LED face mask + eye wand + collagen duo. Everything for your night ritual, in one box.</p>
    <div class="gr-price"><b data-gr-price>{{ cur.price | money }}</b><span class="gr-tag">3-in-1</span><span class="gr-ship">Free US shipping</span></div>

    {%- form 'product', p, id: 'gr-form', class: 'gr-form' -%}
      <input type="hidden" name="id" value="{{ cur.id }}" data-gr-id>
      <div class="gr-pay">{{ form | payment_terms }}</div>

      <div class="gr-step">
        <p class="gr-step__h"><span>1</span>Your LED mask <em>· included</em></p>
        <div class="gr-fixed">
          {% if img_mask %}{{ img_mask | image_url: width: 200 | image_tag: loading: 'lazy', alt: 'LEZO LED face mask' }}{% endif %}
          <div><b>LEZO LED Mask · White</b><span>7 light colors · hands-free strap</span></div>
          <i aria-hidden="true">✓</i>
        </div>
      </div>

      {%- for opt in p.options_with_values -%}
        {%- assign oi = forloop.index0 -%}
        <fieldset class="gr-step gr-opt" data-gr-opt>
          <legend class="gr-step__h"><span>{{ forloop.index | plus: 1 }}</span>{% if oi == 0 %}Choose your eye wand color{% else %}Choose your collagen duo{% endif %}</legend>
          <div class="gr-tiles">
            {%- for val in opt.values -%}
              {%- liquid
                assign vd = val | downcase
                assign t_img = nil
                assign t_sub = ''
                assign t_name = val
                if oi == 0
                  assign t_name = 'Booster Pro · ' | append: val
                  if vd contains 'pink'
                    assign t_img = img_wand_pink
                    assign t_sub = 'Pink · 7 light colors'
                  else
                    assign t_img = img_wand_black
                    assign t_sub = 'Black · 7 light colors'
                  endif
                else
                  if vd contains 'pink'
                    assign t_img = img_col_pink
                    assign t_name = 'Pink · Collagen'
                    assign t_sub = 'Pads + ampoule'
                  else
                    assign t_img = img_col_blue
                    assign t_name = 'Blue · Ceramide'
                    assign t_sub = 'For dry-feeling skin'
                  endif
                endif
              -%}
              <button type="button" class="gr-tile" data-val="{{ val | escape }}" data-name="{{ t_name | escape }}" aria-pressed="{% if val == opt.selected_value %}true{% else %}false{% endif %}">
                <span class="gr-tile__img">{% if t_img %}{{ t_img | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}{% endif %}</span>
                <b>{{ t_name }}</b>
                <small>{{ t_sub }}</small>
                <i class="gr-tile__ok" aria-hidden="true">✓</i>
              </button>
            {%- endfor -%}
          </div>
        </fieldset>
      {%- endfor -%}

      <div class="gr-sum" aria-live="polite">
        <p class="gr-sum__h">Your set</p>
        <ul>
          <li><i class="gr-ck" aria-hidden="true"></i>LEZO LED Mask · White</li>
          <li><i class="gr-ck" aria-hidden="true"></i><span data-gr-sum="0">Booster Pro · {{ p.options_with_values[0].selected_value }}</span></li>
          <li><i class="gr-ck" aria-hidden="true"></i><span><span data-gr-sum="1">{% if p.options_with_values[1].selected_value contains 'Pink' %}Pink · Collagen{% else %}Blue · Ceramide{% endif %}</span> pads + ampoule</span></li>
        </ul>
      </div>

      <button type="submit" class="gr-cta" data-gr-atc {% unless cur.available %}disabled{% endunless %}>Add my set to bag · <span data-gr-price2>{{ cur.price | money }}</span></button>
      <button type="submit" name="return_to" value="/checkout" class="gr-cta gr-cta--2" data-gr-buy {% unless cur.available %}disabled{% endunless %}>Buy it now</button>
      <p class="gr-eta" data-gr-eta>Order today, arrives in 5–12 days</p>
    {%- endform -%}

    <ul class="gr-trust">
      <li><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg></i><span><b>Free shipping</b>US, tracked</span></li>
      <li><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 14 4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-3"/></svg></i><span><b>30-day returns</b>Unopened items</span></li>
      <li><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg></i><span><b>Secure checkout</b>Card, PayPal, Shop Pay</span></li>
    </ul>
    <a class="gr-5" href="#hb-news">Get 5% off your first order →</a>
  </div>
</div>

<div class="gr-wrap gr-sec" id="ritual">
  <p class="gr-eye">HOW THE RITUAL WORKS</p>
  <h2 class="gr-h2">Five steps. <em>Twenty minutes.</em></h2>
  <div class="gr-rit">
    {%- if img_ritual -%}
    <figure class="gr-rit__ph">
      {{ img_ritual | image_url: width: 1400 | image_tag: widths: '500,800,1100,1400', sizes: '(min-width: 900px) 45vw, 100vw', loading: 'lazy', alt: 'Woman pressing in the pink collagen ampoule with a dropper, eyes closed' }}
      <figcaption><b>05 · Seal it</b><span>Press in the ampoule. Done.</span></figcaption>
    </figure>
    {%- endif -%}
    <ol class="gr-steps">
      <li><span class="gr-steps__n">01</span><b>Cleanse</b><span>Clean, dry skin. Makeup off.</span></li>
      <li><span class="gr-steps__n">02</span><b>Refresh</b><span>Lay a collagen gel pad on each area while you get ready.</span></li>
      <li><span class="gr-steps__n">03</span><b>Light up</b><span>Strap on the LEZO mask, choose one of 7 colors and rest for the session time in the manual.</span></li>
      <li><span class="gr-steps__n">04</span><b>Eye moment</b><span>Pick the same color on the Booster Pro and glide it slowly around the eyes, following its manual.</span></li>
      <li class="is-hl"><span class="gr-steps__n">05</span><b>Seal it</b><span>Warm a few drops of ampoule and press them in. Done.</span></li>
    </ol>
  </div>
  <p class="gr-quote">Raise your frequency. Restore your ritual.</p>
</div>

<div class="gr-wrap gr-sec">
  <p class="gr-eye">WHAT'S INSIDE</p>
  <h2 class="gr-h2">Everything. <em>One box.</em></h2>
  <div class="gr-ed" data-gr-ed>
    <a class="gr-ed__b gr-ed__b--lezo" href="#gr-form">
      {{ images['sc-ed2-lezo.png'] | image_url: width: 2048 | image_tag: class: 'gr-ed__ph', widths: '600,900,1200,1600,2048', sizes: '100vw', alt: 'Model holding the LEZO LED mask, lit red, beside her face', loading: 'lazy' }}
      <div class="gr-ed__c">
        <p class="gr-ed__k">In the set · 01</p>
        <h3 class="gr-ed__h">Red light,<br><em>hands free.</em></h3>
        <p class="gr-ed__o"><b>7</b><span><small>LEZO LED mask</small><i>light colors, one strap</i></span></p>
        <span class="gr-ed__cta">Build my set</span>
      </div>
    </a>
    <a class="gr-ed__b gr-ed__b--daily" href="#gr-form">
      {{ images['sc-refined-daily-oct29.png'] | image_url: width: 1600 | image_tag: class: 'gr-ed__ph', widths: '600,900,1200,1600', sizes: '(min-width: 900px) 50vw, 100vw', alt: 'LEZO mask and Booster Pro wand on a blush set, model touching her cheeks', loading: 'lazy' }}
      <div class="gr-ed__c">
        <p class="gr-ed__k">In the set · 02</p>
        <h3 class="gr-ed__h">Mask + wand,<br><em>the same 7 lights.</em></h3>
        <p class="gr-ed__o"><b>{{ cur.price | money_without_trailing_zeros }}</b><span><small>Mask + wand + duo</small><i>one price, free shipping</i></span></p>
        <span class="gr-ed__cta">Pick my wand color</span>
      </div>
    </a>
    <a class="gr-ed__b gr-ed__b--gel" href="#gr-form">
      {{ images['sc-refined-gel-oct29.png'] | image_url: width: 1600 | image_tag: class: 'gr-ed__ph', widths: '600,900,1200,1600', sizes: '(min-width: 900px) 50vw, 100vw', alt: 'Model with a pink gel pad beside collagen pads and ampoule', loading: 'lazy' }}
      <div class="gr-ed__c">
        <p class="gr-ed__k">In the set · 03</p>
        <h3 class="gr-ed__h">The collagen duo<br><em>is in the box.</em></h3>
        <p class="gr-ed__o"><b>2-step</b><span><small>Pads + ampoule</small><i>Pink or Blue</i></span></p>
        <span class="gr-ed__cta">Pick my duo</span>
      </div>
    </a>
  </div>
  <details class="gr-specs">
    <summary>Specs at a glance</summary>
    <dl>
      <div><dt>Light colors (mask & wand)</dt><dd>7: red, blue, green, yellow, purple, cyan, white</dd></div>
      <div><dt>Wavelengths (maker)</dt><dd>470, 520, 590, 630 nm</dd></div>
      <div><dt>Mask fit</dt><dd>Adjustable strap, open at eyes and mouth</dd></div>
      <div><dt>Wand power</dt><dd>USB rechargeable</dd></div>
      <div><dt>Wand finishes</dt><dd>Pink, Black</dd></div>
      <div><dt>Collagen duo</dt><dd>Gel toner pads + matching ampoule</dd></div>
    </dl>
  </details>
</div>

<div class="gr-wrap gr-sec">
  <p class="gr-eye">CLINIC VS. AT HOME</p>
  <h2 class="gr-h2">The ritual, <em>without the appointment.</em></h2>
  <div class="gr-table" role="table" aria-label="In-office LED versus the Glow Ritual Set">
    <div class="gr-tr gr-th" role="row"><span role="columnheader"></span><span role="columnheader">In-office LED</span><span role="columnheader" class="is-us">Glow Ritual Set</span></div>
    <div class="gr-tr" role="row"><span role="rowheader">Price</span><span>$25–$85 per session</span><span class="is-us">{{ cur.price | money }} once</span></div>
    <div class="gr-tr" role="row"><span role="rowheader">A 10-session course</span><span>≈ $250–$850</span><span class="is-us">Included</span></div>
    <div class="gr-tr" role="row"><span role="rowheader">When</span><span>Booked appointments</span><span class="is-us">Any night, at home</span></div>
    <div class="gr-tr" role="row"><span role="rowheader">Eye-area tool</span><span>Varies</span><span class="is-us">Booster Pro wand</span></div>
    <div class="gr-tr" role="row"><span role="rowheader">Hydration step</span><span>Varies</span><span class="is-us">Collagen duo</span></div>
  </div>
  <p class="gr-fine">In-office session prices from Healthline, citing RealSelf; they vary by location. At-home devices are not the same as professional treatments.</p>
</div>

<div class="gr-wrap gr-sec">
  <p class="gr-eye">BEFORE YOU START</p>
  <h2 class="gr-h2">Is it right for you?</h2>
  <div class="gr-safe">
    <div><b>Good to know</b><p>LED light is UV-free. Follow each manual for session time and eye protection. Patch-test the collagen products first.</p></div>
    <div><b>Talk to your doctor first if you</b><p>Take medication that makes you sensitive to light (such as isotretinoin), have an active rash or skin condition, are pregnant, or have a condition triggered by light.</p></div>
  </div>
</div>

<div class="gr-wrap gr-sec">
  <p class="gr-eye">QUESTIONS</p>
  <h2 class="gr-h2">Asked before you.</h2>
  <details class="gr-faq"><summary>What exactly do I get?</summary><p>One box with the LEZO LED face mask (white), the Booster Pro eye wand in the color you choose, and the collagen pads with their matching ampoule in the color you choose.</p></details>
  <details class="gr-faq"><summary>Do the mask and the wand have the same lights?</summary><p>Yes. Both have the same 7 light colors: red, blue, green, yellow, purple, cyan and white. Use the same color on the face and around the eyes in one session.</p></details>
  <details class="gr-faq"><summary>What's the difference between Pink and Blue collagen?</summary><p>Pink is the collagen pads and collagen ampoule. Blue is the ceramide pads and ampoule, a good pick for skin that feels tight or dry.</p></details>
  <details class="gr-faq"><summary>How often should I use it?</summary><p>Follow the manual of each product for session time and frequency. Consistency matters more than long sessions: pick a fixed slot, like after cleansing and before bed.</p></details>
  <details class="gr-faq"><summary>How long does shipping take?</summary><p>Delivery takes 5–12 days in the US, free and tracked. You get the tracking number by email.</p></details>
  <details class="gr-faq"><summary>Can I return it?</summary><p>Yes. You have 30 days from delivery to return unopened, unused items. Email sevencrush.store@gmail.com with your order number.</p></details>
  <details class="gr-faq"><summary>Full product description</summary><div>{{ p.description }}</div></details>
  <p class="gr-fine">For cosmetic use. Not intended to diagnose, treat, cure or prevent any disease. Individual results vary.</p>
</div>

<div class="gr-sticky" data-gr-sticky>
  <span class="gr-sticky__img">{{ p.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}</span>
  <span class="gr-sticky__t"><b>The Glow Ritual Set</b><small data-gr-sticky-v>{{ cur.title }}</small></span>
  <button type="button" class="gr-cta" data-gr-sticky-btn {% unless cur.available %}disabled{% endunless %}>Add · <span data-gr-price3>{{ cur.price | money }}</span></button>
</div>
</section>

<style>
.gr{--pk:#e8508a;--pk2:#fde7ef;--ink:#1a1214;--mut:#6f6266;--line:#f1e6ea;background:#fff;color:var(--ink);font-family:system-ui,-apple-system,"Segoe UI",sans-serif;padding-bottom:100px}
.gr *{box-sizing:border-box}
.gr-wrap{max-width:1200px;margin:0 auto;padding:0 16px}
.gr-top{display:grid;gap:20px;padding-top:12px}
@media(min-width:900px){.gr-top{grid-template-columns:1.12fr 1fr;gap:48px;align-items:start;padding-top:32px}.gr-gal{position:sticky;top:20px}}
.gr-gal{min-width:0}
.gr-stage{position:relative}
/* Carousel: full-bleed slide, square thumbnails with a frame on the active one, round arrows and dots underneath */
.gr .gr-track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;background:#f4efea;border:0;border-radius:0;box-shadow:none;overscroll-behavior-x:contain}
.gr-track::-webkit-scrollbar{display:none}
.gr-slide{flex:0 0 100%;margin:0;scroll-snap-align:center;scroll-snap-stop:always;aspect-ratio:1/1;overflow:hidden;background:#fff}
.gr-slide>img{width:100%;height:100%;object-fit:contain;display:block}
.gr-slide--ed{display:flex;flex-direction:column;background:#f4efea}
.gr-slide__cap{flex:none;display:flex;flex-direction:column;gap:4px;padding:5.5% 6% 4%}
.gr-slide__cap b{font:600 clamp(18px,5vw,26px)/1.1 var(--gl-font,system-ui);letter-spacing:-.025em;color:var(--ink)}
.gr-slide__cap span{font:400 clamp(13px,3.4vw,16px)/1.35 var(--gl-font,system-ui);color:#5e5154}
.gr-slide .gr-slide__ph{flex:1;min-height:0;width:100%;object-fit:cover;display:block}
.gr .gr-thumbs{position:relative;display:flex;gap:10px;overflow-x:auto;padding:14px 16px 4px;scroll-padding:0 16px;scrollbar-width:none}
.gr-thumbs::-webkit-scrollbar{display:none}
.gr .gr-thumbs button{position:relative;flex:0 0 84px;height:84px;border-radius:0;border:2px solid transparent;background:#f4efea;padding:0;overflow:hidden;cursor:pointer;opacity:.45;transform:none;transition:opacity .3s,border-color .3s}
.gr .gr-thumbs button img{width:100%;height:100%;object-fit:cover;display:block}
.gr .gr-thumbs button:hover{opacity:.8}
.gr .gr-thumbs button.is-on{opacity:1;border-color:var(--ink);transform:none}
.gr-thumbs .gr-th--ed small{position:absolute;left:0;right:0;top:0;padding:4px 5px 6px;background:linear-gradient(#f4efea 70%,#f4efea00);font:600 7.5px/1.15 var(--gl-font,system-ui);color:var(--ink);text-align:left}
.gr-thumbs .gr-th--ed img{padding-top:16px}
.gr-ctrl{display:flex;align-items:center;justify-content:center;gap:clamp(14px,4vw,26px);padding:18px 0 4px}
.gr .gr-ctrl .gr-arrow{position:static;flex:none;width:52px;height:52px;border-radius:50%;border:1px solid #e4dcd8;background:#fff;color:var(--ink);display:grid;place-items:center;cursor:pointer;box-shadow:none;transform:none;transition:border-color .2s,transform .4s cubic-bezier(.16,1,.3,1),background .2s}
.gr .gr-ctrl .gr-arrow svg{width:22px;height:22px}
.gr .gr-ctrl .gr-arrow:hover{border-color:var(--ink);transform:none}
.gr .gr-ctrl .gr-arrow:active{transform:scale(.93)}
.gr .gr-ctrl .gr-arrow[disabled]{opacity:.35;cursor:default}
.gr-dots{display:flex;align-items:center;gap:7px;flex-wrap:wrap;justify-content:center;max-width:62%}
.gr-dots i{width:8px;height:8px;border-radius:50%;background:#e9e1db;transition:background .3s,transform .4s cubic-bezier(.16,1,.3,1)}
.gr-dots i.is-on{background:#3a1a22;transform:scale(1.15)}
@media(max-width:899px){.gr-gal{margin:0 -16px}}
@media(min-width:900px){.gr .gr-track{border-radius:4px}.gr .gr-thumbs{padding:14px 0 4px}.gr .gr-thumbs button{flex-basis:92px;height:92px}}
.gr-eye{margin:0 0 8px;font-size:11px;font-weight:800;letter-spacing:.18em;color:var(--pk)}
.gr-h1{margin:0;font-size:clamp(30px,6vw,44px);line-height:1;font-weight:800;letter-spacing:-.025em}
.gr-sub{margin:10px 0 0;color:var(--mut);font-size:15px;line-height:1.5}
.gr-price{display:flex;align-items:center;flex-wrap:wrap;gap:8px 10px;margin:16px 0 4px}
.gr-price b{font-size:32px;font-weight:800}
.gr-tag{background:var(--pk2);color:var(--pk);font-size:12px;font-weight:800;padding:6px 12px;border-radius:99px}
.gr-ship{background:#eaf7ef;color:#23784a;font-size:12px;font-weight:800;padding:6px 12px;border-radius:99px}
.gr-pay{font-size:13px;color:var(--mut);min-height:4px}
.gr-step{border:0;margin:18px 0 0;padding:0;min-width:0}
.gr-step__h{display:flex;align-items:center;gap:10px;margin:0 0 10px;padding:0;font:800 15px/1.2 system-ui}
.gr-step__h span{flex:none;width:26px;height:26px;border-radius:50%;background:var(--ink);color:#fff;display:grid;place-items:center;font-size:13px}
.gr-step__h em{font-style:normal;font-weight:600;color:#23784a}
.gr-fixed{display:grid;grid-template-columns:48px 1fr auto;align-items:center;gap:10px;padding:8px 12px 8px 8px;border:2px solid var(--line);border-radius:14px;background:#fbfafa}
.gr-fixed img{width:48px;height:48px;object-fit:contain;border-radius:10px;background:#fff}
.gr-fixed b{display:block;font-size:13px}.gr-fixed span{font-size:12px;color:var(--mut)}
.gr-fixed i{font-style:normal;width:22px;height:22px;border-radius:50%;background:#23784a;color:#fff;display:grid;place-items:center;font-weight:800;font-size:12px}
.gr-tiles{display:grid;grid-template-columns:1fr 1fr;gap:8px}
